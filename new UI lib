                SliderCircle.Position = UDim2.new(fillPercent, 0, 0.5, 0)
                SliderCircle.AnchorPoint = Vector2.new(0.5, 0.5)
                SliderCircle.BackgroundColor3 = COLORS.TEXT
                SliderCircle.ZIndex = 15
                
