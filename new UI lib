    function window:SetTheme(theme)
        if theme == "Dark" then
            COLORS = {
                BACKGROUND = Color3.fromRGB(30, 30, 35),
                SECONDARY = Color3.fromRGB(45, 45, 50),
                ACCENT = Color3.fromRGB(65, 105, 225),
                TEXT = Color3.fromRGB(255, 255, 255),
                TEXT_DIMMED = Color3.fromRGB(175, 175, 175),
                BORDER = Color3.fromRGB(60, 60, 65)
            }
        elseif theme == "Light" then
            COLORS = {
                BACKGROUND = Color3.fromRGB(240, 240, 245),
                SECONDARY = Color3.fromRGB(225, 225, 230),
                ACCENT = Color3.fromRGB(65, 105, 225),
                TEXT = Color3.fromRGB(40, 40, 45),
                TEXT_DIMMED = Color3.fromRGB(120, 120, 125),
                BORDER = Color3.fromRGB(200, 200, 205)
            }
        elseif theme == "Midnight" then
            COLORS = {
                BACKGROUND = Color3.fromRGB(20, 20, 30),
                SECONDARY = Color3.fromRGB(30, 30, 45),
                ACCENT = Color3.fromRGB(100, 80, 200),
                TEXT = Color3.fromRGB(255, 255, 255),
                TEXT_DIMMED = Color3.fromRGB(170, 170, 190),
                BORDER = Color3.fromRGB(50, 50, 70)
            }
        elseif theme == "Ocean" then
            COLORS = {
                BACKGROUND = Color3.fromRGB(20, 40, 55),
                SECONDARY = Color3.fromRGB(30, 55, 75),
                ACCENT = Color3.fromRGB(45, 150, 200),
                TEXT = Color3.fromRGB(255, 255, 255),
                TEXT_DIMMED = Color3.fromRGB(170, 190, 210),
                BORDER = Color3.fromRGB(40, 65, 85)
            }
        elseif theme == "Blush" then
            COLORS = {
                BACKGROUND = Color3.fromRGB(40, 30, 45),
                SECONDARY = Color3.fromRGB(55, 45, 65),
                ACCENT = Color3.fromRGB(200, 80, 140),
                TEXT = Color3.fromRGB(255, 255, 255),
                TEXT_DIMMED = Color3.fromRGB(200, 180, 210),
                BORDER = Color3.fromRGB(70, 60, 80)
            }
        end
        
        -- Update all elements with new colors
        -- This would require keeping track of all created elements
        -- For simplicity, just show a message that a refresh is needed
        local notification = window:CreateNotification("Theme Changed", "The theme has been set to " .. theme .. ". Please re-open the UI for full effect.", 5)
    end
    
