                        local saturation = math.clamp((mousePos.X - canvasPos.X) / canvasSize.X, 0, 1)
                        local value = 1 - math.clamp((mousePos.Y - canvasPos.Y) / canvasSize.Y, 0, 1)
                        
                        HSV.S = saturation
                        HSV.V = value
                        
                        UpdateInterface()
                        UpdateColor()
                    end
                    
                    -- Initial update
