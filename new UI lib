            -- Add more UI elements here like AddToggle, AddSlider, etc.


            
            table.insert(TabObject.Elements, SectionObject)
            return SectionObject
        end
        
        -- Add tab to window object
        WindowObject.Tabs[tabIndex] = TabObject
        
        -- If this is the first tab, select it
        if tabIndex == 1 then
            TabButton.BackgroundColor3 = Settings.Theme.Accent
            TabButton.TextColor3 = Settings.Theme.Text
            TabContent.Visible = true
        end
        
        -- Auto-adjust TabButtonHolder canvas size
        TabButtonLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabButtonHolder.CanvasSize = UDim2.new(0, 0, 0, TabButtonLayout.AbsoluteContentSize.Y + 10)
        end)
        
        return TabObject
    end
    
    -- Apply opening animation
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.BackgroundTransparency = 1
    
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 500, 0, 350),
        Position = UDim2.new(0.5, -250, 0.5, -175),
        BackgroundTransparency = 1 - Settings.Transparency
    }):Play()
    
    return WindowObject
end

