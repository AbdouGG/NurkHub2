                end)
                
                -- Toggle Object with API
                local ToggleObject = {
                    Instance = Toggle,
                    Set = function(self, state)
                        Enabled = state
                        UpdateToggle()
                        return self
                    end,
                    Get = function()
                        return Enabled
                    end
