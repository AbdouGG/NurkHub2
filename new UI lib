            function section:AddMultiButton(text, options, callback)
                local MultiButtonFrame = Instance.new("Frame", SectionContent)
                MultiButtonFrame.Name = "MultiButtonFrame"
                MultiButtonFrame.Size = UDim2.new(0.92, 0, 0, 60)
                MultiButtonFrame.BackgroundColor3 = COLORS.BACKGROUND
                MultiButtonFrame.ZIndex = 14
                
                local UICorner_MultiButton = Instance.new("UICorner", MultiButtonFrame)
                UICorner_MultiButton.CornerRadius = UDim.new(0, 8)
                
                -- Add a subtle stroke
                local MultiButtonFrameStroke = Instance.new("UIStroke", MultiButtonFrame)
                MultiButtonFrameStroke.Color = COLORS.BORDER
                MultiButtonFrameStroke.Thickness = 1
                MultiButtonFrameStroke.Transparency = 0.7
                
                local Title = Instance.new("TextLabel", MultiButtonFrame)
                Title.Name = "Title"
                Title.Size = UDim2.new(1, -20, 0, 25)
                Title.Position = UDim2.new(0, 10, 0, 0)
                Title.BackgroundTransparency = 1
                Title.Text = text
                Title.TextColor3 = COLORS.TEXT
                Title.TextSize = 15
                Title.Font = Enum.Font.GothamSemibold
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.ZIndex = 14
                
                local ButtonsContainer = Instance.new("Frame", MultiButtonFrame)
                ButtonsContainer.Name = "ButtonsContainer"
                ButtonsContainer.Size = UDim2.new(1, -20, 0, 30)
                ButtonsContainer.Position = UDim2.new(0, 10, 0, 25)
                ButtonsContainer.BackgroundColor3 = COLORS.SECONDARY
                ButtonsContainer.ZIndex = 14
                
                local ContainerCorner = Instance.new("UICorner", ButtonsContainer)
                ContainerCorner.CornerRadius = UDim.new(0, 6)
                
                -- Add buttons based on options
                local buttonsWidth = 1 / #options
                local buttons = {}
                
                for i, option in ipairs(options) do
                    local OptionButton = Instance.new("TextButton", ButtonsContainer)
                    OptionButton.Name = "Option_" .. option
                    OptionButton.Size = UDim2.new(buttonsWidth, 0, 1, 0)
                    OptionButton.Position = UDim2.new(buttonsWidth * (i-1), 0, 0, 0)
                    OptionButton.BackgroundColor3 = COLORS.SECONDARY
                    OptionButton.Text = option
                    OptionButton.TextColor3 = COLORS.TEXT_DIMMED
                    OptionButton.TextSize = 14
                    OptionButton.Font = Enum.Font.Gotham
                    OptionButton.ZIndex = 15
                    
                    local OptionButtonCorner = Instance.new("UICorner", OptionButton)
                    OptionButtonCorner.CornerRadius = UDim.new(0, 6)
                    
                    createHoverEffect(OptionButton)
                    
                    table.insert(buttons, OptionButton)
                    
                    OptionButton.MouseButton1Click:Connect(function()
                        -- Deselect all buttons
                        for _, btn in ipairs(buttons) do
                            TweenService:Create(btn, TWEEN_INFO, {
                                BackgroundColor3 = COLORS.SECONDARY,
                                TextColor3 = COLORS.TEXT_DIMMED
                            }):Play()
                        end
                        
                        -- Select this button
                        TweenService:Create(OptionButton, TWEEN_INFO, {
                            BackgroundColor3 = COLORS.ACCENT,
                            TextColor3 = COLORS.TEXT
                        }):Play()
                        
                        callback(option)
                    end)
                end
                
                -- Select first button by default
                TweenService:Create(buttons[1], TWEEN_INFO, {
                    BackgroundColor3 = COLORS.ACCENT,
                    TextColor3 = COLORS.TEXT
                }):Play()
                
                return {
                    Frame = MultiButtonFrame,
                    SetValue = function(_, option)
                        for i, opt in ipairs(options) do
                            if opt == option then
                                for _, btn in ipairs(buttons) do
                                    TweenService:Create(btn, TWEEN_INFO, {
                                        BackgroundColor3 = COLORS.SECONDARY,
                                        TextColor3 = COLORS.TEXT_DIMMED
                                    }):Play()
                                end
                                
                                TweenService:Create(buttons[i], TWEEN_INFO, {
                                    BackgroundColor3 = COLORS.ACCENT,
                                    TextColor3 = COLORS.TEXT
                                }):Play()
                                
                                callback(option)
                                break
                            end
                        end
                    end
                }
            end
            
            return section
        end
        
        return tab
    end
    
