----------------------------------------------------------------
-- Enhanced Utility Functions
----------------------------------------------------------------
local function createHoverEffect(button)
    local originalColor = button.BackgroundColor3

    -- Create a UIStroke with rounded corners
    local stroke = Instance.new("UIStroke")
    stroke.Color = COLORS.ACCENT
    stroke.Thickness = 0
    stroke.Transparency = 0.2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = button

    button.MouseEnter:Connect(function()
        TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = COLORS.HOVER}):Play()
        TweenService:Create(stroke, TWEEN_INFO, {Thickness = 1.5}):Play()
    end)

    button.MouseLeave:Connect(function()
        TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = originalColor}):Play()
        TweenService:Create(stroke, TWEEN_INFO, {Thickness = 0}):Play()
    end)
end

-- Function to create a gradient
local function createGradient(parent, rotation)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, COLORS.GRADIENT_START),
        ColorSequenceKeypoint.new(1, COLORS.GRADIENT_END)
    })
    gradient.Rotation = rotation or 45
    gradient.Parent = parent
    return gradient
end

-- Function to add shadow effect
local function addShadowEffect(parent, transparency)
    local shadow = Instance.new("ImageLabel", parent)
    shadow.Name = "Shadow"
    shadow.BackgroundTransparency = 1
    shadow.Position = UDim2.new(0, -15, 0, -15)
    shadow.Size = UDim2.new(1, 30, 1, 30)
    shadow.Image = "rbxassetid://6014261993" -- Better shadow asset
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = transparency or 0.5
    shadow.ZIndex = parent.ZIndex - 1
    return shadow
end

