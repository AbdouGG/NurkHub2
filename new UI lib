                -- State tracking
                local IsOpen = false
                local SelectedOption = default
                
                -- Create Option Button function
                local function CreateOption(optionText)
                    local Option = Instance.new("TextButton")
                    Option.Name = "Option_" .. optionText
                    Option.BackgroundColor3 = Settings.Theme.Primary
                    Option.BackgroundTransparency = 0.8
                    Option.Size = UDim2.new(1, -10, 0, 30)
