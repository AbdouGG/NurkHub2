        -- Animation
        NotificationFrame:TweenPosition(UDim2.new(1, -20, 0.8, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.5, true)
        
        -- Remove after duration
        delay(duration, function()
            NotificationFrame:TweenPosition(UDim2.new(1, 20, 0.8, 0), Enum.EasingDirection.In, Enum.EasingStyle.Quart, 0.5, true, function()
                NotificationFrame:Destroy()
