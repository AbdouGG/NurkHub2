                local function UpdateToggle()
                    if Enabled then
                        TweenService:Create(ToggleBackground, TweenInfo.new(0.2), {
                            BackgroundColor3 = Settings.Theme.Accent
                        }):Play()
                        
                        TweenService:Create(ToggleKnob, TweenInfo.new(0.2), {
                            Position = UDim2.new(1, -14, 0.5, 0)
                        }):Play()
                    else
                        TweenService:Create(ToggleBackground, TweenInfo.new(0.2), {
                            BackgroundColor3 = Settings.Theme.Secondary
                        }):Play()
                        
                        TweenService:Create(ToggleKnob, TweenInfo.new(0.2), {
                            Position = UDim2.new(0, 2, 0.5, 0)
                        }):Play()
                    end
                    
                    -- Execute callback with current state
                    task.spawn(function()
                        callback(Enabled)
                    end)
                end
                
                -- Set initial state
                UpdateToggle()
                
                -- Toggle interaction
                Toggle.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        Enabled = not Enabled
                        UpdateToggle()
                    end
                end)
                
                -- Hover effects
                Toggle.MouseEnter:Connect(function()
                    TweenService:Create(Toggle, TweenInfo.new(0.2), {
                        BackgroundColor3 = Color3.fromRGB(
                            Settings.Theme.Primary.R * 1.1,
                            Settings.Theme.Primary.G * 1.1,
                            Settings.Theme.Primary.B * 1.1
                        )
                    }):Play()
                end)
                
                Toggle.MouseLeave:Connect(function()
                    TweenService:Create(Toggle, TweenInfo.new(0.2), {
                        BackgroundColor3 = Settings.Theme.Primary
                    }):Play()
                end)
                
                -- Toggle Object with API
                local ToggleObject = {
                    Instance = Toggle,
                    Set = function(self, state)
                        Enabled = state
                        UpdateToggle()
                        return self
                    end,
                    Get = function()
                        return Enabled
                    end
                }
                
                table.insert(SectionObject.Elements, ToggleObject)
                return ToggleObject
            end
            
            -- Add more UI elements here like AddToggle, AddSlider, etc.


            
            table.insert(TabObject.Elements, SectionObject)
            return SectionObject
        end
        
        -- Add tab to window object
        WindowObject.Tabs[tabIndex] = TabObject
        
        -- If this is the first tab, select it
        if tabIndex == 1 then
            TabButton.BackgroundColor3 = Settings.Theme.Accent
            TabButton.TextColor3 = Settings.Theme.Text
            TabContent.Visible = true
        end
        
        -- Auto-adjust TabButtonHolder canvas size
        TabButtonLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabButtonHolder.CanvasSize = UDim2.new(0, 0, 0, TabButtonLayout.AbsoluteContentSize.Y + 10)
        end)
        
        return TabObject
    end
    
    -- Apply opening animation
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.BackgroundTransparency = 1
    
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 500, 0, 350),
        Position = UDim2.new(0.5, -250, 0.5, -175),
        BackgroundTransparency = 1 - Settings.Transparency
    }):Play()
    
    return WindowObject
end

-- Return the module to ensure it's not nil
return NurkUI
