                Font = Settings.Font,
                Text = text,
                TextColor3 = Settings.Theme.TextColor,
                TextSize = Settings.TextSize,
                TextXAlignment = Enum.TextXAlignment.Left
            })
            
            local SliderBackground = Util.Create("Frame", {
                Name = "SliderBackground",
                Parent = SliderFrame,
                BackgroundColor3 = Settings.Theme.LightContrast,
                Position = UDim2.new(0, 0, 0, 25),
                Size = UDim2.new(1, 0, 0, 18),
                BorderSizePixel = 0
            })
            
            Util.Create("UICorner", {
                Parent = SliderBackground,
                CornerRadius = UDim.new(0, Settings.Rounding - 2)
            })
            
            local SliderFill = Util.Create("Frame", {
                Name = "SliderFill",
                Parent = SliderBackground,
                BackgroundColor3 = Settings.Theme.Accent,
                Size = UDim2.new(0, 0, 1, 0),
                BorderSizePixel = 0
            })
            
            Util.Create("UICorner", {
                Parent = SliderFill,
                CornerRadius = UDim.new(0, Settings.Rounding - 2)
            })
            
            local SliderBall = Util.Create("Frame", {
                Name = "SliderBall",
                Parent = SliderFill,
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Position = UDim2.new(1, -9, 0.5, -9),
                Size = UDim2.new(0, 18, 0, 18),
                BorderSizePixel = 0,
                ZIndex = 2
            })
            
            Util.Create("UICorner", {
                Parent = SliderBall,
                CornerRadius = UDim.new(1, 0)
            })
            
            local SliderValue = Util.Create("TextLabel", {
                Name = "SliderValue",
                Parent = SliderBackground,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 0),
                Size = UDim2.new(1, 0, 1, 0),
                Font = Settings.Font,
                Text = tostring(options.default),
                TextColor3 = Settings.Theme.TextColor,
                TextSize = Settings.TextSize - 2
            })
            
            -- Slider logic
            local percent = 0
            local value = options.default
            
            local function UpdateSlider(input)
                local sizeX = math.clamp((input.Position.X - SliderBackground.AbsolutePosition.X) / SliderBackground.AbsoluteSize.X, 0, 1)
                value = options.min + (options.max - options.min) * sizeX
                
                if not options.precise then
                    value = math.floor(value)
                end
                
                SliderValue.Text = options.precise and string.format("%.2f", value) or tostring(value)
                percent = sizeX
                
                Util.Tween(SliderFill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.1)
                pcall(callback, value)
            end
            
            -- Initialize slider
            local percentDefault = (options.default - options.min) / (options.max - options.min)
            SliderFill.Size = UDim2.new(percentDefault, 0, 1, 0)
            SliderValue.Text = options.precise and string.format("%.2f", options.default) or tostring(options.default)
            
            -- Slider interaction
            local sliding = false
            
            SliderBackground.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    UpdateSlider(input)
                end
            end)
            
            SliderBackground.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    UpdateSlider(input)
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    sliding = false
                end
            end)
            
            local SliderObj = {
                Instance = SliderFrame,
                GetValue = function()
                    return value
                end,
                SetValue = function(newValue)
                    newValue = math.clamp(newValue, options.min, options.max)
                    value = newValue
                    local newPercent = (value - options.min) / (options.max - options.min)
                    SliderValue.Text = options.precise and string.format("%.2f", value) or tostring(value)
                    Util.Tween(SliderFill, {Size = UDim2.new(newPercent, 0, 1, 0)}, 0.1)
                    pcall(callback, value)
                end
            }
            
            return SliderObj
        end
        
        -- End of Tab element creation methods
        
        -- Auto-adjust the tab list canvas size
        TabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabList.CanvasSize = UDim2.new(0, 0, 0, TabListLayout.AbsoluteContentSize.Y + 10)
        end)
        
        -- Insert the new tab into the window's tabs table
        table.insert(Window.Tabs, Tab)
        
        return Tab
    end
    
    return Window
end

return Library
