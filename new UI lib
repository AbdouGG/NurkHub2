                local KeyDisplay = Instance.new("TextButton", KeybindFrame)
                KeyDisplay.Name = "KeyDisplay"
                KeyDisplay.Size = UDim2.new(0.35, -10, 0, 28)
                KeyDisplay.Position = UDim2.new(0.65, 0, 0.5, -14)
                KeyDisplay.BackgroundColor3 = COLORS.SECONDARY
                KeyDisplay.Text = default and default.Name or "None"
                KeyDisplay.TextColor3 = COLORS.TEXT
                KeyDisplay.TextSize = 14
                KeyDisplay.Font = Enum.Font.Gotham
                KeyDisplay.ZIndex = 14
                
                local KeyDisplayCorner = Instance.new("UICorner", KeyDisplay)
                KeyDisplayCorner.CornerRadius = UDim.new(0, 6)
                
                -- Add a subtle stroke to key display
                local KeyDisplayStroke = Instance.new("UIStroke", KeyDisplay)
                KeyDisplayStroke.Color = COLORS.BORDER
                KeyDisplayStroke.Thickness = 1
                KeyDisplayStroke.Transparency = 0.7
                
                createHoverEffect(KeybindFrame)
                
                local listeningForKey = false
                local currentKey = default
                
                KeyDisplay.MouseButton1Click:Connect(function()
                    listeningForKey = true
                    KeyDisplay.Text = "Listening..."
                    KeyDisplay.TextColor3 = COLORS.ACCENT
                end)
                
                UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if not gameProcessed then
                        if listeningForKey then
                            if input.UserInputType == Enum.UserInputType.Keyboard then
                                currentKey = input.KeyCode
                                KeyDisplay.Text = input.KeyCode.Name
                                KeyDisplay.TextColor3 = COLORS.TEXT
                                listeningForKey = false
                                callback(input.KeyCode)
                            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                                -- Let the click-to-listen event pass through
                            else
                                currentKey = input.UserInputType
                                KeyDisplay.Text = input.UserInputType.Name
                                KeyDisplay.TextColor3 = COLORS.TEXT
                                listeningForKey = false
                                callback(input.UserInputType)
                            end
                        else
                            if currentKey and ((input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey) or 
                               (input.UserInputType ~= Enum.UserInputType.Keyboard and input.UserInputType == currentKey)) then
                                callback(currentKey)
                            end
                        end
                    end
                end)
                
                return {
                    Frame = KeybindFrame,
                    SetValue = function(_, key)
                        if typeof(key) == "EnumItem" then
                            currentKey = key
                            KeyDisplay.Text = key.Name
                            callback(key)
                        end
                    end
                }
            end
            
