        --// Dropdown
        function TabElements:Dropdown(DConfig)
             DConfig = DConfig or {}
             local DTitle = DConfig.Title or "Dropdown"
             local DOptions = DConfig.Options or {}
             local DCallback = DConfig.Callback or function() end
             
             local DropFrame = AddElementFrame(40)
             local Open = false
             
             local Title = Create("TextLabel", {
                 Parent = DropFrame,
                 BackgroundTransparency = 1,
                 Position = UDim2.new(0, 10, 0, 0),
                 Size = UDim2.new(0.5, 0, 0, 40),
                 Font = Enum.Font.GothamSemibold,
                 Text = DTitle,
                 TextColor3 = Theme.Text,
                 TextSize = 14,
                 TextXAlignment = Enum.TextXAlignment.Left
             })
             
             local ValueLabel = Create("TextLabel", {
                 Parent = DropFrame,
                 BackgroundTransparency = 1,
                 Position = UDim2.new(0.5, 0, 0, 0),
                 Size = UDim2.new(0.4, 0, 0, 40),
                 Font = Enum.Font.Gotham,
                 Text = "Select...",
                 TextColor3 = Theme.SubText,
                 TextSize = 13,
                 TextXAlignment = Enum.TextXAlignment.Right
             })
             
             local Arrow = Create("TextLabel", {
                 Parent = DropFrame,
                 BackgroundTransparency = 1,
                 Position = UDim2.new(1, -30, 0, 0),
                 Size = UDim2.new(0, 30, 0, 40),
                 Font = Enum.Font.GothamBold,
                 Text = "v",
                 TextColor3 = Theme.SubText,
                 TextSize = 14
             })
             
             local Container = Create("Frame", {
                 Parent = DropFrame,
                 BackgroundColor3 = Color3.fromRGB(40,40,40),
                 BackgroundTransparency = 0,
                 Position = UDim2.new(0, 0, 1, 5),
                 Size = UDim2.new(1, 0, 0, 0),
                 ClipsDescendants = true,
                 ZIndex = 5
             })
             Round(Container, 6)
             
             local ListLayout = Create("UIListLayout", {
                 Parent = Container,
                 SortOrder = Enum.SortOrder.LayoutOrder
             })
             
             local Trigger = Create("TextButton", {
                 Parent = DropFrame,
                 BackgroundTransparency = 1,
                 Size = UDim2.new(1, 0, 1, 0),
                 Text = ""
             })
             
             Trigger.MouseButton1Click:Connect(function()
                 Open = not Open
                 local TotalHeight = #DOptions * 30
                 Arrow.Text = Open and "^" or "v"
                 
                 if Open then
                     TweenService:Create(Container, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, TotalHeight)}):Play()
                     TweenService:Create(DropFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 40 + TotalHeight + 5)}):Play()
                 else
                     TweenService:Create(Container, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                     TweenService:Create(DropFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 40)}):Play()
                 end
             end)
             
             for _, OptionName in ipairs(DOptions) do
                 local OptBtn = Create("TextButton", {
                     Parent = Container,
                     BackgroundColor3 = Theme.Element,
                     Size = UDim2.new(1, 0, 0, 30),
                     Font = Enum.Font.Gotham,
                     Text = OptionName,
                     TextColor3 = Theme.SubText,
                     TextSize = 13,
                     ZIndex = 6
                 })
                 
                 OptBtn.MouseButton1Click:Connect(function()
                     ValueLabel.Text = OptionName
                     DCallback(OptionName)
                     
                     -- Close
                     Open = false
                     Arrow.Text = "v"
                     TweenService:Create(Container, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                     TweenService:Create(DropFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 40)}):Play()
                 end)
             end
        end

        return TabElements
    end
    
    return Window
end

return Library
