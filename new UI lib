                ArrowIcon.Name = "ArrowIcon"
                ArrowIcon.BackgroundTransparency = 1
                ArrowIcon.Position = UDim2.new(1, -24, 0, 0)
                ArrowIcon.Size = UDim2.new(0, 24, 1, 0)
                ArrowIcon.Font = Enum.Font.GothamBold
                ArrowIcon.Text = "▼"
                ArrowIcon.TextColor3 = Settings.Theme.SubText
                ArrowIcon.TextSize = 12
                ArrowIcon.ZIndex = 4
                ArrowIcon.Parent = SelectedValue
                
                -- Dropdown Content Container
                local DropdownContent = Instance.new("Frame")
                DropdownContent.Name = "DropdownContent"
                DropdownContent.BackgroundColor3 = Settings.Theme.Secondary
                DropdownContent.BackgroundTransparency = 0.2
                DropdownContent.ClipsDescendants = true
                DropdownContent.Position = UDim2.new(0, 0, 1, 5)
                DropdownContent.Size = UDim2.new(1, 0, 0, 0) -- Start closed
                -- Increase ZIndex significantly to ensure it appears on top
                DropdownContent.ZIndex = 20
                DropdownContent.Visible = false
                -- Make DropdownContent a child of the main GUI instead of Dropdown to prevent clipping
                DropdownContent.Parent = MainGui
                
                local ContentCorner = Instance.new("UICorner")
                ContentCorner.CornerRadius = UDim.new(0, 4)
                ContentCorner.Parent = DropdownContent
                
                -- Shadow for dropdown content
                CreateShadow(DropdownContent, 8)
                
                -- Options Layout
                local OptionsLayout = Instance.new("UIListLayout")
                OptionsLayout.Name = "OptionsLayout"
                OptionsLayout.Padding = UDim.new(0, 2)
                OptionsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                OptionsLayout.Parent = DropdownContent
                
                -- Padding at top and bottom
                local TopPadding = Instance.new("UIPadding")
                TopPadding.PaddingTop = UDim.new(0, 5)
                TopPadding.PaddingBottom = UDim.new(0, 5)
                TopPadding.Parent = DropdownContent
                
                -- State tracking
                local IsOpen = false
                local SelectedOption = default
                
                -- Create Option Button function
                local function CreateOption(optionText)
                    local Option = Instance.new("TextButton")
                    Option.Name = "Option_" .. optionText
                    Option.BackgroundColor3 = Settings.Theme.Primary
                    Option.BackgroundTransparency = 0.8
                    Option.Size = UDim2.new(1, -10, 0, 30)
                    Option.Font = Settings.Font
                    Option.Text = optionText
                    Option.TextColor3 = Settings.Theme.Text
                    Option.TextSize = 14
                    -- Increase ZIndex to match parent
                    Option.ZIndex = 21
                    Option.Parent = DropdownContent
                    Option.AutoButtonColor = false
                    
                    local OptionCorner = Instance.new("UICorner")
                    OptionCorner.CornerRadius = UDim.new(0, 4)
                    OptionCorner.Parent = Option
                    
                    -- Create ripple effect
                    CreateRipple(Option)
                    
                    -- Option hover effects
                    Option.MouseEnter:Connect(function()
                        TweenService:Create(Option, TweenInfo.new(0.2), {
                            BackgroundColor3 = Settings.Theme.Accent,
                            BackgroundTransparency = 0.7
                        }):Play()
                    end)
                    
                    Option.MouseLeave:Connect(function()
                        TweenService:Create(Option, TweenInfo.new(0.2), {
                            BackgroundColor3 = Settings.Theme.Primary,
                            BackgroundTransparency = 0.8
                        }):Play()
                    end)
                    
                    -- Option click
                    Option.MouseButton1Click:Connect(function()
                        SelectedOption = optionText
                        SelectedValue.Text = optionText
                        
                        -- Close dropdown
                        ToggleDropdown(false)
                        
                        -- Execute callback with selected option
                        task.spawn(function()
                            callback(optionText)
                        end)
                    end)
                    
                    return Option
                end
                
                -- Create option buttons
                for _, optionText in ipairs(options) do
                    CreateOption(optionText)
                end
                
                -- Calculate content height based on options
                local ContentHeight = #options * 32 + 10 -- Each option height + padding
                
                -- Toggle dropdown function
                function ToggleDropdown(forceState)
                    if forceState ~= nil then
                        IsOpen = forceState
                    else
                        IsOpen = not IsOpen
                    end
                    
                    if IsOpen then
                        -- Update position to match dropdown's position before showing
                        local dropdownAbsPos = Dropdown.AbsolutePosition
                        local dropdownAbsSize = Dropdown.AbsoluteSize
                        DropdownContent.Position = UDim2.fromOffset(
                            dropdownAbsPos.X, 
                            dropdownAbsPos.Y + dropdownAbsSize.Y + 5
                        )
                        DropdownContent.Size = UDim2.new(0, dropdownAbsSize.X, 0, 0)
                        
                        -- Show dropdown
                        DropdownContent.Visible = true
                        TweenService:Create(DropdownContent, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                            Size = UDim2.new(0, dropdownAbsSize.X, 0, math.min(ContentHeight, 200)) -- Limit max height
                        }):Play()
                        
                        -- Rotate arrow
                        TweenService:Create(ArrowIcon, TweenInfo.new(0.3), {
                            Rotation = 180
                        }):Play()
                    else
                        -- Hide dropdown
                        TweenService:Create(DropdownContent, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                            Size = UDim2.new(0, DropdownContent.AbsoluteSize.X, 0, 0)
                        }):Play()
                        
                        -- Rotate arrow back
                        TweenService:Create(ArrowIcon, TweenInfo.new(0.3), {
                            Rotation = 0
                        }):Play()
                        
                        -- Wait for animation to complete before hiding
                        task.delay(0.3, function()
                            if not IsOpen then
                                DropdownContent.Visible = false
                            end
                        end)
                    end
                end
                
                -- Connect selected value click to toggle
                SelectedValue.MouseButton1Click:Connect(function()
                    ToggleDropdown()
                end)
                
                -- Create ripple effect for selected value
                CreateRipple(SelectedValue)
                
                -- Hover effects for selected value
                SelectedValue.MouseEnter:Connect(function()
                    TweenService:Create(SelectedValue, TweenInfo.new(0.2), {
                        BackgroundColor3 = Color3.fromRGB(
                            Settings.Theme.Secondary.R * 1.1,
                            Settings.Theme.Secondary.G * 1.1,
                            Settings.Theme.Secondary.B * 1.1
                        ),
                        BackgroundTransparency = 0.4
                    }):Play()
                end)
                
                SelectedValue.MouseLeave:Connect(function()
                    TweenService:Create(SelectedValue, TweenInfo.new(0.2), {
                        BackgroundColor3 = Settings.Theme.Secondary,
                        BackgroundTransparency = 0.5
                    }):Play()
                end)
                
                -- Close dropdown when clicking outside
                local function CheckOutsideClick(input)
                    if not IsOpen then return end
                    
                    local clickPos = input.Position
                    local dropdownPos = Dropdown.AbsolutePosition
                    local dropdownSize = Dropdown.AbsoluteSize
                    local contentPos = DropdownContent.AbsolutePosition
                    local contentSize = DropdownContent.AbsoluteSize
                    
                    -- Check if click is outside dropdown and its content
                    local isOutsideMain = clickPos.X < dropdownPos.X or 
                                    clickPos.X > dropdownPos.X + dropdownSize.X or
                                    clickPos.Y < dropdownPos.Y or
                                    clickPos.Y > dropdownPos.Y + dropdownSize.Y
                                    
                    local isOutsideContent = clickPos.X < contentPos.X or 
                                        clickPos.X > contentPos.X + contentSize.X or
                                        clickPos.Y < contentPos.Y or
                                        clickPos.Y > contentPos.Y + contentSize.Y
                    
                    if isOutsideMain and isOutsideContent then
                        ToggleDropdown(false)
                    end
                end
                
                UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        CheckOutsideClick(input)
                    end
                end)
                
                -- Clean up function when the dropdown is destroyed
                local function CleanUp()
                    if DropdownContent then
                        DropdownContent:Destroy()
                    end
                end
                
                -- Cleanup when dropdown is destroyed
                Dropdown.AncestryChanged:Connect(function(_, parent)
                    if not parent then
                        CleanUp()
                    end
                end)
                
                -- Dropdown Object with API
                local DropdownObject = {
                    Instance = Dropdown,
                    Get = function()
                        return SelectedOption
                    end,
                    Set = function(self, option)
                        if table.find(options, option) then
                            SelectedOption = option
                            SelectedValue.Text = option
                            callback(option)
                        else
                            warn("Option '" .. tostring(option) .. "' not found in dropdown options")
                        end
                        return self
                    end,
                    Refresh = function(self, newOptions, keepSelection)
                        options = newOptions or {}
                        
                        -- Clear existing options
                        for _, child in pairs(DropdownContent:GetChildren()) do
                            if child:IsA("TextButton") then
                                child:Destroy()
                            end
                        end
                        
                        -- Add new options
                        for _, optionText in ipairs(options) do
                            CreateOption(optionText)
                        end
                        
                        -- Update content height
                        ContentHeight = #options * 32 + 10
                        
                        -- Update selection
                        if not keepSelection or not table.find(options, SelectedOption) then
                            SelectedOption = options[1] or ""
                            SelectedValue.Text = SelectedOption
                        end
                        
                        return self
                    end,
                    AddOption = function(self, optionText)
                        if not table.find(options, optionText) then
                            table.insert(options, optionText)
                            CreateOption(optionText)
                            ContentHeight = #options * 32 + 10
                        end
                        return self
                    end,
                    RemoveOption = function(self, optionText)
                        local index = table.find(options, optionText)
                        if index then
                            table.remove(options, index)
                            
                            -- Remove option button
                            local optionButton = DropdownContent:FindFirstChild("Option_" .. optionText)
                            if optionButton then
                                optionButton:Destroy()
                            end
                            
                            ContentHeight = #options * 32 + 10
                            
                            -- Update selection if removed option was selected
                            if SelectedOption == optionText then
                                SelectedOption = options[1] or ""
                                SelectedValue.Text = SelectedOption
                                callback(SelectedOption)
                            end
                        end
                        return self
                    end,
                    Destroy = function()
                        CleanUp()
                    end
                }
                
                table.insert(SectionObject.Elements, DropdownObject)
                return DropdownObject
            end

            -- Add Slider method for SectionObject
            function SectionObject:AddSlider(sliderText, min, max, default, increment, callback)
                min = min or 0
                max = max or 100
                default = default or min
                increment = increment or 1
                callback = callback or function() end
                
                -- Ensure default value is within bounds and properly incremented
                default = math.clamp(default, min, max)
                default = math.floor((default - min) / increment + 0.5) * increment + min
                
                -- Create Slider Container
                local Slider = Instance.new("Frame")
                Slider.Name = "Slider_" .. sliderText
                Slider.BackgroundColor3 = Settings.Theme.Primary
                Slider.BackgroundTransparency = 0.4
                Slider.Size = UDim2.new(1, 0, 0, 50)
                Slider.ZIndex = 4
                Slider.Parent = SectionContent
                
                local SliderCorner = Instance.new("UICorner")
                SliderCorner.CornerRadius = UDim.new(0, 4)
                SliderCorner.Parent = Slider
                
                -- Slider Label
                local SliderLabel = Instance.new("TextLabel")
                SliderLabel.Name = "SliderLabel"
                SliderLabel.BackgroundTransparency = 1
                SliderLabel.Position = UDim2.new(0, 10, 0, 0)
                SliderLabel.Size = UDim2.new(1, -20, 0, 20)
                SliderLabel.Font = Settings.Font
                SliderLabel.Text = sliderText
                SliderLabel.TextColor3 = Settings.Theme.Text
                SliderLabel.TextSize = 14
                SliderLabel.TextXAlignment = Enum.TextXAlignment.Left
                SliderLabel.ZIndex = 4
                SliderLabel.Parent = Slider
                
                -- Value Display
                local ValueDisplay = Instance.new("TextLabel")
                ValueDisplay.Name = "ValueDisplay"
                ValueDisplay.BackgroundTransparency = 1
                ValueDisplay.Position = UDim2.new(1, -60, 0, 0)
                ValueDisplay.Size = UDim2.new(0, 50, 0, 20)
                ValueDisplay.Font = Settings.Font
                ValueDisplay.Text = tostring(default)
                ValueDisplay.TextColor3 = Settings.Theme.SubText
                ValueDisplay.TextSize = 14
                ValueDisplay.TextXAlignment = Enum.TextXAlignment.Right
                ValueDisplay.ZIndex = 4
                ValueDisplay.Parent = Slider
                
                -- Slider Background
                local SliderBackground = Instance.new("Frame")
                SliderBackground.Name = "SliderBackground"
                SliderBackground.BackgroundColor3 = Settings.Theme.Secondary
                SliderBackground.Position = UDim2.new(0, 10, 0, 30)
                SliderBackground.Size = UDim2.new(1, -20, 0, 5)
                SliderBackground.ZIndex = 4
                SliderBackground.Parent = Slider
                
                local SliderBackgroundCorner = Instance.new("UICorner")
                SliderBackgroundCorner.CornerRadius = UDim.new(1, 0)
                SliderBackgroundCorner.Parent = SliderBackground
                
                -- Slider Fill
                local SliderFill = Instance.new("Frame")
                SliderFill.Name = "SliderFill"
                SliderFill.BackgroundColor3 = Settings.Theme.Accent
                SliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
                SliderFill.ZIndex = 5
                SliderFill.Parent = SliderBackground
                
                local SliderFillCorner = Instance.new("UICorner")
                SliderFillCorner.CornerRadius = UDim.new(1, 0)
                SliderFillCorner.Parent = SliderFill
                
                -- Slider Knob
                local SliderKnob = Instance.new("Frame")
                SliderKnob.Name = "SliderKnob"
                SliderKnob.BackgroundColor3 = Settings.Theme.Text
                SliderKnob.Position = UDim2.new(1, 0, 0.5, 0)
                SliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)
                SliderKnob.Size = UDim2.new(0, 14, 0, 14)
                SliderKnob.ZIndex = 6
                SliderKnob.Parent = SliderFill
                
                local SliderKnobCorner = Instance.new("UICorner")
                SliderKnobCorner.CornerRadius = UDim.new(1, 0)
                SliderKnobCorner.Parent = SliderKnob
                
                -- Shadow effect for the knob
                CreateShadow(SliderKnob, 4)
                
                -- Ripple effect for slider background
                CreateRipple(SliderBackground)
                
                -- Current value tracking
                local Value = default
                
                -- Format value display (handle decimals)
                local function FormatValue(value)
                    if increment >= 1 then
                        return tostring(math.floor(value))
                    else
                        local decimalPlaces = math.max(0, -math.floor(math.log10(increment) + 0.5))
                        return string.format("%." .. decimalPlaces .. "f", value)
                    end
                end
                
                -- Update slider visually and trigger callback
                local function UpdateSlider(value, isUserInteraction)
                    -- Clamp value between min and max
                    value = math.clamp(value, min, max)
                    
                    -- Round to nearest increment
                    value = math.floor((value - min) / increment + 0.5) * increment + min
                    
                    -- Store value
                    Value = value
                    
                    -- Update value display
                    ValueDisplay.Text = FormatValue(value)
                    
                    -- Update slider fill and knob position
                    local percent = (value - min) / (max - min)
                    SliderFill.Size = UDim2.new(percent, 0, 1, 0)
                    
                    -- Execute callback if this was triggered by user
                    if isUserInteraction then
                        task.spawn(function()
                            callback(value)
                        end)
                    end
                end
                
                -- Slider interaction
                local function BeginSliding(input)
                    local Connection
                    
                    local function UpdateFromMousePosition(input)
                        local sliderPos = SliderBackground.AbsolutePosition.X
                        local sliderWidth = SliderBackground.AbsoluteSize.X
                        local mousePos = input.Position.X
                        
                        -- Calculate relative position and convert to value
                        local relPos = math.clamp((mousePos - sliderPos) / sliderWidth, 0, 1)
                        local newValue = min + (max - min) * relPos
                        
                        UpdateSlider(newValue, true)
                    end
                    
                    -- Initial update
                    UpdateFromMousePosition(input)
                    
                    -- Continue updating while mouse is down
                    Connection = UserInputService.InputChanged:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseMovement or 
                        input.UserInputType == Enum.UserInputType.Touch then
                            UpdateFromMousePosition(input)
                        end
                    end)
                    
                    -- Clean up when input ends
                    local EndConnection
                    EndConnection = UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or
                        input.UserInputType == Enum.UserInputType.Touch then
                            if Connection then
                                Connection:Disconnect()
                            end
                            EndConnection:Disconnect()
                        end
                    end)
                end
                
                -- Connect events
                SliderBackground.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
                    input.UserInputType == Enum.UserInputType.Touch then
                        BeginSliding(input)
                    end
                end)
                
                SliderKnob.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
                    input.UserInputType == Enum.UserInputType.Touch then
                        BeginSliding(input)
                    end
                end)
                
                -- Hover effects for slider background
                SliderBackground.MouseEnter:Connect(function()
                    TweenService:Create(SliderKnob, TweenInfo.new(0.2), {
                        Size = UDim2.new(0, 16, 0, 16)
                    }):Play()
                end)
                
                SliderBackground.MouseLeave:Connect(function()
                    TweenService:Create(SliderKnob, TweenInfo.new(0.2), {
                        Size = UDim2.new(0, 14, 0, 14)
                    }):Play()
                end)
                
                -- Slider Object with API
                local SliderObject = {
                    Instance = Slider,
                    Get = function()
                        return Value
                    end,
                    Set = function(self, value, runCallback)
                        UpdateSlider(value, runCallback == true)
                        return self
                    end,
                    SetRange = function(self, newMin, newMax)
                        min = newMin
                        max = newMax
                        Value = math.clamp(Value, min, max)
                        UpdateSlider(Value, false)
                        return self
                    end,
                    SetIncrement = function(self, newIncrement)
                        increment = newIncrement
                        UpdateSlider(Value, false)
                        return self
                    end
                }
                
                table.insert(SectionObject.Elements, SliderObject)
                return SliderObject
            end

