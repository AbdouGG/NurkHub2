local function GetSeedTools()
    local tools = {}
    local backpack = game:GetService("Players").LocalPlayer.Backpack
    local character = game:GetService("Players").LocalPlayer.Character
    
    for _, container in {backpack, character} do
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:find("Seed") then
                local seedName = tool.Name:gsub(" Seed", ""):gsub(" %[X%d+%]", "")
                table.insert(tools, {
                    Tool = tool,
                    Name = seedName,
                    Stack = tonumber(tool.Name:match("%[X(%d+)%]")) or 1
                })
            end
        end
    end
    
    return tools
end

local function GetRandomPlantPosition()
    local minX = math.min(currentPlantArea.Min.X, currentPlantArea.Max.X)
    local maxX = math.max(currentPlantArea.Min.X, currentPlantArea.Max.X)
    local minZ = math.min(currentPlantArea.Min.Z, currentPlantArea.Max.Z)
    local maxZ = math.max(currentPlantArea.Min.Z, currentPlantArea.Max.Z)
    
    if minX == maxX then maxX = minX + 0.1 end
    if minZ == maxZ then maxZ = minZ + 0.1 end
    
    return Vector3.new(
        math.random(minX * 100, maxX * 100) / 100,
        currentPlantArea.Min.Y,
        math.random(minZ * 100, maxZ * 100) / 100
    )
end

local function EquipTool(tool)
    local humanoid = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
