end

local function PlantSeed(seedName)
    local success, plantPos = pcall(GetRandomPlantPosition)
    if not success then
        OrionLib:MakeNotification({
            Name = "Error",
            Content = "Invalid planting area!",
            Image = "rbxassetid://4483345998",
            Time = 2 -- Shorter notification time
        })
        return false
    end
    
    local args = {plantPos, seedName}
    
    local success = pcall(function()
        game:GetService("ReplicatedStorage").GameEvents.Plant_RE:FireServer(unpack(args))
    end)
    
    if success then
        OrionLib:MakeNotification({
            Name = "Planted",
            Content = seedName.." at "..tostring(plantPos),
            Image = "rbxassetid://4483345998",
            Time = 0.5 -- Very short notification time
        })
        
        task.spawn(function()
            task.wait(0.2) -- Shorter wait time
            UpdateStockDisplay()
        end)
    end
    return success
end

local function ProcessSeedTool(toolData)
    if not toolData.Tool or not toolData.Tool.Parent then
        return false
    end
    
    if not EquipTool(toolData.Tool) then
        return false
    end
    
    for i = 1, toolData.Stack do
        if not getgenv().AutoPlantEnabled then break end
        local success = PlantSeed(toolData.Name)
        if not success then break end
        task.wait(0.1) -- Reduced wait time
    end
    
    return true
end

local function AutoPlantSeeds()
    while getgenv().AutoPlantEnabled do
        local seedTools = GetSeedTools()
        if #seedTools == 0 then
            OrionLib:MakeNotification({
                Name = "Warning",
                Content = "No seeds found in backpack!",
                Image = "rbxassetid://4483345998",
                Time = 2 -- Shorter notification time
            })
            task.wait(1) -- Reduced wait time
        else
            for _, toolData in ipairs(seedTools) do
                if not getgenv().AutoPlantEnabled then break end
                ProcessSeedTool(toolData)
            end
        end
        task.wait(0.2) -- Reduced wait time
        
        UpdateStockDisplay()
    end
end

local function HandlePositionSelection(input, gameProcessed)
    if positionSelectMode and not gameProcessed then
        local inputType = input.UserInputType
        
        -- Check for both mouse click and touch input
        if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
            local pos
            if inputType == Enum.UserInputType.MouseButton1 then
                pos = game.Players.LocalPlayer:GetMouse().Hit.Position
            else -- Touch input
                local touchPos = input.Position
                local unitRay = workspace.CurrentCamera:ViewportPointToRay(touchPos.X, touchPos.Y)
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {workspace.Terrain}
                local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
                
                if raycastResult then
                    pos = raycastResult.Position
                else
                    return -- No valid position found
                end
            end
            
            table.insert(positionSelection, pos)
            
            if #positionSelection == 1 then
                OrionLib:MakeNotification({
                    Name = "Position Selected",
                    Content = "First corner set! Tap second position.",
                    Image = "rbxassetid://4483345998",
                    Time = 2 -- Shorter notification time
                })
            elseif #positionSelection >= 2 then
                positionSelectMode = false
                currentPlantArea = {
                    Min = Vector3.new(
                        math.min(positionSelection[1].X, positionSelection[2].X),
                        positionSelection[1].Y,
                        math.min(positionSelection[1].Z, positionSelection[2].Z)
                    ),
                    Max = Vector3.new(
                        math.max(positionSelection[1].X, positionSelection[2].X),
                        positionSelection[1].Y,
                        math.max(positionSelection[1].Z, positionSelection[2].Z)
                    )
                }
                OrionLib:MakeNotification({
                    Name = "Area Set",
                    Content = string.format("Planting area set from %s to %s", 
                        tostring(positionSelection[1]), 
                        tostring(positionSelection[2])),
                    Image = "rbxassetid://4483345998",
                    Time = 3 -- Shorter notification time
                })
            end
        end
    end
end

function UpdateStockDisplay()
    if not StockTab then return end
    
    local seedShop = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("Seed_Shop")
    if not seedShop then return end
    
    local scrollingFrame = seedShop.Frame:FindFirstChild("ScrollingFrame")
    if not scrollingFrame then return end
    
    local stockInfo = {}
    
    for _, child in ipairs(scrollingFrame:GetChildren()) do
        if child:IsA("Frame") and child:FindFirstChild("Main_Frame") then
            local mainFrame = child.Main_Frame
            local seedText = mainFrame:FindFirstChild("Seed_Text")
            local stockText = mainFrame:FindFirstChild("Stock_Text")
            
            if seedText and stockText and seedText.Text and stockText.Text then
                local seedName = seedText.Text
                local stock = stockText.Text
                local stockCount = tonumber(stock:match("X(%d+)") or "0")
                
                if stockCount > 0 then
                    table.insert(stockInfo, {name = seedName, count = stockCount, text = stock})
                end
            end
        end
    end
    
    table.sort(stockInfo, function(a, b) return a.name < b.name end)
    
    for _, label in ipairs(stockLabels) do
        label:Set("")
    end
    
    for i, info in ipairs(stockInfo) do
        if stockLabels[i] then
            stockLabels[i]:Set(info.name..": "..info.text)
        else
            local newLabel = stockInfoSection:AddLabel(info.name..": "..info.text)
            table.insert(stockLabels, newLabel)
        end
    end
    
    if #stockInfo == 0 then
        if #stockLabels > 0 then
            stockLabels[1]:Set("No seeds in stock")
            for i = 2, #stockLabels do
                stockLabels[i]:Set("")
            end
        else
            local noStockLabel = stockInfoSection:AddLabel("No seeds in stock")
            table.insert(stockLabels, noStockLabel)
        end
    end
end

local function StartStockMonitor()
    if stockMonitorRunning then return end
    stockMonitorRunning = true
    
    task.spawn(function()
        task.wait(1) -- Reduced initial wait time
        UpdateStockDisplay()
    end)
    
    while stockMonitorRunning do
        task.wait(2) -- Reduced update interval
        pcall(UpdateStockDisplay)
    end
end

-- ========== TOGGLE CONTROLS ==========
local function ToggleAutoPress(state)
    if state then
        getgenv().AutoPressLoop = task.spawn(function()
            while getgenv().AutoPressEnabled do
                AutoPressPrompts()
                task.wait(0.1) -- Very short delay between cycles
            end
        end)
    else
        if getgenv().AutoPressLoop then
            task.cancel(getgenv().AutoPressLoop)
        end
    end
end

local function ToggleAutoSell(state)
    if state then
        getgenv().HasTeleported = false
        getgenv().AutoSellLoop = task.spawn(function()
            while getgenv().AutoSellEnabled do
                AutoSell()
                task.wait(0.5) -- Reduced wait time
                UpdateStockDisplay()
            end
        end)
    else
        if getgenv().AutoSellLoop then
            task.cancel(getgenv().AutoSellLoop)
        end
    end
end

local function ToggleAutoBuy(state)
