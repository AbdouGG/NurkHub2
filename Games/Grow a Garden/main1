        getgenv().AutoBuyLoop = task.spawn(function()
            while getgenv().AutoBuyEnabled do
                BuySeed(selectedSeed)
                task.wait(0.5) -- Reduced wait time
            end
        end)
    else
        if getgenv().AutoBuyLoop then
            task.cancel(getgenv().AutoBuyLoop)
        end
    end
end

local function ToggleAutoPlant(state)
    if state then
        getgenv().AutoPlantEnabled = true
        getgenv().AutoPlantThread = task.spawn(AutoPlantSeeds)
        OrionLib:MakeNotification({
            Name = "Started",
            Content = "Auto Plant enabled!",
            Image = "rbxassetid://4483345998",
            Time = 2 -- Shorter notification time
        })
    else
        getgenv().AutoPlantEnabled = false
        if getgenv().AutoPlantThread then
            task.cancel(getgenv().AutoPlantThread)
        end
        OrionLib:MakeNotification({
            Name = "Stopped",
            Content = "Auto Plant disabled",
            Image = "rbxassetid://4483345998",
            Time = 2 -- Shorter notification time
        })
    end
end

local function TogglePositionSelect(state)
    positionSelectMode = state
    positionSelection = {}
    
    if state then
        OrionLib:MakeNotification({
            Name = "Position Select",
            Content = "Tap two positions to set planting area (works with touch/mouse)",
            Image = "rbxassetid://4483345998",
