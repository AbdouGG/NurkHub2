local function FindPlayerFarmFolder()
    local localPlayer = game.Players.LocalPlayer
    local playerName = localPlayer.Name
    
    -- First, check all direct Farm folders in workspace
    for _, farmFolder in ipairs(workspace:GetChildren()) do
        if farmFolder.Name == "Farm" then
            -- Check if this is a top-level farm or a nested one
            if farmFolder:FindFirstChild("Important") then
                local importantFolder = farmFolder:FindFirstChild("Important")
                local dataFolder = importantFolder and importantFolder:FindFirstChild("Data")
                local ownerValue = dataFolder and dataFolder:FindFirstChild("Owner")
                
                if ownerValue and tostring(ownerValue.Value) == playerName then
                    return farmFolder
                end
            end
            
            -- Check if this is a container for multiple farms
            for _, nestedFarm in ipairs(farmFolder:GetChildren()) do
                if nestedFarm.Name == "Farm" then
                    local importantFolder = nestedFarm:FindFirstChild("Important")
                    if importantFolder then
                        local dataFolder = importantFolder:FindFirstChild("Data")
                        if dataFolder then
                            local ownerValue = dataFolder:FindFirstChild("Owner")
                            if ownerValue and tostring(ownerValue.Value) == playerName then
                                return nestedFarm
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Fallback: Try to find any farm with the player as owner
    local function searchInChildren(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child.Name == "Farm" and (child:IsA("Folder") or child:IsA("Model")) then
                local importantFolder = child:FindFirstChild("Important")
                if importantFolder then
                    local dataFolder = importantFolder:FindFirstChild("Data")
                    if dataFolder then
                        local ownerValue = dataFolder:FindFirstChild("Owner")
                        if ownerValue and tostring(ownerValue.Value) == playerName then
                            return child
                        end
                    end
                end
            end
            
            if #child:GetChildren() > 0 then
                local result = searchInChildren(child)
                if result then return result end
            end
        end
        return nil
    end
    
    return searchInChildren(workspace)
end

local function TweenToPosition(position, callback)
    local character = game.Players.LocalPlayer.Character
    if not character then return false end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    -- Use faster tween settings
    local tweenInfo = TweenInfo.new(
        tweenSpeed, -- Very short duration
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.In,
        0, -- No repeat
        false, -- Don't reverse
        0 -- No delay
    )
    
    -- Create and play tween
    local tween = game:GetService("TweenService"):Create(
        humanoidRootPart,
        tweenInfo,
        {CFrame = CFrame.new(position + Vector3.new(0, 3, 0))} -- Slightly above the plant
    )
    
    tween:Play()
    tween.Completed:Wait()
    
    if callback then
        callback()
    end
    
    return true
end

local function CollectPlant(plantModel)
    if not plantModel or not plantModel.Parent then return false end
    
    -- Find all proximity prompts in the plant
    local prompts = {}
    for _, prompt in ipairs(plantModel:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            table.insert(prompts, prompt)
        end
    end
    
    if #prompts == 0 then return false end
    
    -- Get plant position (use primary part if available)
    local plantPosition
    if plantModel.PrimaryPart then
        plantPosition = plantModel.PrimaryPart.Position
    else
        plantPosition = plantModel:GetPivot().Position
    end
    
    -- Tween to the plant's position
    local success = TweenToPosition(plantPosition, function()
        -- After reaching the plant, click all prompts instantly
        for _, prompt in ipairs(prompts) do
            fireproximityprompt(prompt, 0)
            task.wait(0.05) -- Minimal delay between prompts
        end
    end)
    
    return success
end

local function AutoPressPrompts()
    -- Find player's farm folder if not already found
    if not playerFarmFolder then
        playerFarmFolder = FindPlayerFarmFolder()
        if not playerFarmFolder then
            OrionLib:MakeNotification({
                Name = "Error",
                Content = "Could not find your farm folder! Make sure you're in your farm area.",
                Image = "rbxassetid://4483345998",
                Time = 5
            })
            return false
        end
    end

    -- Check if Important folder exists
    if not playerFarmFolder:FindFirstChild("Important") then
        OrionLib:MakeNotification({
            Name = "Error",
            Content = "Important folder not found in your farm!",
            Image = "rbxassetid://4483345998",
            Time = 5
        })
        return false
    end

    -- Find Plants_Physical folder
    local plantsFolder = playerFarmFolder.Important:FindFirstChild("Plants_Physical")
    
    -- If Plants_Physical is not directly in Important, try to find it elsewhere
    if not plantsFolder then
        for _, folder in ipairs(playerFarmFolder:GetDescendants()) do
            if folder.Name == "Plants_Physical" then
                plantsFolder = folder
                break
            end
        end
    end
    
    if not plantsFolder then
        OrionLib:MakeNotification({
            Name = "Error",
            Content = "Plants_Physical folder not found in your farm!",
            Image = "rbxassetid://4483345998",
            Time = 5
        })
        return false
    end

    -- Get all plant models
    local plantModels = {}
    for _, plantModel in ipairs(plantsFolder:GetChildren()) do
        if plantModel:IsA("Model") then
            table.insert(plantModels, plantModel)
        end
    end

    -- Sort plants by distance to player (closest first)
    local character = game.Players.LocalPlayer.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            table.sort(plantModels, function(a, b)
                return (humanoidRootPart.Position - (a.PrimaryPart or a:GetPivot()).Position).Magnitude <
                       (humanoidRootPart.Position - (b.PrimaryPart or b:GetPivot()).Position).Magnitude
            end)
        end
    end

    -- Collect each plant with minimal delay
    for _, plantModel in ipairs(plantModels) do
        if not getgenv().AutoPressEnabled then break end
        CollectPlant(plantModel)
        task.wait(0.05) -- Very short delay between plants
    end

    return true
end

