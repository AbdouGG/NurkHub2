local function GetSeedNames()
    local seedData = game:GetService("ReplicatedStorage").Data.SeedData
    local names = {}
    
    for seedName, _ in pairs(require(seedData)) do
        table.insert(names, seedName)
    end
    
    table.sort(names)
    return names
end

local function BuySeed(seedName)
