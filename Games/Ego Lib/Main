--[[
    ╔══════════════════════════════════════════════════════════════════════════╗
    ║                 Premium UI Library  v3.8                               ║
    ║  Professional, minimalist CoreGui framework for Roblox                 ║
    ║  5 Dynamic Themes · Notification Stack · JSON Config System · Mobile   ║
    ║  Fluent / Microsoft modern dark aesthetics                             ║
    ╚══════════════════════════════════════════════════════════════════════════╝

    API:
      Library.new(title)                          → Window
      Window:CreateTab(name, iconId)              → Tab
      Tab:AddSection(text)
      Tab:AddSeparator()
      Tab:AddLabel(text)                          → { Set }
      Tab:AddButton(text, callback)
      Tab:AddToggle(text, default, flag, callback)→ { Set, Get }
      Tab:AddSlider(text, min, max, def, flag, cb)→ { Set, Get }
      Tab:AddDropdown(text, opts, def, flag, cb)  → { Set, Get, Refresh }
      Tab:AddTextBox(text, placeholder, flag, cb) → { Set, Get }
      Library:SetTheme(name)
      Library:RegisterTheme(name, colorTable)
      Library:Notify({ Title, Content, Duration, Type })
      Library:SaveConfig(configName)
      Library:LoadConfig(configName)
      Library:DeleteConfig(configName)
      Window:Toggle()
      Window:Destroy()

    See USAGE EXAMPLE at the bottom of this file.
]]

local Library = {}

--------------------------------------------------------------------------------
-- Services
--------------------------------------------------------------------------------
local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")
local HttpService      = game:GetService("HttpService")

--------------------------------------------------------------------------------
-- Platform Detection & Responsive Constants
--------------------------------------------------------------------------------
local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local TWEEN_SPEED  = 0.12
local TWEEN_EASING = Enum.EasingStyle.Quad
local TWEEN_DIR    = Enum.EasingDirection.Out
local CORNER_SM    = UDim.new(0, 4)
local CORNER_MD    = UDim.new(0, 5)
local CORNER_LG    = UDim.new(0, 6)
local CORNER_FULL  = UDim.new(1, 0)
local TAP_THRESHOLD = 6

local R = {
    TopBarH   = IS_MOBILE and 44 or 38,
    SidebarW  = IS_MOBILE and 115 or 148,
    ElementH  = IS_MOBILE and 42 or 36,
    SliderH   = IS_MOBILE and 58 or 52,
    TabBtnH   = IS_MOBILE and 36 or 32,
    OptionH   = IS_MOBILE and 34 or 28,
    FontTitle = IS_MOBILE and 14 or 13,
    FontBody  = IS_MOBILE and 13 or 12,
    FontSmall = IS_MOBILE and 12 or 11,
    FontMicro = IS_MOBILE and 11 or 10,
    ScrollBar = IS_MOBILE and 4 or 2,
    FloatSz   = IS_MOBILE and 48 or 44,
    NotifW    = IS_MOBILE and 260 or 300,
}

--------------------------------------------------------------------------------
-- Theme Tracking & Config System
--------------------------------------------------------------------------------
Library._themed = {}           -- { { inst, prop, key }, ... }
Library._registry = {}         -- flag -> Element Object
Library._autoLoadedValues = {} -- flag -> Auto loaded value
Library._activeThemeName = "Fluent Dark"
Library._notifGui = nil
Library._notifArea = nil
Library.AutoSave = false
Library._loadingConfig = false

--------------------------------------------------------------------------------
-- Theme Definitions
--------------------------------------------------------------------------------
local function computeDerived(t)
    local brightness = (t.Background.R + t.Background.G + t.Background.B) / 3
    local isDark = brightness < 0.5
    local s1 = isDark and 0.035 or -0.035
    local s2 = isDark and 0.02  or -0.02

    t.TopBar = t.Sidebar
    t.Hover = Color3.new(
        math.clamp(t.CardColor.R + s1, 0, 1),
        math.clamp(t.CardColor.G + s1, 0, 1),
        math.clamp(t.CardColor.B + s1, 0, 1)
    )
    t.Active = Color3.new(
        math.clamp(t.Hover.R + s2, 0, 1),
        math.clamp(t.Hover.G + s2, 0, 1),
        math.clamp(t.Hover.B + s2, 0, 1)
    )
    t.ToggleOff = t.Border
    t.InputBg = Color3.new(
        math.clamp(t.Background.R + (isDark and -0.01 or 0.025), 0, 1),
        math.clamp(t.Background.G + (isDark and -0.01 or 0.025), 0, 1),
        math.clamp(t.Background.B + (isDark and -0.01 or 0.025), 0, 1)
    )
    t.Knob = Color3.fromRGB(255, 255, 255)
    t.FloatBg = t.CardColor
    t.FloatBorder = t.Accent
    t.TextInverse = isDark and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(20, 20, 20)
    return t
end

