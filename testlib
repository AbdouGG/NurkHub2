                Parent = ToggleFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 25),
                Size = UDim2.new(1, -70, 0, 15),
                Font = Enum.Font.Gotham,
                Text = desc,
                TextColor3 = Theme.TextDark,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left
            })
        else
             TglText.Position = UDim2.new(0, 10, 0, 0)
             TglText.Size = UDim2.new(1, -70, 1, 0)
        end

        -- Switch Visual
        local SwitchBg = Create("Frame", {
            Parent = ToggleFrame,
            BackgroundColor3 = State and Theme.Accent or Color3.fromRGB(25, 25, 25),
            Position = UDim2.new(1, -50, 0.5, -10),
            Size = UDim2.new(0, 40, 0, 20)
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SwitchBg})

        local SwitchCircle = Create("Frame", {
            Parent = SwitchBg,
            BackgroundColor3 = Theme.Text,
            Position = State and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
            Size = UDim2.new(0, 16, 0, 16)
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SwitchCircle})

        ToggleFrame.MouseButton1Click:Connect(function()
            State = not State
            
            -- Animate
            if State then
                TweenService:Create(SwitchBg, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent}):Play()
                TweenService:Create(SwitchCircle, TweenInfo.new(0.2), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
            else
                TweenService:Create(SwitchBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 25)}):Play()
                TweenService:Create(SwitchCircle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
            end
            
            callback(State)
        end)
    end

    function Elements:Slider(options)
        local text = options.Text or "Slider"
        local min = options.Min or 0
        local max = options.Max or 100
        local default = options.Default or min
        local callback = options.Callback or function() end

        local SliderFrame = Create("Frame", {
            Parent = Container,
            BackgroundColor3 = Theme.Secondary,
            Size = UDim2.new(0.95, 0, 0, 50)
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = SliderFrame})
        Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = SliderFrame, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})

        Create("TextLabel", {
            Parent = SliderFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 5),
            Size = UDim2.new(1, -20, 0, 20),
            Font = Enum.Font.GothamBold,
            Text = text,
            TextColor3 = Theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left
        })

        local ValueLabel = Create("TextLabel", {
            Parent = SliderFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 5),
            Size = UDim2.new(1, -20, 0, 20),
            Font = Enum.Font.Gotham,
            Text = tostring(default),
            TextColor3 = Theme.TextDark,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right
        })

        local SliderBg = Create("TextButton", { -- Using TextButton for input capture
            Parent = SliderFrame,
            BackgroundColor3 = Color3.fromRGB(25, 25, 25),
            Position = UDim2.new(0, 10, 0, 30),
            Size = UDim2.new(1, -20, 0, 10),
            Text = "",
            AutoButtonColor = false
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SliderBg})

        local SliderFill = Create("Frame", {
            Parent = SliderBg,
            BackgroundColor3 = Theme.Accent,
            Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SliderFill})

        local Dragging = false
        
        local function UpdateSlider(input)
            local SizeX = SliderBg.AbsoluteSize.X
            local PositionX = SliderBg.AbsolutePosition.X
            local InputX = input.Position.X
            
            local Percent = math.clamp((InputX - PositionX) / SizeX, 0, 1)
            local Value = math.floor(min + ((max - min) * Percent))
            
            SliderFill.Size = UDim2.new(Percent, 0, 1, 0)
            ValueLabel.Text = tostring(Value)
            callback(Value)
        end

        SliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                Dragging = true
                UpdateSlider(input)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                Dragging = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateSlider(input)
            end
        end)
    end

    function Elements:Dropdown(options)
        local text = options.Text or "Dropdown"
        local list = options.Options or {}
        local callback = options.Callback or function() end
        
        local DropdownOpen = false
        local DropHeight = 45

        local DropdownFrame = Create("TextButton", {
            Parent = Container,
            BackgroundColor3 = Theme.Secondary,
            Size = UDim2.new(0.95, 0, 0, DropHeight),
            AutoButtonColor = false,
            Text = "",
            ClipsDescendants = true
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = DropdownFrame})
        Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = DropdownFrame, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})

        local DropText = Create("TextLabel", {
            Parent = DropdownFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 0),
            Size = UDim2.new(1, -40, 0, 45),
            Font = Enum.Font.GothamBold,
            Text = text,
            TextColor3 = Theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left
        })
        
        local Icon = Create("ImageLabel", {
            Parent = DropdownFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -30, 0, 12),
            Size = UDim2.new(0, 20, 0, 20),
            Image = "rbxassetid://6031091004", -- Chevron Down
            ImageColor3 = Theme.TextDark
        })

        -- Options Container
        local OptionContainer = Create("Frame", {
            Parent = DropdownFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 45),
            Size = UDim2.new(1, 0, 0, 0)
        })
        
        local OptionList = Create("UIListLayout", {
            Parent = OptionContainer,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 5)
        })

        -- Refresh Options function
        local function RefreshOptions()
            -- Clear old
            for _, v in pairs(OptionContainer:GetChildren()) do
                if v:IsA("TextButton") then v:Destroy() end
            end
            
            -- Add new
            for _, opt in pairs(list) do
                local OptBtn = Create("TextButton", {
                    Parent = OptionContainer,
                    BackgroundColor3 = Color3.fromRGB(30, 30, 30),
                    Size = UDim2.new(0.9, 0, 0, 30),
                    Text = opt,
                    Font = Enum.Font.Gotham,
                    TextColor3 = Theme.TextDark,
                    TextSize = 13,
                    AutoButtonColor = true
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = OptBtn})
                
                OptBtn.MouseButton1Click:Connect(function()
                    DropText.Text = text .. ": " .. opt
                    callback(opt)
                    -- Close dropdown
                    DropdownOpen = false
                    DropdownFrame:TweenSize(UDim2.new(0.95, 0, 0, 45), "Out", "Quad", 0.2, true)
                    Icon.Rotation = 0
                end)
            end
            
            -- Center options
            for _, v in pairs(OptionContainer:GetChildren()) do
                 if v:IsA("TextButton") then
                    v.Position = UDim2.new(0.05, 0, 0, 0)
                 end
            end
        end
        
        RefreshOptions()

        DropdownFrame.MouseButton1Click:Connect(function()
            DropdownOpen = not DropdownOpen
            local ListSize = OptionList.AbsoluteContentSize.Y
            
            if DropdownOpen then
                DropdownFrame:TweenSize(UDim2.new(0.95, 0, 0, 45 + ListSize + 10), "Out", "Quad", 0.2, true)
                Icon.Rotation = 180
            else
                DropdownFrame:TweenSize(UDim2.new(0.95, 0, 0, 45), "Out", "Quad", 0.2, true)
                Icon.Rotation = 0
            end
        end)
    end

    return Elements
end

return Library
