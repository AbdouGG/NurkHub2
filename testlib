            -- New Paragraph Functionality:
            -- Creates a paragraph container with a title and multi–line text label.
            function section:AddParagraph(paragraphTitle, paragraphContent)
                local ParagraphFrame = Instance.new("Frame", SectionContent)
                ParagraphFrame.Name = "ParagraphFrame"
                ParagraphFrame.BackgroundTransparency = 1
                ParagraphFrame.Size = UDim2.new(0.92, 0, 0, 50)  -- Initial height
                local paragraphLayout = Instance.new("UIListLayout", ParagraphFrame)
                paragraphLayout.FillDirection = Enum.FillDirection.Vertical
                paragraphLayout.SortOrder = Enum.SortOrder.LayoutOrder
                paragraphLayout.Padding = UDim.new(0, 4)
                -- Update ParagraphFrame's size when the layout's content size changes
                paragraphLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    ParagraphFrame.Size = UDim2.new(0.92, 0, 0, paragraphLayout.AbsoluteContentSize.Y)
                end)

                local TitleLabel = Instance.new("TextLabel", ParagraphFrame)
                TitleLabel.Name = "ParagraphTitle"
                TitleLabel.Size = UDim2.new(1, 0, 0, 20)
                TitleLabel.BackgroundTransparency = 1
                TitleLabel.Text = paragraphTitle or ""
                TitleLabel.TextColor3 = COLORS.TEXT
                TitleLabel.Font = Enum.Font.GothamBold
                TitleLabel.TextSize = 16
                TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

                local ContentLabel = Instance.new("TextLabel", ParagraphFrame)
                ContentLabel.Name = "ParagraphContent"
                ContentLabel.Size = UDim2.new(1, 0, 0, 20)
                ContentLabel.BackgroundTransparency = 1
                ContentLabel.Text = paragraphContent or ""
                ContentLabel.TextColor3 = COLORS.TEXT
                ContentLabel.Font = Enum.Font.Gotham
                ContentLabel.TextSize = 15
                ContentLabel.TextWrapped = true
                ContentLabel.TextXAlignment = Enum.TextXAlignment.Left
                ContentLabel.AutomaticSize = Enum.AutomaticSize.Y

                return {Container = ParagraphFrame, Title = TitleLabel, Content = ContentLabel}
            end

            function section:AddLabel(text)
                local Label = Instance.new("TextLabel", SectionContent)
                Label.Name = "Label"
                Label.Size = UDim2.new(0.92, 0, 0, 30)
                Label.BackgroundTransparency = 1
                Label.Text = text or ""
                Label.TextColor3 = COLORS.TEXT
                Label.TextSize = 15
                Label.Font = Enum.Font.GothamSemibold
                Label.TextXAlignment = Enum.TextXAlignment.Left
                return Label
            end

            return section
        end

        return tab
    end

    ----------------------------------------------------------------
    -- Mobile Toggle Button & Dragging
    ----------------------------------------------------------------
    local ToggleButton = Instance.new("TextButton", ScreenGui)
    ToggleButton.Name = "ToggleButton"
    ToggleButton.Size = UDim2.new(0, 45, 0, 45)
    ToggleButton.Position = UDim2.new(0, 15, 0.5, -22)
    ToggleButton.BackgroundColor3 = COLORS.ACCENT
    ToggleButton.Text = "≡"
    ToggleButton.TextColor3 = COLORS.TEXT
    ToggleButton.TextSize = 26
    ToggleButton.Font = Enum.Font.GothamBold
    local ToggleCorner = Instance.new("UICorner", ToggleButton)
    ToggleCorner.CornerRadius = UDim.new(0, 10)

    local dragging = false
    local dragStart, startPos

    local function updateDrag(input)
        if dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateDrag(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    ToggleButton.MouseButton1Click:Connect(function()
        local uiVisible = MainFrame.Visible
        MainFrame.Visible = not uiVisible
        TweenService:Create(ToggleButton, TWEEN_INFO, {Rotation = (not uiVisible) and 0 or 90}):Play()
    end)

    ----------------------------------------------------------------
    -- Fade-In Animation for the Window
    ----------------------------------------------------------------
    local function fadeIn()
        for _, obj in ipairs(MainFrame:GetDescendants()) do
            if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("TextLabel") then
                if obj.BackgroundTransparency < 1 then
                    obj.BackgroundTransparency = 1
                    TweenService:Create(obj, TWEEN_INFO, {BackgroundTransparency = 0}):Play()
                end
                if obj:IsA("TextButton") or obj:IsA("TextLabel") then
                    obj.TextTransparency = 1
                    TweenService:Create(obj, TWEEN_INFO, {TextTransparency = 0}):Play()
                end
            end
        end
    end
    fadeIn()

    return window
end

----------------------------------------------------------------
-- Notification Functionality
-- Usage: PandaAuth:Notify("Title", "Description", durationInSeconds)
----------------------------------------------------------------
function PandaAuth:Notify(title, description, duration)
    duration = duration or 5
    local notifyScreen = game:GetService("CoreGui"):FindFirstChild("PandaAuthNotifyUI")
    if not notifyScreen then
        notifyScreen = Instance.new("ScreenGui")
        notifyScreen.Name = "PandaAuthNotifyUI"
        notifyScreen.Parent = game:GetService("CoreGui")
    end

    local notifyFrame = Instance.new("Frame", notifyScreen)
    notifyFrame.Size = UDim2.new(0, 300, 0, 80)
    notifyFrame.BackgroundColor3 = COLORS.SECONDARY
    notifyFrame.AnchorPoint = Vector2.new(0, 1)
    notifyFrame.Position = UDim2.new(1, 320, 1, -100)
    
    local notifyCorner = Instance.new("UICorner", notifyFrame)
    notifyCorner.CornerRadius = UDim.new(0, 8)

    local titleLabel = Instance.new("TextLabel", notifyFrame)
    titleLabel.Size = UDim2.new(1, -20, 0, 30)
    titleLabel.Position = UDim2.new(0, 10, 0, 10)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = COLORS.TEXT
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 18

    local descLabel = Instance.new("TextLabel", notifyFrame)
    descLabel.Size = UDim2.new(1, -20, 0, 30)
    descLabel.Position = UDim2.new(0, 10, 0, 40)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = description
    descLabel.TextColor3 = COLORS.TEXT
    descLabel.Font = Enum.Font.Gotham
    descLabel.TextSize = 14

    local slideIn = TweenService:Create(notifyFrame, TWEEN_INFO, {Position = UDim2.new(1, -320, 1, -100)})
    slideIn:Play()

    delay(duration, function()
        local slideOut = TweenService:Create(notifyFrame, TWEEN_INFO, {Position = UDim2.new(1, 320, 1, -100)})
        slideOut:Play()
        slideOut.Completed:Connect(function()
            notifyFrame:Destroy()
        end)
    end)
end

return PandaAuth
