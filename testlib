        -- Tab Selection
        local function SelectTab()
            -- Reset all tabs
            for _, tab in pairs(TabList:GetChildren()) do
                if tab:IsA("TextButton") then
                    tab.BackgroundTransparency = 1
                    local label = tab:FindFirstChildOfClass("TextLabel")
                    if label then
                        label.TextColor3 = Theme.TextSecondary
                    end
                end
            end
            -- Hide all pages
            for _, page in pairs(PageContainer:GetChildren()) do
                if page:IsA("ScrollingFrame") then
                    page.Visible = false
                end
            end
            
            -- Select this tab
            TabBtn.BackgroundTransparency = 0
            TabBtn.BackgroundColor3 = Theme.Surface
            TabLabel.TextColor3 = Theme.TextPrimary
            Page.Visible = true
            PageTitle.Text = TabName
        end
        
        TabBtn.MouseButton1Click:Connect(SelectTab)
        
        -- Hover effects
        TabBtn.MouseEnter:Connect(function()
            if not Page.Visible then
                TweenService:Create(TabBtn, TweenPresets.Fast, {BackgroundTransparency = 0.5}):Play()
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if not Page.Visible then
                TweenService:Create(TabBtn, TweenPresets.Fast, {BackgroundTransparency = 1}):Play()
            end
        end)
        
        -- Select first tab
        if FirstTab then
            FirstTab = false
            SelectTab()
        end
        
