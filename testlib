        -- ELEMENT: DROPDOWN
        -- ═══════════════════════════════════════════════════
        function Tab:CreateDropdown(options)
            options = options or {}
            local DropdownName = options.Name or "Dropdown"
            local Options = options.Options or {}
            local Default = options.Default
            local Callback = options.Callback or function() end
            
            local Selected = Default
            local isOpen = false
            
            local DropFrame = Instance.new("Frame")
            DropFrame.Name = "Dropdown"
            DropFrame.Parent = Page
            DropFrame.BackgroundColor3 = Theme.Surface
            DropFrame.ClipsDescendants = true
            DropFrame.Size = UDim2.new(1, 0, 0, 38)
            
            local DropCorner = Instance.new("UICorner")
            DropCorner.CornerRadius = Theme.CornerRadius
            DropCorner.Parent = DropFrame
            
            local DropStroke = Instance.new("UIStroke")
            DropStroke.Parent = DropFrame
            DropStroke.Thickness = 1
            DropStroke.Color = Theme.Border
            DropStroke.Transparency = 0.5
            
            local DropBtn = Instance.new("TextButton")
            DropBtn.Parent = DropFrame
            DropBtn.BackgroundTransparency = 1
            DropBtn.Size = UDim2.new(1, 0, 0, 38)
            DropBtn.Text = ""
            
            local DropTitle = Instance.new("TextLabel")
            DropTitle.Parent = DropFrame
            DropTitle.BackgroundTransparency = 1
            DropTitle.Position = UDim2.new(0, 14, 0, 0)
            DropTitle.Size = UDim2.new(1, -45, 0, 38)
            DropTitle.Font = Enum.Font.GothamMedium
            DropTitle.Text = Default and (DropdownName .. ": " .. tostring(Default)) or DropdownName
            DropTitle.TextColor3 = Theme.TextPrimary
            DropTitle.TextSize = 13
            DropTitle.TextXAlignment = Enum.TextXAlignment.Left
            
            local DropIcon = Instance.new("TextLabel")
            DropIcon.Parent = DropFrame
            DropIcon.BackgroundTransparency = 1
            DropIcon.Position = UDim2.new(1, -32, 0, 0)
            DropIcon.Size = UDim2.new(0, 20, 0, 38)
            DropIcon.Font = Enum.Font.GothamBold
            DropIcon.Text = "▼"
            DropIcon.TextColor3 = Theme.TextMuted
            DropIcon.TextSize = 10
            
            local ItemContainer = Instance.new("ScrollingFrame")
            ItemContainer.Parent = DropFrame
            ItemContainer.Active = true
            ItemContainer.BackgroundColor3 = Theme.BackgroundSecondary
            ItemContainer.BorderSizePixel = 0
            ItemContainer.Position = UDim2.new(0, 0, 0, 40)
            ItemContainer.Size = UDim2.new(1, 0, 0, 0)
            ItemContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
            ItemContainer.ScrollBarThickness = 2
            ItemContainer.ScrollBarImageColor3 = Theme.Primary
            ItemContainer.Visible = false
            
            local ItemList = Instance.new("UIListLayout")
            ItemList.Parent = ItemContainer
            ItemList.SortOrder = Enum.SortOrder.LayoutOrder
            ItemList.Padding = UDim.new(0, 2)
            
            local ItemPadding = Instance.new("UIPadding")
            ItemPadding.Parent = ItemContainer
            ItemPadding.PaddingTop = UDim.new(0, 4)
            ItemPadding.PaddingBottom = UDim.new(0, 4)
            ItemPadding.PaddingLeft = UDim.new(0, 4)
            ItemPadding.PaddingRight = UDim.new(0, 4)
            
            local function RefreshOptions()
                for _, child in pairs(ItemContainer:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                
                for i, opt in ipairs(Options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Parent = ItemContainer
                    OptBtn.BackgroundColor3 = Theme.Surface
                    OptBtn.Size = UDim2.new(1, 0, 0, 30)
                    OptBtn.Font = Enum.Font.Gotham
                    OptBtn.Text = tostring(opt)
                    OptBtn.TextColor3 = Theme.TextSecondary
                    OptBtn.TextSize = 12
                    OptBtn.AutoButtonColor = false
                    OptBtn.ClipsDescendants = true
                    
                    local OptCorner = Instance.new("UICorner")
                    OptCorner.CornerRadius = Theme.CornerRadiusSmall
                    OptCorner.Parent = OptBtn
                    
                    -- Hover effect
                    OptBtn.MouseEnter:Connect(function()
                        TweenService:Create(OptBtn, TweenPresets.Fast, {
                            BackgroundColor3 = Theme.SurfaceHover,
                            TextColor3 = Theme.TextPrimary
                        }):Play()
                    end)
                    OptBtn.MouseLeave:Connect(function()
                        TweenService:Create(OptBtn, TweenPresets.Fast, {
                            BackgroundColor3 = Theme.Surface,
                            TextColor3 = Theme.TextSecondary
                        }):Play()
                    end)
                    
                    OptBtn.MouseButton1Click:Connect(function(input)
                        Selected = opt
                        DropTitle.Text = DropdownName .. ": " .. tostring(opt)
                        isOpen = false
                        
                        if input and input.Position then
                            CreateRipple(OptBtn, input.Position)
                        end
                        
                        TweenService:Create(DropFrame, TweenPresets.Normal, {Size = UDim2.new(1, 0, 0, 38)}):Play()
                        TweenService:Create(DropIcon, TweenPresets.Normal, {Rotation = 0}):Play()
                        ItemContainer.Visible = false
                        
                        task.defer(function()
                            Tab:RefreshCanvas()
                        end)
                        
                        pcall(Callback, opt)
                    end)
                end
                
                ItemContainer.CanvasSize = UDim2.new(0, 0, 0, ItemList.AbsoluteContentSize.Y + 8)
            end
            
            RefreshOptions()
            
            DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                
                if isOpen then
                    local itemCount = math.min(#Options, 4)
                    local containerHeight = itemCount * 32 + 10
                    local targetHeight = 38 + containerHeight
                    
                    ItemContainer.Visible = true
                    ItemContainer.Size = UDim2.new(1, 0, 0, containerHeight)
                    
                    TweenService:Create(DropFrame, TweenPresets.Normal, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
                    TweenService:Create(DropIcon, TweenPresets.Normal, {Rotation = 180}):Play()
                else
                    TweenService:Create(DropFrame, TweenPresets.Normal, {Size = UDim2.new(1, 0, 0, 38)}):Play()
                    TweenService:Create(DropIcon, TweenPresets.Normal, {Rotation = 0}):Play()
                    
                    task.delay(0.25, function()
                        if not isOpen then
                            ItemContainer.Visible = false
                        end
                    end)
                end
                
                task.defer(function()
                    Tab:RefreshCanvas()
                end)
            end)
            
            -- Hover effect on main button
            DropBtn.MouseEnter:Connect(function()
                TweenService:Create(DropFrame, TweenPresets.Fast, {BackgroundColor3 = Theme.SurfaceHover}):Play()
            end)
            DropBtn.MouseLeave:Connect(function()
                if not isOpen then
                    TweenService:Create(DropFrame, TweenPresets.Fast, {BackgroundColor3 = Theme.Surface}):Play()
                end
            end)
            
            Tab:RefreshCanvas()
            
            local DropObj = {}
            function DropObj:Refresh(newOptions, keepCurrent)
                Options = newOptions or {}
                RefreshOptions()
                if not keepCurrent then
                    Selected = nil
                    DropTitle.Text = DropdownName
                end
            end
            function DropObj:Set(value)
                Selected = value
                DropTitle.Text = DropdownName .. ": " .. tostring(value)
                pcall(Callback, value)
            end
            function DropObj:Get()
                return Selected
            end
            return DropObj
        end
        
