            local Label = Instance.new("TextLabel")
            Label.Parent = ToggleBtn
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Size = UDim2.new(0.6, 0, 1, 0)
            Label.Font = Enum.Font.GothamSemibold
            Label.Text = text
            Label.TextColor3 = Theme.Text
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local ColorPreview = Instance.new("Frame")
            ColorPreview.Parent = ToggleBtn
            ColorPreview.BackgroundColor3 = Color
            ColorPreview.Position = UDim2.new(1, -50, 0.5, -10)
            ColorPreview.Size = UDim2.new(0, 40, 0, 20)
            Instance.new("UICorner", ColorPreview).CornerRadius = UDim.new(0, 4)
            AddStroke(ColorPreview, Theme.ElementStroke, 1)

            local Sliders = Instance.new("Frame")
            Sliders.Parent = PickerFrame
            Sliders.BackgroundTransparency = 1
            Sliders.Position = UDim2.new(0, 0, 0, 34)
            Sliders.Size = UDim2.new(1, 0, 0, 90)

            local function CreateRGBSlider(colorType, yPos)
                local Sld = Instance.new("Frame")
                Sld.Parent = Sliders
                Sld.BackgroundColor3 = Theme.Background
                Sld.Position = UDim2.new(0, 10, 0, yPos)
                Sld.Size = UDim2.new(1, -20, 0, 20)
                Instance.new("UICorner", Sld).CornerRadius = UDim.new(0, 4)

                local Fill = Instance.new("Frame")
                Fill.Parent = Sld
                Fill.Size = UDim2.new(1, 0, 1, 0) -- Initial full
                Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 4)
                
                if colorType == "R" then Fill.BackgroundColor3 = Color3.fromRGB(255, 50, 50) end
                if colorType == "G" then Fill.BackgroundColor3 = Color3.fromRGB(50, 255, 50) end
                if colorType == "B" then Fill.BackgroundColor3 = Color3.fromRGB(50, 50, 255) end

                local Button = Instance.new("TextButton")
                Button.Parent = Sld
                Button.BackgroundTransparency = 1
                Button.Size = UDim2.new(1, 0, 1, 0)
                Button.Text = ""

                local dragging = false
                local function Update(input)
                    local x = math.clamp((input.Position.X - Sld.AbsolutePosition.X) / Sld.AbsoluteSize.X, 0, 1)
                    Fill.Size = UDim2.new(x, 0, 1, 0)
                    
                    local r = (colorType == "R") and x or (Sliders:FindFirstChild("R_Sld").Frame.Size.X.Scale)
                    local g = (colorType == "G") and x or (Sliders:FindFirstChild("G_Sld").Frame.Size.X.Scale)
                    local b = (colorType == "B") and x or (Sliders:FindFirstChild("B_Sld").Frame.Size.X.Scale)
                    
                    Color = Color3.new(r, g, b)
                    ColorPreview.BackgroundColor3 = Color
                    callback(Color)
                end

                Button.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        Update(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        Update(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
                end)

                Sld.Name = colorType.."_Sld"
            end

            CreateRGBSlider("R", 5)
            CreateRGBSlider("G", 35)
            CreateRGBSlider("B", 65)

            ToggleBtn.MouseButton1Click:Connect(function()
                isOpened = not isOpened
                if isOpened then
                    Tween(PickerFrame, 0.2, {Size = UDim2.new(1, 0, 0, 130)})
                else
                    Tween(PickerFrame, 0.2, {Size = UDim2.new(1, 0, 0, 34)})
                end
            end)
        end

        function TabObj:Dropdown(text, info, options, callback)
            local isDropped = false
            local DropFrame = Instance.new("Frame")
            DropFrame.Parent = Page
            DropFrame.BackgroundColor3 = Theme.Element
            DropFrame.Size = UDim2.new(1, 0, 0, 34)
            DropFrame.ClipsDescendants = true
            Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 6)
            AddStroke(DropFrame)
            
            local DropBtn = Instance.new("TextButton")
            DropBtn.Parent = DropFrame
            DropBtn.BackgroundTransparency = 1
            DropBtn.Size = UDim2.new(1, 0, 0, 34)
            DropBtn.Font = Enum.Font.GothamSemibold
            DropBtn.Text = "  " .. text
            DropBtn.TextColor3 = Theme.Text
            DropBtn.TextSize = 14
            DropBtn.TextXAlignment = Enum.TextXAlignment.Left

            local Arrow = Instance.new("ImageLabel")
            Arrow.Parent = DropBtn
            Arrow.BackgroundTransparency = 1
            Arrow.Position = UDim2.new(1, -25, 0.5, -8)
            Arrow.Size = UDim2.new(0, 16, 0, 16)
            Arrow.Image = "rbxassetid://6034818372"
            Arrow.ImageColor3 = Theme.TextDark

            AddTooltip(DropFrame, info)
            
            local OptionContainer = Instance.new("Frame")
            OptionContainer.Parent = DropFrame
            OptionContainer.BackgroundTransparency = 1
            OptionContainer.Position = UDim2.new(0, 0, 0, 34)
            OptionContainer.Size = UDim2.new(1, 0, 0, 0)
            
            local OptionList = Instance.new("UIListLayout")
            OptionList.Parent = OptionContainer
            OptionList.SortOrder = Enum.SortOrder.LayoutOrder
            
            local function Refresh()
                for _, v in pairs(OptionContainer:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
                for _, opt in pairs(options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Parent = OptionContainer
                    OptBtn.BackgroundColor3 = Color3.fromRGB(28,28,28)
                    OptBtn.Size = UDim2.new(1, 0, 0, 30)
                    OptBtn.Font = Enum.Font.Gotham
                    OptBtn.Text = opt
                    OptBtn.TextColor3 = Theme.TextDark
                    OptBtn.TextSize = 13
                    
                    OptBtn.MouseButton1Click:Connect(function()
                        DropBtn.Text = "  " .. text .. ": " .. opt
                        isDropped = false
                        Tween(DropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 34)})
                        Tween(Arrow, 0.2, {Rotation = 0})
                        callback(opt)
                    end)
                end
            end
            Refresh()
            
            DropBtn.MouseButton1Click:Connect(function()
                isDropped = not isDropped
                if isDropped then
                    local count = #options
                    Tween(DropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 34 + (count * 30))})
                    Tween(Arrow, 0.2, {Rotation = 180})
                else
                    Tween(DropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 34)})
                    Tween(Arrow, 0.2, {Rotation = 0})
                end
            end)
        end

        return TabObj
    end

    return WindowTable
end

return Library
