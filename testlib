-- PandaAuth Library
local PandaAuth = {}
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- Colors
local COLORS = {
    BACKGROUND = Color3.fromRGB(25, 25, 35),
    ACCENT = Color3.fromRGB(114, 137, 218),
    SECONDARY = Color3.fromRGB(35, 35, 45),
    TEXT = Color3.fromRGB(255, 255, 255),
    SUCCESS = Color3.fromRGB(67, 181, 129),
    ERROR = Color3.fromRGB(240, 71, 71),
    HOVER = Color3.fromRGB(45, 45, 55)
}

-- Animation settings
local TWEEN_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Utility function for hover effects
local function createHoverEffect(button)
    local originalColor = button.BackgroundColor3
    
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = COLORS.HOVER}):Play()
    end)
    
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = originalColor}):Play()
    end)
end

function PandaAuth:CreateWindow(title)
    local window = {}
    
    -- Create ScreenGui with proper protection
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "PandaAuthUI"
    
    -- Handle different exploit environments
    local success, result = pcall(function()
        if syn then
            syn.protect_gui(ScreenGui)
            ScreenGui.Parent = game:GetService("CoreGui")
        elseif protect_gui then
            protect_gui(ScreenGui)
            ScreenGui.Parent = game:GetService("CoreGui")
        elseif gethui then
            ScreenGui.Parent = gethui()
        else
            ScreenGui.Parent = game:GetService("CoreGui")
        end
    end)
    
    if not success then
        ScreenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end
    
    local MainFrame = Instance.new("Frame")
    local UICorner = Instance.new("UICorner")
    local TabsFrame = Instance.new("Frame")
    local TopBar = Instance.new("Frame")
    local ContentFrame = Instance.new("Frame")
    local Shadow = Instance.new("ImageLabel")
    
    -- Configure MainFrame
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 400, 0, 350)
    MainFrame.Position = UDim2.new(0.5, -200, 0.5, -175)
    MainFrame.BackgroundColor3 = COLORS.BACKGROUND
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui
    
    -- Add shadow
    Shadow.Name = "Shadow"
    Shadow.BackgroundTransparency = 1
    Shadow.Position = UDim2.new(0, -15, 0, -15)
    Shadow.Size = UDim2.new(1, 30, 1, 30)
    Shadow.Image = "rbxassetid://5028857084"
    Shadow.ImageColor3 = COLORS.BACKGROUND
    Shadow.ImageTransparency = 0.6
    Shadow.Parent = MainFrame
    
    UICorner.CornerRadius = UDim.new(0, 8)
    UICorner.Parent = MainFrame
    
    -- Configure Tabs Frame
    TabsFrame.Name = "TabsFrame"
    TabsFrame.Size = UDim2.new(0, 80, 1, 0)
    TabsFrame.BackgroundColor3 = COLORS.SECONDARY
    TabsFrame.Parent = MainFrame
    
    local TabsListLayout = Instance.new("UIListLayout")
    TabsListLayout.Parent = TabsFrame
    TabsListLayout.Padding = UDim.new(0, 5)
    TabsListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    
    -- Configure Content Frame
    ContentFrame.Name = "ContentFrame"
    ContentFrame.Size = UDim2.new(1, -80, 1, 0)
    ContentFrame.Position = UDim2.new(0, 80, 0, 0)
    ContentFrame.BackgroundTransparency = 1
    ContentFrame.Parent = MainFrame
    
    -- Configure TopBar
    TopBar.Name = "TopBar"
    TopBar.Size = UDim2.new(1, 0, 0, 30)
    TopBar.BackgroundColor3 = COLORS.ACCENT
    TopBar.Parent = ContentFrame
    
    local TopBarCorner = Instance.new("UICorner")
    TopBarCorner.CornerRadius = UDim.new(0, 8)
    TopBarCorner.Parent = TopBar
    
    -- Configure Title
    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Size = UDim2.new(1, 0, 1, 0)
    Title.BackgroundTransparency = 1
    Title.Text = title
    Title.TextColor3 = COLORS.TEXT
    Title.TextSize = 18
    Title.Font = Enum.Font.GothamBold
    Title.Parent = TopBar
    
    -- Tabs management
    local tabs = {}
    local currentTab = nil
    
    function window:CreateTab(tabName)
        local tab = {}
        local TabButton = Instance.new("TextButton")
        local TabContent = Instance.new("ScrollingFrame")
        local UIListLayout = Instance.new("UIListLayout")
        
        -- Create Tab Button
        TabButton.Name = tabName
        TabButton.Size = UDim2.new(0.8, 0, 0, 35)
        TabButton.BackgroundColor3 = COLORS.BACKGROUND
        TabButton.Text = tabName
        TabButton.TextColor3 = COLORS.TEXT
        TabButton.TextSize = 14
        TabButton.Font = Enum.Font.GothamSemibold
        TabButton.Parent = TabsFrame
        
        local TabCorner = Instance.new("UICorner")
        TabCorner.CornerRadius = UDim.new(0, 6)
        TabCorner.Parent = TabButton
        
        -- Create Tab Content
        TabContent.Name = tabName
        TabContent.Size = UDim2.new(1, 0, 1, -35)
        TabContent.Position = UDim2.new(0, 0, 0, 35)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 2
        TabContent.ScrollBarImageColor3 = COLORS.ACCENT
        TabContent.Visible = false
        TabContent.Parent = ContentFrame
        
        UIListLayout.Parent = TabContent
        UIListLayout.Padding = UDim.new(0, 8)
        UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        
        -- Tab activation logic
        local function activateTab()
            if currentTab then
                currentTab.TabContent.Visible = false
                TweenService:Create(currentTab.TabButton, TWEEN_INFO, {BackgroundColor3 = COLORS.BACKGROUND}):Play()
            end
            currentTab = tab
            TabContent.Visible = true
            TweenService:Create(TabButton, TWEEN_INFO, {BackgroundColor3 = COLORS.ACCENT}):Play()
        end
        
        TabButton.MouseButton1Click:Connect(activateTab)
        createHoverEffect(TabButton)
        
        -- Initialize first tab
        if #tabs == 0 then
            activateTab()
        end
        
        -- Section creation
        function tab:CreateSection(name)
            local SectionFrame = Instance.new("Frame")
            local SectionLabel = Instance.new("TextLabel")
            local SectionContent = Instance.new("Frame")
            local UIListLayout = Instance.new("UIListLayout")
            
            SectionFrame.Name = "Section_" .. name
            SectionFrame.Size = UDim2.new(0.9, 0, 0, 30)
            SectionFrame.BackgroundColor3 = COLORS.SECONDARY
            SectionFrame.BackgroundTransparency = 0.5
            SectionFrame.Parent = TabContent
            
            local SectionCorner = Instance.new("UICorner")
            SectionCorner.CornerRadius = UDim.new(0, 6)
            SectionCorner.Parent = SectionFrame
            
            SectionLabel.Name = "SectionLabel"
            SectionLabel.Size = UDim2.new(1, 0, 0, 30)
            SectionLabel.BackgroundTransparency = 1
            SectionLabel.Text = name
            SectionLabel.TextColor3 = COLORS.TEXT
            SectionLabel.TextSize = 14
            SectionLabel.Font = Enum.Font.GothamBold
            SectionLabel.Parent = SectionFrame
            
            SectionContent.Name = "SectionContent"
            SectionContent.Size = UDim2.new(1, 0, 0, 0)
            SectionContent.BackgroundTransparency = 1
            SectionContent.Position = UDim2.new(0, 0, 0, 30)
            SectionContent.Parent = SectionFrame
            
            UIListLayout.Parent = SectionContent
            UIListLayout.Padding = UDim.new(0, 5)
            UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            
            UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                SectionFrame.Size = UDim2.new(0.9, 0, 0, UIListLayout.AbsoluteContentSize.Y + 35)
                SectionContent.Size = UDim2.new(1, 0, 0, UIListLayout.AbsoluteContentSize.Y)
            end)
            
            local section = {}
            
            -- Element creation functions
            local function createButton(parent, text, callback)
                local Button = Instance.new("TextButton")
                local UICorner = Instance.new("UICorner")
                
                Button.Name = "Button"
                Button.Size = UDim2.new(0.9, 0, 0, 35)
                Button.BackgroundColor3 = COLORS.SECONDARY
                Button.Text = text
                Button.TextColor3 = COLORS.TEXT
                Button.TextSize = 14
                Button.Font = Enum.Font.GothamSemibold
                Button.Parent = parent
                
                UICorner.CornerRadius = UDim.new(0, 6)
                UICorner.Parent = Button
                
                createHoverEffect(Button)
                
                Button.MouseButton1Click:Connect(function()
                    callback()
                end)
                
                return Button
            end
            
            local function createToggle(parent, text, default, callback)
                local ToggleFrame = Instance.new("Frame")
                local UICorner = Instance.new("UICorner")
                local Title = Instance.new("TextLabel")
                local ToggleButton = Instance.new("TextButton")
                local ToggleInner = Instance.new("Frame")
                local UICorner_2 = Instance.new("UICorner")
                
                ToggleFrame.Name = "ToggleFrame"
                ToggleFrame.Size = UDim2.new(0.9, 0, 0, 35)
                ToggleFrame.BackgroundColor3 = COLORS.SECONDARY
                ToggleFrame.Parent = parent
                
                UICorner.CornerRadius = UDim.new(0, 6)
                UICorner.Parent = ToggleFrame
                
                Title.Name = "Title"
                Title.Size = UDim2.new(0.7, 0, 1, 0)
                Title.Position = UDim2.new(0.05, 0, 0, 0)
                Title.BackgroundTransparency = 1
                Title.Text = text
                Title.TextColor3 = COLORS.TEXT
                Title.TextSize = 14
                Title.Font = Enum.Font.GothamSemibold
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.Parent = ToggleFrame
                
                ToggleButton.Name = "ToggleButton"
                ToggleButton.Position = UDim2.new(0.8, 0, 0.2, 0)
                ToggleButton.Size = UDim2.new(0.15, 0, 0.6, 0)
                ToggleButton.BackgroundColor3 = default and COLORS.SUCCESS or COLORS.ERROR
                ToggleButton.Text = ""
                ToggleButton.AutoButtonColor = false
                ToggleButton.Parent = ToggleFrame
                
                UICorner_2.CornerRadius = UDim.new(1, 0)
                UICorner_2.Parent = ToggleButton
                
                ToggleInner.Name = "ToggleInner"
                ToggleInner.Size = UDim2.new(0.4, 0, 0.8, 0)
                ToggleInner.Position = default and UDim2.new(0.55, 0, 0.1, 0) or UDim2.new(0.05, 0, 0.1, 0)
                ToggleInner.BackgroundColor3 = COLORS.TEXT
                ToggleInner.Parent = ToggleButton
                
                local ToggleInnerCorner = Instance.new("UICorner")
                ToggleInnerCorner.CornerRadius = UDim.new(1, 0)
                ToggleInnerCorner.Parent = ToggleInner
                
                local toggled = default
                ToggleButton.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    local targetColor = toggled and COLORS.SUCCESS or COLORS.ERROR
                    local targetPosition = toggled and UDim2.new(0.55, 0, 0.1, 0) or UDim2.new(0.05, 0, 0.1, 0)
                    
                    TweenService:Create(ToggleButton, TWEEN_INFO, {BackgroundColor3 = targetColor}):Play()
                    TweenService:Create(ToggleInner, TWEEN_INFO, {Position = targetPosition}):Play()
                    
                    callback(toggled)
                end)
                
                createHoverEffect(ToggleFrame)
                return ToggleFrame
            end
            
            local function createDropdown(parent, text, options, callback)
                local DropdownFrame = Instance.new("Frame")
                local UICorner = Instance.new("UICorner")
                local Title = Instance.new("TextLabel")
                local DropdownButton = Instance.new("TextButton")
                local UICorner_2 = Instance.new("UICorner")
                local OptionsFrame = Instance.new("Frame")
                local UICorner_3 = Instance.new("UICorner")
                local UIListLayout = Instance.new("UIListLayout")
                
                DropdownFrame.Name = "DropdownFrame"
                DropdownFrame.Size = UDim2.new(0.9, 0, 0, 35)
                DropdownFrame.BackgroundColor3 = COLORS.SECONDARY
                DropdownFrame.Parent = parent
                
                UICorner.CornerRadius = UDim.new(0, 6)
                UICorner.Parent = DropdownFrame
                
                Title.Name = "Title"
                Title.Size = UDim2.new(0.7, 0, 1, 0)
                Title.Position = UDim2.new(0.05, 0, 0, 0)
                Title.BackgroundTransparency = 1
                Title.Text = text
                Title.TextColor3 = COLORS.TEXT
                Title.TextSize = 14
                Title.Font = Enum.Font.GothamSemibold
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.Parent = DropdownFrame
                
                DropdownButton.Name = "DropdownButton"
                DropdownButton.Position = UDim2.new(0.8, 0, 0.2, 0)
                DropdownButton.Size = UDim2.new(0.15, 0, 0.6, 0)
                DropdownButton.BackgroundColor3 = COLORS.ACCENT
                DropdownButton.Text = "▼"
                DropdownButton.TextColor3 = COLORS.TEXT
                DropdownButton.TextSize = 14
                DropdownButton.Font = Enum.Font.GothamBold
                DropdownButton.Parent = DropdownFrame
                
                UICorner_2.CornerRadius = UDim.new(0, 4)
                UICorner_2.Parent = DropdownButton
                
                OptionsFrame.Name = "OptionsFrame"
                OptionsFrame.Size = UDim2.new(1, 0, 0, 0)
                OptionsFrame.Position = UDim2.new(0, 0, 1, 5)
                OptionsFrame.BackgroundColor3 = COLORS.SECONDARY
                OptionsFrame.ClipsDescendants = true
                OptionsFrame.Visible = false
                OptionsFrame.ZIndex = 2
                OptionsFrame.Parent = DropdownFrame
                
                UICorner_3.CornerRadius = UDim.new(0, 6)
                UICorner_3.Parent = OptionsFrame
                
                UIListLayout.Parent = OptionsFrame
                UIListLayout.Padding = UDim.new(0, 2)
                UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                
                local open = false
                DropdownButton.MouseButton1Click:Connect(function()
                    open = not open
                    local targetRotation = open and 180 or 0
                    TweenService:Create(DropdownButton, TWEEN_INFO, {Rotation = targetRotation}):Play()
                    
                    OptionsFrame.Visible = true
                    if open then
                        TweenService:Create(OptionsFrame, TWEEN_INFO, {
                            Size = UDim2.new(1, 0, 0, #options * 30)
                        }):Play()
                    else
                        TweenService:Create(OptionsFrame, TWEEN_INFO, {
                            Size = UDim2.new(1, 0, 0, 0)
                        }):Play()
                        task.wait(0.3)
                        OptionsFrame.Visible = false
                    end
                end)
                
                for _, option in ipairs(options) do
                    local OptionButton = Instance.new("TextButton")
                    local OptionUICorner = Instance.new("UICorner")
                    
                    OptionButton.Name = "OptionButton"
                    OptionButton.Size = UDim2.new(0.9, 0, 0, 25)
                    OptionButton.BackgroundColor3 = COLORS.BACKGROUND
                    OptionButton.BackgroundTransparency = 0.5
                    OptionButton.Text = option
                    OptionButton.TextColor3 = COLORS.TEXT
                    OptionButton.TextSize = 14
                    OptionButton.Font = Enum.Font.Gotham
                    OptionButton.ZIndex = 2
                    OptionButton.Parent = OptionsFrame
                    
                    OptionUICorner.CornerRadius = UDim.new(0, 4)
                    OptionUICorner.Parent = OptionButton
                    
                    createHoverEffect(OptionButton)
                    
                    OptionButton.MouseButton1Click:Connect(function()
                        callback(option)
                        Title.Text = text .. " - " .. option
                        open = false
                        TweenService:Create(DropdownButton, TWEEN_INFO, {Rotation = 0}):Play()
                        TweenService:Create(OptionsFrame, TWEEN_INFO, {
                            Size = UDim2.new(1, 0, 0, 0)
                        }):Play()
                        task.wait(0.3)
                        OptionsFrame.Visible = false
                    end)
                end
                
                createHoverEffect(DropdownFrame)
                return DropdownFrame
            end
            
            local function createLabel(parent, text)
                local LabelFrame = Instance.new("Frame")
                local UICorner = Instance.new("UICorner")
                local Label = Instance.new("TextLabel")
                local Accent = Instance.new("Frame")
                
                LabelFrame.Name = "LabelFrame"
                LabelFrame.Size = UDim2.new(0.9, 0, 0, 30)
                LabelFrame.BackgroundColor3 = COLORS.SECONDARY
                LabelFrame.Parent = parent
                
                UICorner.CornerRadius = UDim.new(0, 6)
                UICorner.Parent = LabelFrame
                
                Accent.Name = "Accent"
                Accent.Size = UDim2.new(0.02, 0, 0.8, 0)
                Accent.Position = UDim2.new(0.02, 0, 0.1, 0)
                Accent.BackgroundColor3 = COLORS.ACCENT
                Accent.Parent = LabelFrame
                
                local AccentUICorner = Instance.new("UICorner")
                AccentUICorner.CornerRadius = UDim.new(1, 0)
                AccentUICorner.Parent = Accent
                
                Label.Name = "Label"
                Label.Size = UDim2.new(0.9, 0, 1, 0)
                Label.Position = UDim2.new(0.08, 0, 0, 0)
                Label.BackgroundTransparency = 1
                Label.Text = text
                Label.TextColor3 = COLORS.TEXT
                Label.TextSize = 14
                Label.Font = Enum.Font.GothamSemibold
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = LabelFrame
                
                createHoverEffect(LabelFrame)
                
                local labelMethods = {}
                function labelMethods:SetText(newText)
                    Label.Text = newText
                end
                function labelMethods:GetText()
                    return Label.Text
                end
                
                return LabelFrame, labelMethods
            end
            
            local function createSlider(parent, text, min, max, default, callback)
                local SliderFrame = Instance.new("Frame")
                local UICorner = Instance.new("UICorner")
                local Title = Instance.new("TextLabel")
                local SliderBackground = Instance.new("Frame")
                local UICorner_2 = Instance.new("UICorner")
                local SliderFill = Instance.new("Frame")
                local UICorner_3 = Instance.new("UICorner")
                local SliderValue = Instance.new("TextLabel")
                local SliderButton = Instance.new("TextButton")
                
                SliderFrame.Name = "SliderFrame"
                SliderFrame.Size = UDim2.new(0.9, 0, 0, 45)
                SliderFrame.BackgroundColor3 = COLORS.SECONDARY
                SliderFrame.Parent = parent
                
                UICorner.CornerRadius = UDim.new(0, 6)
                UICorner.Parent = SliderFrame
                
                Title.Name = "Title"
                Title.Size = UDim2.new(0.9, 0, 0, 20)
                Title.Position = UDim2.new(0.05, 0, 0, 0)
                Title.BackgroundTransparency = 1
                Title.Text = text
                Title.TextColor3 = COLORS.TEXT
                Title.TextSize = 14
                Title.Font = Enum.Font.GothamSemibold
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.Parent = SliderFrame
                
                SliderBackground.Name = "SliderBackground"
                SliderBackground.Size = UDim2.new(0.9, 0, 0, 6)
                SliderBackground.Position = UDim2.new(0.05, 0, 0.65, 0)
                SliderBackground.BackgroundColor3 = COLORS.BACKGROUND
                SliderBackground.Parent = SliderFrame
                
                UICorner_2.CornerRadius = UDim.new(1, 0)
                UICorner_2.Parent = SliderBackground
                
                SliderFill.Name = "SliderFill"
                SliderFill.BackgroundColor3 = COLORS.ACCENT
                SliderFill.Parent = SliderBackground
                
                UICorner_3.CornerRadius = UDim.new(1, 0)
                UICorner_3.Parent = SliderFill
                
                SliderValue.Name = "SliderValue"
                SliderValue.Size = UDim2.new(0.15, 0, 0, 20)
                SliderValue.Position = UDim2.new(0.825, 0, 0, 0)
                SliderValue.BackgroundTransparency = 1
                SliderValue.Text = tostring(default)
                SliderValue.TextColor3 = COLORS.TEXT
                SliderValue.TextSize = 14
                SliderValue.Font = Enum.Font.GothamSemibold
                SliderValue.Parent = SliderFrame
                
                SliderButton.Name = "SliderButton"
                SliderButton.Size = UDim2.new(1, 0, 1, 0)
                SliderButton.BackgroundTransparency = 1
                SliderButton.Text = ""
                SliderButton.Parent = SliderBackground
                
                local function updateSlider(input)
                    local pos = input.Position
                    local relativePos = (pos.X - SliderBackground.AbsolutePosition.X) / SliderBackground.AbsoluteSize.X
                    relativePos = math.clamp(relativePos, 0, 1)
                    local value = min + (max - min) * relativePos
                    value = math.floor(value + 0.5)
                    SliderValue.Text = tostring(value)
                    SliderFill.Size = UDim2.new(relativePos, 0, 1, 0)
                    callback(value)
                end
                
                local defaultRelative = (default - min) / (max - min)
                SliderFill.Size = UDim2.new(defaultRelative, 0, 1, 0)
                
                local sliding = false
                SliderButton.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or
                       input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        updateSlider(input)
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if sliding then
                        updateSlider(input)
                    end
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or
                       input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
                
                createHoverEffect(SliderFrame)
                return SliderFrame
            end

            -- Section methods
            function section:AddButton(text, callback)
                return createButton(SectionContent, text, callback)
            end
            
            function section:AddToggle(text, default, callback)
                return createToggle(SectionContent, text, default, callback)
            end
            
            function section:AddDropdown(text, options, callback)
                return createDropdown(SectionContent, text, options, callback)
            end
            
            function section:AddLabel(text)
                return createLabel(SectionContent, text)
            end
            
            function section:AddSlider(text, min, max, default, callback)
                return createSlider(SectionContent, text, min, max, default, callback)
            end
            
            return section
        end
        
        table.insert(tabs, {
            TabButton = TabButton,
            TabContent = TabContent
        })
        
        return tab
    end
    
    -- Mobile toggle button
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Name = "ToggleButton"
    ToggleButton.Size = UDim2.new(0, 40, 0, 40)
    ToggleButton.Position = UDim2.new(0, 10, 0.5, -20)
    ToggleButton.BackgroundColor3 = COLORS.ACCENT
    ToggleButton.Text = "≡"
    ToggleButton.TextColor3 = COLORS.TEXT
    ToggleButton.TextSize = 24
    ToggleButton.Font = Enum.Font.GothamBold
    ToggleButton.Parent = ScreenGui
    
    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(0, 8)
    ToggleCorner.Parent = ToggleButton
    
    -- Dragging functionality
    local dragging = false
    local dragStart
    local startPos
    
    local function updateDrag(input)
        if dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end
    
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or
           input.UserInputType == Enum.UserInputType.Touch then
            updateDrag(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    -- Toggle UI visibility
    local uiVisible = true
    ToggleButton.MouseButton1Click:Connect(function()
        uiVisible = not uiVisible
        MainFrame.Visible = uiVisible
        TweenService:Create(ToggleButton, TWEEN_INFO, {
            Rotation = uiVisible and 0 or 90
        }):Play()
    end)
    
    -- Fade-in animation
    local function fadeIn()
        for _, obj in ipairs(MainFrame:GetDescendants()) do
            if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("TextLabel") then
                if obj.BackgroundTransparency < 1 then
                    obj.BackgroundTransparency = 1
                    TweenService:Create(obj, TWEEN_INFO, {BackgroundTransparency = 0}):Play()
                end
                if obj:IsA("TextButton") or obj:IsA("TextLabel") then
                    obj.TextTransparency = 1
                    TweenService:Create(obj, TWEEN_INFO, {TextTransparency = 0}):Play()
                end
            end
        end
    end
    
    fadeIn()
    
    return window
end

return PandaAuth
