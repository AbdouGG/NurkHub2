            Parent = DropdownFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -30, 0, 12),
            Size = UDim2.new(0, 20, 0, 20),
            Image = "rbxassetid://6031091004", -- Chevron
            ImageColor3 = Theme.TextDark
        })

        local OptionContainer = Create("Frame", {
            Parent = DropdownFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 45),
            Size = UDim2.new(1, 0, 0, 0)
        })
        
        local OptionList = Create("UIListLayout", {
            Parent = OptionContainer,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4)
        })
        
        Create("UIPadding", {Parent = OptionContainer, PaddingBottom = UDim.new(0,8), PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8)})

        local function RefreshOptions()
            for _, v in pairs(OptionContainer:GetChildren()) do
                if v:IsA("TextButton") then v:Destroy() end
            end
            
            for _, opt in pairs(list) do
                local OptBtn = Create("TextButton", {
                    Parent = OptionContainer,
                    BackgroundColor3 = Theme.Main,
                    Size = UDim2.new(1, 0, 0, 32),
                    Text = opt,
                    Font = Enum.Font.GothamSemibold,
                    TextColor3 = Theme.TextDark,
                    TextSize = 13,
                    AutoButtonColor = false
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = OptBtn})
                
                OptBtn.MouseEnter:Connect(function()
                    TweenService:Create(OptBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover, TextColor3 = Theme.Text}):Play()
                end)
                OptBtn.MouseLeave:Connect(function()
                    TweenService:Create(OptBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Main, TextColor3 = Theme.TextDark}):Play()
                end)
                
                OptBtn.MouseButton1Click:Connect(function()
                    Title.Text = text .. ": <font color='#60a5fa'>" .. opt .. "</font>"
                    Title.RichText = true
                    callback(opt)
                    
                    DropdownOpen = false
                    TweenService:Create(DropdownFrame, TweenInfo.new(0.2), {Size = UDim2.new(0.92, 0, 0, BaseHeight)}):Play()
                    TweenService:Create(Icon, TweenInfo.new(0.2), {Rotation = 0}):Play()
                end)
            end
        end
        
        RefreshOptions()

        DropdownFrame.MouseButton1Click:Connect(function()
            DropdownOpen = not DropdownOpen
            local ListSize = OptionList.AbsoluteContentSize.Y
            
            if DropdownOpen then
                TweenService:Create(DropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.92, 0, 0, BaseHeight + ListSize + 16)}):Play()
                TweenService:Create(Icon, TweenInfo.new(0.2), {Rotation = 180}):Play()
            else
                TweenService:Create(DropdownFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.92, 0, 0, BaseHeight)}):Play()
                TweenService:Create(Icon, TweenInfo.new(0.2), {Rotation = 0}):Play()
            end
        end)
    end

    return Elements
end

return Library
