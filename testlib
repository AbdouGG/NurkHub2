-- PandaAuth Library - PRO Modern Theme with Enhanced Layout, Left Sidebar Navigation,
-- Modern Toggle Buttons, Scrollable Content, Paragraph Functionality, and All Functions
local PandaAuth = {}
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

----------------------------------------------------------------
-- Configuration for Grid Cells in Content Area
----------------------------------------------------------------
local cellWidth = 344   -- New grid cell width
local cellHeight = 180  -- Grid cell height

----------------------------------------------------------------
-- Theme Colors & Settings
----------------------------------------------------------------
local COLORS = {
    BACKGROUND     = Color3.fromRGB(15, 15, 15),    -- Very dark (almost black) background
    ACCENT         = Color3.fromRGB(0, 191, 255),     -- Cyan/blue accent for interactive elements
    SECONDARY      = Color3.fromRGB(20, 20, 20),      -- Slightly lighter than BACKGROUND for panels
    TEXT           = Color3.fromRGB(255, 255, 255),   -- White text
    SUCCESS        = Color3.fromRGB(80, 250, 123),    -- Vibrant green for success
    ERROR          = Color3.fromRGB(250, 80, 80),     -- Bold red for errors
    HOVER          = Color3.fromRGB(35, 35, 35),      -- A subtle lighter shade for hover effects
    TAB_SELECTED   = Color3.fromRGB(0, 191, 255),     -- Accent color for selected tabs
    TAB_UNSELECTED = Color3.fromRGB(20, 20, 20)        -- Matches SECONDARY for unselected tabs
}

local TWEEN_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

----------------------------------------------------------------
-- Utility: Hover Effect
----------------------------------------------------------------
local function createHoverEffect(button)
    local originalColor = button.BackgroundColor3
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = COLORS.HOVER}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = originalColor}):Play()
    end)
end

----------------------------------------------------------------
-- CreateWindow: Builds the main UI with a left sidebar for navigation tabs
----------------------------------------------------------------
function PandaAuth:CreateWindow(title)
    local window = {}

    -- Create ScreenGui with protection
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "PandaAuthUI"
    local success, result = pcall(function()
        if syn then
            syn.protect_gui(ScreenGui)
            ScreenGui.Parent = game:GetService("CoreGui")
        elseif protect_gui then
            protect_gui(ScreenGui)
            ScreenGui.Parent = game:GetService("CoreGui")
        elseif gethui then
            ScreenGui.Parent = gethui()
        else
            ScreenGui.Parent = game:GetService("CoreGui")
        end
    end)
    if not success then
        ScreenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end

    ----------------------------------------------------------------
    -- Detect Screen Size and Apply UIScale if necessary
    ----------------------------------------------------------------
    local camera = Workspace.CurrentCamera or game:GetService("Workspace").CurrentCamera
    local viewportSize = camera and camera.ViewportSize or Vector2.new(1920, 1080)
    local scale = 1
    if viewportSize.X < 1200 then
        scale = viewportSize.X / 1200
    end
    local uiScale = Instance.new("UIScale")
    uiScale.Scale = scale
    uiScale.Parent = ScreenGui

    -- Main window (850 x 500)
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 850, 0, 500)
    MainFrame.Position = UDim2.new(0.5, -425, 0.5, -250)
    MainFrame.BackgroundColor3 = COLORS.BACKGROUND
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner", MainFrame)
    UICorner.CornerRadius = UDim.new(0, 10)

    local UIStroke = Instance.new("UIStroke", MainFrame)
    UIStroke.Color = Color3.fromRGB(20, 20, 20)
    UIStroke.Thickness = 2
    UIStroke.Transparency = 0

    local Shadow = Instance.new("ImageLabel", MainFrame)
    Shadow.Name = "Shadow"
    Shadow.BackgroundTransparency = 1
    Shadow.Position = UDim2.new(0, -15, 0, -15)
    Shadow.Size = UDim2.new(1, 30, 1, 30)
    Shadow.Image = "rbxassetid://5028857084"
    Shadow.ImageColor3 = COLORS.BACKGROUND
    Shadow.ImageTransparency = 0.6

    -- Top Bar (full width)
    local TopBar = Instance.new("Frame", MainFrame)
    TopBar.Name = "TopBar"
    TopBar.Size = UDim2.new(1, 0, 0, 40)
    TopBar.BackgroundColor3 = COLORS.ACCENT
    local TopBarCorner = Instance.new("UICorner", TopBar)
    TopBarCorner.CornerRadius = UDim.new(0, 10)

    local TitleLabel = Instance.new("TextLabel", TopBar)
    TitleLabel.Name = "Title"
    TitleLabel.Size = UDim2.new(1, 0, 1, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = title or "PandaAuth"
    TitleLabel.TextColor3 = COLORS.TEXT
    TitleLabel.TextSize = 20
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Center

    -- Horizontal Separator below Top Bar
    local HorizontalSeparator = Instance.new("Frame", MainFrame)
    HorizontalSeparator.Name = "HorizontalSeparator"
    HorizontalSeparator.Size = UDim2.new(1, 0, 0, 1)
    HorizontalSeparator.Position = UDim2.new(0, 0, 0, 40)
    HorizontalSeparator.BackgroundColor3 = COLORS.ACCENT
    HorizontalSeparator.BackgroundTransparency = 0.3
    HorizontalSeparator.ZIndex = 9999

    -- Left Sidebar for Navigation Tabs
    local TabHolder = Instance.new("Frame", MainFrame)
    TabHolder.Name = "TabHolder"
    TabHolder.Size = UDim2.new(0, 150, 1, -40)
    TabHolder.Position = UDim2.new(0, 0, 0, 40)
    TabHolder.BackgroundColor3 = COLORS.SECONDARY
    local TabHolderCorner = Instance.new("UICorner", TabHolder)
    TabHolderCorner.CornerRadius = UDim.new(0, 10)

    local TabList = Instance.new("UIListLayout", TabHolder)
    TabList.FillDirection = Enum.FillDirection.Vertical
    TabList.HorizontalAlignment = Enum.HorizontalAlignment.Left
    TabList.SortOrder = Enum.SortOrder.LayoutOrder
    TabList.Padding = UDim.new(0, 6)
    TabList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabHolder.CanvasSize = UDim2.new(0, 0, 0, TabList.AbsoluteContentSize.Y)
    end)

    -- Vertical Separator between Sidebar and Content
    local Separator = Instance.new("Frame", MainFrame)
