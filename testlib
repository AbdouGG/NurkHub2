            local SectionContent = Instance.new("ScrollingFrame", SectionFrame)
            SectionContent.Name = "SectionContent"
            SectionContent.Position = UDim2.new(0, 0, 0, 35)
            SectionContent.Size = UDim2.new(1, 0, 1, -35)
            SectionContent.BackgroundTransparency = 1
            SectionContent.ScrollBarThickness = 4
            SectionContent.ScrollBarImageColor3 = COLORS.ACCENT
            SectionContent.VerticalScrollBarInset = Enum.ScrollBarInset.Always
            SectionContent.AutomaticCanvasSize = Enum.AutomaticSize.Y

            local UIListLayout_Section = Instance.new("UIListLayout", SectionContent)
            UIListLayout_Section.Padding = UDim.new(0, 6)
            UIListLayout_Section.HorizontalAlignment = Enum.HorizontalAlignment.Center
            UIListLayout_Section.SortOrder = Enum.SortOrder.LayoutOrder

            function section:AddButton(text, callback)
                local Button = Instance.new("TextButton", SectionContent)
                Button.Name = "Button"
                Button.Size = UDim2.new(0.92, 0, 0, 38)
                Button.BackgroundColor3 = COLORS.SECONDARY
