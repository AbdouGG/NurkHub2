            InfoText.TextWrapped = true
            
            local toggled = false
            InfoBtn.MouseButton1Click:Connect(function()
                toggled = not toggled
                
                -- We need to inject this frame below the element
                if toggled then
                    InfoFrame.Parent = parent.Parent
                    -- Find index of parent
                    local layoutOrder = parent.LayoutOrder + 1
                    InfoFrame.LayoutOrder = layoutOrder
                    InfoFrame.Visible = true
                    Tween(InfoFrame, 0.2, {Size = UDim2.new(1, 0, 0, 40)})
                    Tween(InfoBtn, 0.2, {ImageColor3 = Colors.Accent})
