                local UICorner_Dropdown = Instance.new("UICorner", DropdownFrame)
                UICorner_Dropdown.CornerRadius = UDim.new(0, 8)
                local Title = Instance.new("TextLabel", DropdownFrame)
                Title.Name = "Title"
                Title.Size = UDim2.new(0.65, 0, 1, 0)
                Title.Position = UDim2.new(0.05, 0, 0, 0)
                Title.BackgroundTransparency = 1
                Title.Text = text
                Title.TextColor3 = COLORS.TEXT
                Title.TextSize = 15
                Title.Font = Enum.Font.GothamSemibold
                Title.TextXAlignment = Enum.TextXAlignment.Left
                local DropdownButton = Instance.new("TextButton", DropdownFrame)
                DropdownButton.Name = "DropdownButton"
                DropdownButton.Size = UDim2.new(0.17, 0, 0.6, 0)
                DropdownButton.Position = UDim2.new(0.78, 0, 0.2, 0)
                DropdownButton.BackgroundColor3 = COLORS.ACCENT
                DropdownButton.Text = "▼"
                DropdownButton.TextColor3 = COLORS.TEXT
                DropdownButton.TextSize = 15
                DropdownButton.Font = Enum.Font.GothamBold
                local UICorner_2 = Instance.new("UICorner", DropdownButton)
                UICorner_2.CornerRadius = UDim.new(0, 6)
                local OptionsFrame = Instance.new("Frame", DropdownFrame)
                OptionsFrame.Name = "OptionsFrame"
                OptionsFrame.Size = UDim2.new(1, 0, 0, 0)
                OptionsFrame.Position = UDim2.new(0, 0, 1, 6)
                OptionsFrame.BackgroundColor3 = COLORS.SECONDARY
                OptionsFrame.ClipsDescendants = true
                OptionsFrame.Visible = false
                OptionsFrame.ZIndex = 2
                local UICorner_3 = Instance.new("UICorner", OptionsFrame)
                UICorner_3.CornerRadius = UDim.new(0, 8)
                local UIListLayout_Dropdown = Instance.new("UIListLayout", OptionsFrame)
                UIListLayout_Dropdown.Padding = UDim.new(0, 4)
                UIListLayout_Dropdown.HorizontalAlignment = Enum.HorizontalAlignment.Center
                local open = false
                DropdownButton.MouseButton1Click:Connect(function()
                    open = not open
                    local targetRotation = open and 180 or 0
                    TweenService:Create(DropdownButton, TWEEN_INFO, {Rotation = targetRotation}):Play()
                    OptionsFrame.Visible = true
                    if open then
                        TweenService:Create(OptionsFrame, TWEEN_INFO, {Size = UDim2.new(1, 0, 0, #options * 38)}):Play()
                    else
                        TweenService:Create(OptionsFrame, TWEEN_INFO, {Size = UDim2.new(1, 0, 0, 0)}):Play()
                        task.wait(0.3)
                        OptionsFrame.Visible = false
                    end
                end)
                for _, option in ipairs(options) do
                    local OptionButton = Instance.new("TextButton", OptionsFrame)
                    OptionButton.Name = "OptionButton"
                    OptionButton.Size = UDim2.new(0.92, 0, 0, 32)
                    OptionButton.BackgroundColor3 = COLORS.BACKGROUND
                    OptionButton.BackgroundTransparency = 0.2
                    OptionButton.Text = option
                    OptionButton.TextColor3 = COLORS.TEXT
                    OptionButton.TextSize = 15
                    OptionButton.Font = Enum.Font.Gotham
                    OptionButton.ZIndex = 2
                    local OptionUICorner = Instance.new("UICorner", OptionButton)
                    OptionUICorner.CornerRadius = UDim.new(0, 6)
                    createHoverEffect(OptionButton)
                    OptionButton.MouseButton1Click:Connect(function()
                        callback(option)
                        Title.Text = text .. " - " .. option
                        open = false
                        TweenService:Create(DropdownButton, TWEEN_INFO, {Rotation = 0}):Play()
                        TweenService:Create(OptionsFrame, TWEEN_INFO, {Size = UDim2.new(1, 0, 0, 0)}):Play()
                        task.wait(0.3)
                        OptionsFrame.Visible = false
                    end)
                end
                createHoverEffect(DropdownFrame)
                return DropdownFrame
            end

            function section:AddSlider(text, min, max, default, callback)
                local SliderFrame = Instance.new("Frame", SectionContent)
                SliderFrame.Name = "SliderFrame"
                SliderFrame.Size = UDim2.new(0, math.floor(0.92 * cellWidth), 0, 48)
                SliderFrame.BackgroundColor3 = COLORS.SECONDARY
                local UICorner_Slider = Instance.new("UICorner", SliderFrame)
                UICorner_Slider.CornerRadius = UDim.new(0, 8)
                local Title = Instance.new("TextLabel", SliderFrame)
                Title.Name = "Title"
                Title.Size = UDim2.new(1, 0, 0, 20)
                Title.Position = UDim2.new(0, 0, 0, 0)
                Title.BackgroundTransparency = 1
                Title.Text = text
                Title.TextColor3 = COLORS.TEXT
                Title.TextSize = 15
                Title.Font = Enum.Font.GothamSemibold
                Title.TextXAlignment = Enum.TextXAlignment.Left
                local SliderBackground = Instance.new("Frame", SliderFrame)
                SliderBackground.Name = "SliderBackground"
                SliderBackground.Size = UDim2.new(1, 0, 0, 6)
                SliderBackground.Position = UDim2.new(0, 0, 0.65, 0)
                SliderBackground.BackgroundColor3 = COLORS.BACKGROUND
                local UICorner_2 = Instance.new("UICorner", SliderBackground)
                UICorner_2.CornerRadius = UDim.new(1, 0)
                local SliderFill = Instance.new("Frame", SliderBackground)
                SliderFill.Name = "SliderFill"
                SliderFill.BackgroundColor3 = COLORS.ACCENT
                local UICorner_3 = Instance.new("UICorner", SliderFill)
                UICorner_3.CornerRadius = UDim.new(1, 0)
                local SliderValue = Instance.new("TextLabel", SliderFrame)
                SliderValue.Name = "SliderValue"
                SliderValue.Size = UDim2.new(0, math.floor(0.15 * cellWidth), 0, 20)
                SliderValue.Position = UDim2.new(1, -math.floor(0.15 * cellWidth), 0, 0)
                SliderValue.BackgroundTransparency = 1
                SliderValue.Text = tostring(default)
                SliderValue.TextColor3 = COLORS.TEXT
                SliderValue.TextSize = 15
                SliderValue.Font = Enum.Font.GothamSemibold
                local SliderButton = Instance.new("TextButton", SliderBackground)
                SliderButton.Name = "SliderButton"
                SliderButton.Size = UDim2.new(1, 0, 1, 0)
                SliderButton.BackgroundTransparency = 1
                SliderButton.Text = ""
                local function updateSlider(input)
                    local pos = input.Position
                    local relativePos = (pos.X - SliderBackground.AbsolutePosition.X) / SliderBackground.AbsoluteSize.X
                    relativePos = math.clamp(relativePos, 0, 1)
                    local value = min + (max - min) * relativePos
                    value = math.floor(value + 0.5)
                    SliderValue.Text = tostring(value)
                    SliderFill.Size = UDim2.new(relativePos, 0, 1, 0)
                    callback(value)
                end
                local defaultRelative = (default - min) / (max - min)
                SliderFill.Size = UDim2.new(defaultRelative, 0, 1, 0)
                local sliding = false
                SliderButton.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        updateSlider(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateSlider(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
                createHoverEffect(SliderFrame)
                return SliderFrame
            end

            function section:AddInput(text, placeholder, callback)
                local InputFrame = Instance.new("Frame", SectionContent)
                InputFrame.Name = "InputFrame"
                InputFrame.Size = UDim2.new(0, math.floor(0.92 * cellWidth), 0, 38)
