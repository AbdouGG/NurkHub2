                Button.BorderSizePixel = 0
                Button.Position = UDim2.new(0, 0, 0, 0)
                Button.Size = UDim2.new(0, 85, 0, 28)
                Button.Font = Enum.Font.GothamBold
                Button.Text = buttonText
                Button.TextColor3 = Colors.NeonCyan
                Button.TextSize = 11
                Button.AutoButtonColor = false
                
                local ButtonCorner = Instance.new("UICorner")
                ButtonCorner.CornerRadius = UDim.new(0, 6)
                ButtonCorner.Parent = Button
                
                local ButtonStroke = Instance.new("UIStroke")
                ButtonStroke.Parent = Button
                ButtonStroke.Thickness = 1.5
                ButtonStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                
                local ButtonStrokeGradient = Instance.new("UIGradient")
                ButtonStrokeGradient.Parent = ButtonStroke
                ButtonStrokeGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Colors.NeonCyan),
                    ColorSequenceKeypoint.new(1, Colors.NeonPurple)
                })
                ButtonStrokeGradient.Rotation = 90
                
                -- Hover effects
                Button.MouseEnter:Connect(function()
                    CreateTween(Button, Tweens.Fast, {BackgroundColor3 = Colors.ButtonHover})
                    CreateTween(Button, Tweens.Fast, {TextColor3 = Colors.TextPrimary})
                end)
                Button.MouseLeave:Connect(function()
                    CreateTween(Button, Tweens.Fast, {BackgroundColor3 = Colors.ButtonBackground})
                    CreateTween(Button, Tweens.Fast, {TextColor3 = Colors.NeonCyan})
                end)
                
                -- Click effect
                Button.MouseButton1Click:Connect(function()
                    CreateTween(Button, Tweens.Fast, {Size = UDim2.new(0, 82, 0, 26)})
                    wait(0.1)
                    CreateTween(Button, Tweens.Fast, {Size = UDim2.new(0, 85, 0, 28)})
                    callback()
                end)
                
                table.insert(self.Buttons, Button)
                return Button
            end
            
            -- ========================================
            -- ADD TOGGLE FUNCTION
            -- ========================================
            function Card:AddToggle(config)
                config = config or {}
                local defaultState = config.Default or false
                local callback = config.Callback or function() end
                
                local Toggle = {}
                Toggle.State = defaultState
                
                -- Toggle Container
                local ToggleFrame = Instance.new("Frame")
                ToggleFrame.Name = "Toggle"
                ToggleFrame.Parent = self.Controls
                ToggleFrame.BackgroundColor3 = defaultState and Colors.ToggleOn or Colors.ToggleOff
                ToggleFrame.BorderSizePixel = 0
                ToggleFrame.Position = UDim2.new(1, -50, 0, 2)
                ToggleFrame.Size = UDim2.new(0, 45, 0, 24)
                
                local ToggleCorner = Instance.new("UICorner")
                ToggleCorner.CornerRadius = UDim.new(1, 0)
                ToggleCorner.Parent = ToggleFrame
                
                -- Toggle Knob
                local ToggleKnob = Instance.new("Frame")
                ToggleKnob.Name = "Knob"
                ToggleKnob.Parent = ToggleFrame
                ToggleKnob.BackgroundColor3 = Colors.ToggleKnob
                ToggleKnob.BorderSizePixel = 0
                ToggleKnob.Position = defaultState and UDim2.new(1, -22, 0.5, -9) or UDim2.new(0, 4, 0.5, -9)
                ToggleKnob.Size = UDim2.new(0, 18, 0, 18)
                
                local KnobCorner = Instance.new("UICorner")
                KnobCorner.CornerRadius = UDim.new(1, 0)
                KnobCorner.Parent = ToggleKnob
                
                -- Toggle gradient when ON
                local ToggleGradient = Instance.new("UIGradient")
                ToggleGradient.Parent = ToggleFrame
                ToggleGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Colors.NeonCyan),
                    ColorSequenceKeypoint.new(1, Colors.NeonPurple)
                })
                ToggleGradient.Rotation = 90
                ToggleGradient.Enabled = defaultState
                
                -- Make toggle clickable
                local ToggleButton = Instance.new("TextButton")
                ToggleButton.Name = "ToggleButton"
                ToggleButton.Parent = ToggleFrame
                ToggleButton.BackgroundTransparency = 1
                ToggleButton.Size = UDim2.new(1, 0, 1, 0)
                ToggleButton.Text = ""
                
                function Toggle:SetState(state)
                    Toggle.State = state
                    ToggleGradient.Enabled = state
                    
                    if state then
                        CreateTween(ToggleFrame, Tweens.Smooth, {BackgroundColor3 = Colors.ToggleOn})
                        CreateTween(ToggleKnob, Tweens.Bounce, {Position = UDim2.new(1, -22, 0.5, -9)})
                    else
                        CreateTween(ToggleFrame, Tweens.Smooth, {BackgroundColor3 = Colors.ToggleOff})
                        CreateTween(ToggleKnob, Tweens.Bounce, {Position = UDim2.new(0, 4, 0.5, -9)})
                    end
                    
                    callback(state)
                end
                
                ToggleButton.MouseButton1Click:Connect(function()
                    Toggle:SetState(not Toggle.State)
                end)
                
                Toggle.Frame = ToggleFrame
                Toggle.Knob = ToggleKnob
                
                table.insert(self.Toggles, Toggle)
                return Toggle
            end
            
            table.insert(self.Cards, Card)
            return Card
        end
        
        -- Activate first tab automatically
        if tabOrder == 1 then
            ActivateTab()
        end
        
        table.insert(self.Tabs, Tab)
        return Tab
    end
    
    -- ========================================
    -- WINDOW METHODS
    -- ========================================
    function Window:Destroy()
        ScreenGui:Destroy()
    end
    
    function Window:Hide()
        MainFrame.Visible = false
    end
    
    function Window:Show()
        MainFrame.Visible = true
    end
    
    function Window:Toggle()
        MainFrame.Visible = not MainFrame.Visible
    end
    
    -- Keybind to toggle UI
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.RightControl then
            Window:Toggle()
        end
    end)
    
    -- Opening animation
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    task.wait()
    CreateTween(MainFrame, Tweens.Bounce, {Size = windowSize, Position = UDim2.new(0.5, -350, 0.5, -225)})
    
    return Window
end

-- ============================================================
-- RETURN LIBRARY
-- ============================================================
return OrionLibrary
