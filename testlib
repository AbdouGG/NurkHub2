            OptionContainer.Size = UDim2.new(1, 0, 0, 0) -- Auto sized
            
            local OptionList = Instance.new("UIListLayout")
            OptionList.Parent = OptionContainer
            OptionList.SortOrder = Enum.SortOrder.LayoutOrder
            
            -- Create Options
            local function RefreshOptions()
                for _, v in pairs(OptionContainer:GetChildren()) do
                    if v:IsA("TextButton") then v:Destroy() end
                end
                
                for _, opt in pairs(options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Parent = OptionContainer
                    OptBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                    OptBtn.Size = UDim2.new(1, 0, 0, 30)
                    OptBtn.Font = Enum.Font.Gotham
                    OptBtn.Text = opt
                    OptBtn.TextColor3 = Colors.TextDark
                    OptBtn.TextSize = 13
                    
                    OptBtn.MouseButton1Click:Connect(function()
                        DropBtn.Text = "  " .. text .. ": " .. opt
                        isDropped = false
                        Tween(DropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 40)})
                        callback(opt)
                    end)
                end
            end
            
            RefreshOptions()
            
            DropBtn.MouseButton1Click:Connect(function()
                isDropped = not isDropped
                if isDropped then
                    local count = #options
                    Tween(DropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 40 + (count * 30))})
                else
                    Tween(DropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 40)})
                end
            end)
        end

        return TabObj
    end

    return WindowTable
end

return Library
