    -- ── Window Object ──
    local Window = {}
    Window._tabs        = {}
    Window._activeTab   = nil
    Window._tabButtons  = {}
 
    function Window:SetActiveTab(tabName)
        for name, tab in pairs(self._tabs) do
            tab.Content.Visible = (name == tabName)
        end
        for name, btn in pairs(self._tabButtons) do
            local isActive = (name == tabName)
            FastTween(btn.Bg, {
                BackgroundColor3 = isActive and Theme.TabActive or Theme.TabInactive
            }, 0.15)
            FastTween(btn.Label, {
                TextColor3 = isActive and Theme.TextActive or Theme.TextSecondary
            }, 0.15)
            if isActive then
                FastTween(btn.Indicator, { BackgroundTransparency = 0 }, 0.15)
            else
                FastTween(btn.Indicator, { BackgroundTransparency = 1 }, 0.15)
            end
        end
        self._activeTab = tabName
    end
 
