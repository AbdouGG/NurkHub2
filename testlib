            ToggleDesc.Parent = ToggleFrame
            ToggleDesc.BackgroundTransparency = 1
            ToggleDesc.Position = UDim2.new(0, 0, 0, 16)
            ToggleDesc.Size = UDim2.new(0.7, 0, 0, 15)
            ToggleDesc.Font = Enum.Font.Gotham
            ToggleDesc.Text = "toggle"
            ToggleDesc.TextColor3 = Theme.TextMuted
            ToggleDesc.TextSize = 10
            ToggleDesc.TextXAlignment = Enum.TextXAlignment.Left
            
            -- Switch Background
            local SwitchBg = Instance.new("Frame")
            SwitchBg.Parent = ToggleFrame
            SwitchBg.BackgroundColor3 = Default and Theme.Secondary or Theme.Surface
            SwitchBg.Position = UDim2.new(1, -50, 0.5, -11)
            SwitchBg.Size = UDim2.new(0, 44, 0, 22)
            
            local SwitchBgCorner = Instance.new("UICorner")
            SwitchBgCorner.CornerRadius = UDim.new(1, 0)
            SwitchBgCorner.Parent = SwitchBg
            
            -- Switch Dot
            local SwitchDot = Instance.new("Frame")
            SwitchDot.Parent = SwitchBg
            SwitchDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            SwitchDot.Position = Default and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
            SwitchDot.Size = UDim2.new(0, 18, 0, 18)
            
            local SwitchDotCorner = Instance.new("UICorner")
            SwitchDotCorner.CornerRadius = UDim.new(1, 0)
            SwitchDotCorner.Parent = SwitchDot
            
            local function UpdateToggle()
                local targetColor = Toggled and Theme.Secondary or Theme.Surface
                local targetPos = Toggled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
                
                TweenService:Create(SwitchBg, TweenPresets.Normal, {BackgroundColor3 = targetColor}):Play()
                TweenService:Create(SwitchDot, TweenPresets.Smooth, {Position = targetPos}):Play()
            end
            
            ToggleFrame.MouseButton1Click:Connect(function()
                Toggled = not Toggled
                UpdateToggle()
                pcall(Callback, Toggled)
            end)
            
            Tab:RefreshCanvas()
            
            local ToggleObj = {}
            function ToggleObj:Set(bool)
                if bool == nil then return end
                Toggled = bool
                UpdateToggle()
                pcall(Callback, Toggled)
            end
            function ToggleObj:Get()
                return Toggled
            end
            return ToggleObj
        end
        
        -- ═══════════════════════════════════════════════════
        -- ELEMENT: INPUT (Text Box)
        -- ═══════════════════════════════════════════════════
        function Tab:CreateInput(options)
            options = options or {}
            local InputName = options.Name or "Input"
            local Placeholder = options.Placeholder or "Type here..."
            local Callback = options.Callback or function() end
            
            local InputFrame = Instance.new("Frame")
            InputFrame.Name = "Input"
            InputFrame.Parent = Page
            InputFrame.BackgroundTransparency = 1
            InputFrame.Size = UDim2.new(1, 0, 0, 35)
            
            local InputLabel = Instance.new("TextLabel")
            InputLabel.Parent = InputFrame
            InputLabel.BackgroundTransparency = 1
            InputLabel.Size = UDim2.new(0.4, 0, 0, 18)
            InputLabel.Font = Enum.Font.GothamMedium
            InputLabel.Text = InputName
            InputLabel.TextColor3 = Theme.TextPrimary
            InputLabel.TextSize = 13
            InputLabel.TextXAlignment = Enum.TextXAlignment.Left
            
            local InputDesc = Instance.new("TextLabel")
            InputDesc.Parent = InputFrame
            InputDesc.BackgroundTransparency = 1
            InputDesc.Position = UDim2.new(0, 0, 0, 16)
            InputDesc.Size = UDim2.new(0.4, 0, 0, 15)
            InputDesc.Font = Enum.Font.Gotham
            InputDesc.Text = "input"
            InputDesc.TextColor3 = Theme.TextMuted
            InputDesc.TextSize = 10
            InputDesc.TextXAlignment = Enum.TextXAlignment.Left
            
            -- Text Box
            local TextBox = Instance.new("TextBox")
            TextBox.Parent = InputFrame
            TextBox.BackgroundColor3 = Theme.Surface
            TextBox.Position = UDim2.new(0.45, 0, 0.5, -12)
            TextBox.Size = UDim2.new(0.55, -5, 0, 24)
            TextBox.Font = Enum.Font.Gotham
            TextBox.PlaceholderText = Placeholder
            TextBox.PlaceholderColor3 = Theme.TextMuted
            TextBox.Text = ""
            TextBox.TextColor3 = Theme.TextPrimary
            TextBox.TextSize = 11
            TextBox.ClearTextOnFocus = false
            
            local TextBoxCorner = Instance.new("UICorner")
            TextBoxCorner.CornerRadius = Theme.CornerRadiusSmall
            TextBoxCorner.Parent = TextBox
            
            local TextBoxPadding = Instance.new("UIPadding")
            TextBoxPadding.Parent = TextBox
            TextBoxPadding.PaddingLeft = UDim.new(0, 8)
            TextBoxPadding.PaddingRight = UDim.new(0, 8)
            
            TextBox.FocusLost:Connect(function(enterPressed)
                if enterPressed then
                    pcall(Callback, TextBox.Text)
                end
            end)
            
            Tab:RefreshCanvas()
            
            local InputObj = {}
            function InputObj:Set(text)
                TextBox.Text = text
            end
            function InputObj:Get()
                return TextBox.Text
            end
            return InputObj
        end
        
        -- ═══════════════════════════════════════════════════
        -- ELEMENT: DROPDOWN
        -- ═══════════════════════════════════════════════════
        function Tab:CreateDropdown(options)
            options = options or {}
            local DropdownName = options.Name or "Dropdown"
            local Options = options.Options or {}
            local Default = options.Default
            local Callback = options.Callback or function() end
            
            local Selected = Default
            local isOpen = false
            
            local DropFrame = Instance.new("Frame")
            DropFrame.Name = "Dropdown"
            DropFrame.Parent = Page
            DropFrame.BackgroundTransparency = 1
            DropFrame.ClipsDescendants = true
            DropFrame.Size = UDim2.new(1, 0, 0, 35)
            
            local DropLabel = Instance.new("TextLabel")
            DropLabel.Parent = DropFrame
            DropLabel.BackgroundTransparency = 1
            DropLabel.Size = UDim2.new(0.4, 0, 0, 18)
            DropLabel.Font = Enum.Font.GothamMedium
            DropLabel.Text = DropdownName
            DropLabel.TextColor3 = Theme.TextPrimary
            DropLabel.TextSize = 13
            DropLabel.TextXAlignment = Enum.TextXAlignment.Left
            
            local DropDesc = Instance.new("TextLabel")
            DropDesc.Parent = DropFrame
            DropDesc.BackgroundTransparency = 1
            DropDesc.Position = UDim2.new(0, 0, 0, 16)
            DropDesc.Size = UDim2.new(0.4, 0, 0, 15)
            DropDesc.Font = Enum.Font.Gotham
            DropDesc.Text = "dropdown"
            DropDesc.TextColor3 = Theme.TextMuted
            DropDesc.TextSize = 10
            DropDesc.TextXAlignment = Enum.TextXAlignment.Left
            
            -- Dropdown Button
            local DropBtn = Instance.new("TextButton")
            DropBtn.Parent = DropFrame
            DropBtn.BackgroundColor3 = Theme.Surface
            DropBtn.Position = UDim2.new(0.45, 0, 0, 5)
            DropBtn.Size = UDim2.new(0.55, -5, 0, 24)
            DropBtn.Font = Enum.Font.Gotham
            DropBtn.Text = Selected and tostring(Selected) or "Select..."
            DropBtn.TextColor3 = Theme.TextSecondary
            DropBtn.TextSize = 11
            DropBtn.AutoButtonColor = false
            
            local DropBtnCorner = Instance.new("UICorner")
            DropBtnCorner.CornerRadius = Theme.CornerRadiusSmall
            DropBtnCorner.Parent = DropBtn
            
            -- Options Container
            local OptionsContainer = Instance.new("Frame")
            OptionsContainer.Parent = DropFrame
            OptionsContainer.BackgroundColor3 = Theme.Surface
            OptionsContainer.Position = UDim2.new(0.45, 0, 0, 32)
            OptionsContainer.Size = UDim2.new(0.55, -5, 0, 0)
            OptionsContainer.ClipsDescendants = true
            OptionsContainer.Visible = false
            
            local OptionsCorner = Instance.new("UICorner")
            OptionsCorner.CornerRadius = Theme.CornerRadiusSmall
            OptionsCorner.Parent = OptionsContainer
            
            local OptionsList = Instance.new("UIListLayout")
            OptionsList.Parent = OptionsContainer
            OptionsList.SortOrder = Enum.SortOrder.LayoutOrder
            OptionsList.Padding = UDim.new(0, 2)
            
            local function RefreshOptions()
                for _, child in pairs(OptionsContainer:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                
                for _, opt in ipairs(Options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Parent = OptionsContainer
                    OptBtn.BackgroundColor3 = Theme.Surface
                    OptBtn.BackgroundTransparency = 1
                    OptBtn.Size = UDim2.new(1, 0, 0, 22)
                    OptBtn.Font = Enum.Font.Gotham
                    OptBtn.Text = tostring(opt)
                    OptBtn.TextColor3 = Theme.TextSecondary
                    OptBtn.TextSize = 11
                    OptBtn.AutoButtonColor = false
                    
                    OptBtn.MouseEnter:Connect(function()
                        OptBtn.TextColor3 = Theme.TextPrimary
                    end)
                    OptBtn.MouseLeave:Connect(function()
                        OptBtn.TextColor3 = Theme.TextSecondary
                    end)
                    
                    OptBtn.MouseButton1Click:Connect(function()
                        Selected = opt
                        DropBtn.Text = tostring(opt)
                        isOpen = false
                        OptionsContainer.Visible = false
                        TweenService:Create(DropFrame, TweenPresets.Fast, {Size = UDim2.new(1, 0, 0, 35)}):Play()
                        task.defer(function() Tab:RefreshCanvas() end)
                        pcall(Callback, opt)
                    end)
                end
            end
            
            RefreshOptions()
            
            DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                
                if isOpen then
                    local itemCount = math.min(#Options, 4)
                    local containerHeight = itemCount * 24 + 4
                    OptionsContainer.Size = UDim2.new(0.55, -5, 0, containerHeight)
                    OptionsContainer.Visible = true
                    TweenService:Create(DropFrame, TweenPresets.Fast, {Size = UDim2.new(1, 0, 0, 35 + containerHeight + 5)}):Play()
                else
                    OptionsContainer.Visible = false
                    TweenService:Create(DropFrame, TweenPresets.Fast, {Size = UDim2.new(1, 0, 0, 35)}):Play()
                end
                
                task.defer(function() Tab:RefreshCanvas() end)
            end)
            
            Tab:RefreshCanvas()
            
            local DropObj = {}
            function DropObj:Refresh(newOptions, keepCurrent)
                Options = newOptions or {}
                RefreshOptions()
                if not keepCurrent then
                    Selected = nil
                    DropBtn.Text = "Select..."
                end
            end
            function DropObj:Set(value)
                Selected = value
                DropBtn.Text = tostring(value)
                pcall(Callback, value)
            end
            function DropObj:Get()
                return Selected
            end
            return DropObj
        end
        
        return Tab
    end
    
    return Window
end

return Library
