            DropBtn.Text = "  " .. text .. " [V]"
            DropBtn.TextColor3 = Colors.Text
            DropBtn.TextSize = 14
            DropBtn.TextXAlignment = Enum.TextXAlignment.Left
            
            local iBtn = CreateInfo(DropFrame, info)
            
