            local SectionFrame = Instance.new("Frame", TabContent)
            SectionFrame.Name = "Section_" .. sectionName
            SectionFrame.Size = UDim2.new(0, cellWidth, 0, cellHeight)
            SectionFrame.BackgroundColor3 = COLORS.SECONDARY
            SectionFrame.BackgroundTransparency = 0.1
            tab.SectionCount = tab.SectionCount + 1
            SectionFrame.LayoutOrder = tab.SectionCount
            local SectionCorner = Instance.new("UICorner", SectionFrame)
            SectionCorner.CornerRadius = UDim.new(0, 8)

            local SectionLabel = Instance.new("TextLabel", SectionFrame)
            SectionLabel.Name = "SectionLabel"
            SectionLabel.Size = UDim2.new(1, 0, 0, 30)
            SectionLabel.BackgroundTransparency = 1
            SectionLabel.Text = sectionName
            SectionLabel.TextColor3 = COLORS.TEXT
