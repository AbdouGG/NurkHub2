    local dragging = false
    local dragStart, startPos

    local function updateDrag(input)
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end

   TopBar.InputBegan:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = true
			dragStart = input.Position
			startPos = MainFrame.Position
		end
	end)

	TopBar.InputEnded:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
		end
	end)

		-- Use RenderStepped for smoother dragging
        RunService.RenderStepped:Connect(function()
            if dragging and UserInputService:GetMouseLocation() then
                updateDrag({Position = UserInputService:GetMouseLocation()})
            end
        end)
    
    
        ToggleButton.MouseButton1Click:Connect(function()
            local uiVisible = MainFrame.Visible
            MainFrame.Visible = not uiVisible
            TweenService:Create(ToggleButton, TWEEN_INFO, {Rotation = (not uiVisible) and 0 or 90}):Play()
        end)
    
    
        ----------------------------------------------------------------
        -- Fade-In Animation for the Window (Improved)
        ----------------------------------------------------------------
        local function fadeIn()
            MainFrame.Visible = false -- Hide initially for a cleaner fade-in
    
            -- Use a single loop to handle both BackgroundTransparency and TextTransparency
            for _, obj in ipairs(MainFrame:GetDescendants()) do
                if obj:IsA("GuiObject") then  -- More general check for UI elements
                    if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("ImageLabel") or obj:IsA("ImageButton") then --include imagelabels
                        if obj.BackgroundTransparency < 1 and not obj:IsA("ImageLabel") and not obj:IsA("ImageButton") then -- Exclude image labels from background fade
                            obj.BackgroundTransparency = 1
                            TweenService:Create(obj, TWEEN_INFO, {BackgroundTransparency = 0}).Completed:Wait() -- Removed :Play(), use .Completed:Wait()
    
                        end
                        if obj:IsA("TextButton") or obj:IsA("TextLabel") then
                            obj.TextTransparency = 1
                            TweenService:Create(obj, TWEEN_INFO, {TextTransparency = 0}).Completed:Wait()
                        end
                        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                            if obj.ImageTransparency < 1 then -- Check if the image *has* transparency
                                obj.ImageTransparency = 1
                                TweenService:Create(obj,TWEEN_INFO,{ImageTransparency = 0}).Completed:Wait()
                            end
                        end
                    end
                end
            end
            MainFrame.Visible = true -- Make visible after all tweens
        end
        
        -- Wrap fadeIn() call to ensure the UI thread is ready.
        task.defer(fadeIn)  -- Use task.defer() instead of spawn().
        
    
        return window
    end
    
    ----------------------------------------------------------------
    -- Notification Functionality (Improved)
    ----------------------------------------------------------------
    function PandaAuth:Notify(title, description, duration)
        duration = duration or 5
        local notifyScreen = game:GetService("CoreGui"):FindFirstChild("PandaAuthNotifyUI")
        if not notifyScreen then
            notifyScreen = Instance.new("ScreenGui")
            notifyScreen.Name = "PandaAuthNotifyUI"
            notifyScreen.Parent = game:GetService("CoreGui")
            notifyScreen.DisplayOrder = 9999 -- High DisplayOrder, ensures notifications are on top.
        end
    
        -- Notification Container (manages stacking)
        local notifyContainer = notifyScreen:FindFirstChild("NotifyContainer")
        if not notifyContainer then
            notifyContainer = Instance.new("Frame", notifyScreen)
            notifyContainer.Name = "NotifyContainer"
            notifyContainer.Size = UDim2.new(0, 320, 1, 0) -- Fixed width, expand vertically
            notifyContainer.Position = UDim2.new(1, -340, 1, -20) -- Start off-screen to the right
            notifyContainer.AnchorPoint = Vector2.new(1, 1) -- Anchor to bottom-right
            notifyContainer.BackgroundTransparency = 1
            local containerLayout = Instance.new("UIListLayout", notifyContainer)
            containerLayout.SortOrder = Enum.SortOrder.LayoutOrder
            containerLayout.FillDirection = Enum.FillDirection.Vertical
            containerLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom  -- New notifications at the bottom
            containerLayout.Padding = UDim.new(0, 10)
        end
        
    
    
        local notifyFrame = Instance.new("Frame", notifyContainer) -- Parent to container
        notifyFrame.Size = UDim2.new(1, 0, 0, 80) -- Full width of container, fixed height
        notifyFrame.BackgroundColor3 = COLORS.SECONDARY
        notifyFrame.LayoutOrder = #notifyContainer:GetChildren() -- Use LayoutOrder
        --Removed Anchoring
        --notifyFrame.Position = UDim2.new(1, 320, 1, -100) -- Off-screen to the right for sliding
    
        local notifyCorner = Instance.new("UICorner", notifyFrame)
        notifyCorner.CornerRadius = UDim.new(0, 8)
    
        local titleLabel = Instance.new("TextLabel", notifyFrame)
        titleLabel.Size = UDim2.new(1, -20, 0, 30)
        titleLabel.Position = UDim2.new(0, 10, 0, 10)
        titleLabel.BackgroundTransparency = 1
        titleLabel.Text = title
        titleLabel.TextColor3 = COLORS.TEXT
        titleLabel.Font = Enum.Font.GothamBold
        titleLabel.TextSize = 18
    
        local descLabel = Instance.new("TextLabel", notifyFrame)
        descLabel.Size = UDim2.new(1, -20, 0, 30)
        descLabel.Position = UDim2.new(0, 10, 0, 40)
        descLabel.BackgroundTransparency = 1
        descLabel.Text = description
        descLabel.TextColor3 = COLORS.TEXT
        descLabel.Font = Enum.Font.Gotham
        descLabel.TextSize = 14
    
        -- Slide in from the right
        local slideIn = TweenService:Create(notifyFrame, TWEEN_INFO, {Position = UDim2.new(0, 0, 0, 0)}) -- Move to origin
        slideIn:Play()
    
        delay(duration, function()
             -- Slide out to the right
            local slideOut = TweenService:Create(notifyFrame, TWEEN_INFO, {Position = UDim2.new(1, 0, 0, 0)}) -- Slide out of view
            slideOut:Play()
            slideOut.Completed:Connect(function()
                notifyFrame:Destroy()
            end)
        end)
    end
    
    return PandaAuth
