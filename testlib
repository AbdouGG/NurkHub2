            Instance.new("UICorner", BoxFrame).CornerRadius = UDim.new(0, 6)
            AddStroke(BoxFrame, Theme.Stroke, 1)

            local Title = Instance.new("TextLabel")
            Title.Parent = BoxFrame
            Title.BackgroundTransparency = 1
            Title.Position = UDim2.new(0, 12, 0, 0)
            Title.Size = UDim2.new(0.6, 0, 1, 0)
            Title.Font = Enum.Font.GothamSemibold
            Title.Text = text
            Title.TextColor3 = Theme.Text
            Title.TextSize = 14
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local Input = Instance.new("TextBox")
            Input.Parent = BoxFrame
            Input.BackgroundColor3 = Theme.Main
            Input.Position = UDim2.new(1, -110, 0.5, -12)
            Input.Size = UDim2.new(0, 100, 0, 24)
            Input.Font = Enum.Font.Gotham
            Input.PlaceholderText = placeholder or "Type..."
            Input.Text = ""
            Input.TextColor3 = Theme.Text
            Input.PlaceholderColor3 = Theme.TextDark
            Input.TextSize = 13
            Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 4)
            AddStroke(Input, Theme.Stroke, 1)

            Input.FocusLost:Connect(function(enter)
                callback(Input.Text)
            end)
        end

        function TabMethods:Keybind(text, default, callback)
            local key = default or Enum.KeyCode.E
            local binding = false
            
            local KFrame = Instance.new("TextButton")
            KFrame.Parent = Page
            KFrame.BackgroundColor3 = Theme.Secondary
            KFrame.Size = UDim2.new(1, 0, 0, 38)
            KFrame.Text = ""
            KFrame.AutoButtonColor = false
            Instance.new("UICorner", KFrame).CornerRadius = UDim.new(0, 6)
            AddStroke(KFrame, Theme.Stroke, 1)

            local Title = Instance.new("TextLabel")
            Title.Parent = KFrame
            Title.BackgroundTransparency = 1
            Title.Position = UDim2.new(0, 12, 0, 0)
            Title.Size = UDim2.new(0.6, 0, 1, 0)
            Title.Font = Enum.Font.GothamSemibold
            Title.Text = text
            Title.TextColor3 = Theme.Text
            Title.TextSize = 14
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local BindText = Instance.new("TextLabel")
            BindText.Parent = KFrame
            BindText.BackgroundTransparency = 1
            BindText.Position = UDim2.new(1, -110, 0, 0)
            BindText.Size = UDim2.new(0, 100, 1, 0)
            BindText.Font = Enum.Font.Gotham
            BindText.Text = "[" .. key.Name .. "]"
            BindText.TextColor3 = Theme.TextDark
            BindText.TextSize = 13
            BindText.TextXAlignment = Enum.TextXAlignment.Right

            KFrame.MouseButton1Click:Connect(function()
                binding = true
                BindText.Text = "..."
                BindText.TextColor3 = Theme.Accent
            end)

            UserInputService.InputBegan:Connect(function(input)
                if binding then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        key = input.KeyCode
                        binding = false
                        BindText.Text = "[" .. key.Name .. "]"
                        BindText.TextColor3 = Theme.TextDark
                        callback(key)
                    end
                elseif input.KeyCode == key then
                    callback(key)
                end
            end)
        end

        function TabMethods:ColorPicker(text, default, callback)
            local color = default or Color3.fromRGB(255, 255, 255)
            local isOpened = false

            local CFrame = Instance.new("Frame")
            CFrame.Parent = Page
            CFrame.BackgroundColor3 = Theme.Secondary
            CFrame.Size = UDim2.new(1, 0, 0, 38)
            CFrame.ClipsDescendants = true
            Instance.new("UICorner", CFrame).CornerRadius = UDim.new(0, 6)
            AddStroke(CFrame, Theme.Stroke, 1)

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Parent = CFrame
            ToggleBtn.BackgroundTransparency = 1
            ToggleBtn.Size = UDim2.new(1, 0, 0, 38)
            ToggleBtn.Text = ""

            local Title = Instance.new("TextLabel")
            Title.Parent = ToggleBtn
            Title.BackgroundTransparency = 1
            Title.Position = UDim2.new(0, 12, 0, 0)
            Title.Size = UDim2.new(0.6, 0, 1, 0)
            Title.Font = Enum.Font.GothamSemibold
            Title.Text = text
            Title.TextColor3 = Theme.Text
            Title.TextSize = 14
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local Preview = Instance.new("Frame")
            Preview.Parent = ToggleBtn
            Preview.BackgroundColor3 = color
            Preview.Position = UDim2.new(1, -50, 0.5, -10)
            Preview.Size = UDim2.new(0, 40, 0, 20)
            Instance.new("UICorner", Preview).CornerRadius = UDim.new(0, 4)
            AddStroke(Preview, Theme.Stroke, 1)

            local Sliders = Instance.new("Frame")
            Sliders.Parent = CFrame
            Sliders.BackgroundTransparency = 1
            Sliders.Position = UDim2.new(0, 0, 0, 38)
            Sliders.Size = UDim2.new(1, 0, 0, 90)

            local function CreateSlider(type, y)
                local Sld = Instance.new("Frame")
                Sld.Parent = Sliders
                Sld.BackgroundColor3 = Theme.Main
                Sld.Position = UDim2.new(0, 10, 0, y)
                Sld.Size = UDim2.new(1, -20, 0, 20)
                Instance.new("UICorner", Sld).CornerRadius = UDim.new(0, 4)
                
                local Fill = Instance.new("Frame")
                Fill.Parent = Sld
                Fill.Size = UDim2.new(1, 0, 1, 0)
                Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 4)
                if type == "R" then Fill.BackgroundColor3 = Color3.fromRGB(255,50,50)
                elseif type == "G" then Fill.BackgroundColor3 = Color3.fromRGB(50,255,50)
                else Fill.BackgroundColor3 = Color3.fromRGB(50,50,255) end

                local Btn = Instance.new("TextButton")
                Btn.Parent = Sld
                Btn.BackgroundTransparency = 1
                Btn.Size = UDim2.new(1,0,1,0)
                Btn.Text = ""
                
                local dragging = false
                local function Update(i)
                    local x = math.clamp((i.Position.X - Sld.AbsolutePosition.X)/Sld.AbsoluteSize.X, 0, 1)
                    Fill.Size = UDim2.new(x, 0, 1, 0)
                    local r = (type == "R") and x or Sliders:FindFirstChild("R_Sld").Frame.Size.X.Scale
                    local g = (type == "G") and x or Sliders:FindFirstChild("G_Sld").Frame.Size.X.Scale
                    local b = (type == "B") and x or Sliders:FindFirstChild("B_Sld").Frame.Size.X.Scale
                    color = Color3.new(r,g,b)
                    Preview.BackgroundColor3 = color
                    callback(color)
                end
                Btn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true Update(i) end end)
                UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
                UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then Update(i) end end)
                Sld.Name = type.."_Sld"
            end
            CreateSlider("R", 5) CreateSlider("G", 35) CreateSlider("B", 65)

            ToggleBtn.MouseButton1Click:Connect(function()
                isOpened = not isOpened
                if isOpened then Tween(CFrame, 0.2, {Size = UDim2.new(1, 0, 0, 130)})
                else Tween(CFrame, 0.2, {Size = UDim2.new(1, 0, 0, 38)}) end
            end)
        end
        
        return TabMethods
    end

    return Window
end

return Library
