            SwitchDotCorner.CornerRadius = UDim.new(1, 0)
            SwitchDotCorner.Parent = SwitchDot
            
            -- Shadow on dot
            local DotShadow = Instance.new("UIStroke")
            DotShadow.Parent = SwitchDot
            DotShadow.Color = Color3.fromRGB(0, 0, 0)
            DotShadow.Transparency = 0.8
            DotShadow.Thickness = 1
            
            local function UpdateToggle()
                local targetColor = Toggled and Theme.Primary or Theme.Border
                local targetPos = Toggled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
                
                TweenService:Create(SwitchBg, TweenPresets.Normal, {BackgroundColor3 = targetColor}):Play()
                TweenService:Create(SwitchDot, TweenPresets.Smooth, {Position = targetPos}):Play()
            end
            
            ToggleFrame.MouseButton1Click:Connect(function(input)
                Toggled = not Toggled
                UpdateToggle()
                
                if input and input.Position then
                    CreateRipple(ToggleFrame, input.Position)
                end
                
                pcall(Callback, Toggled)
            end)
            
            -- Hover effect
            ToggleFrame.MouseEnter:Connect(function()
                TweenService:Create(ToggleFrame, TweenPresets.Fast, {BackgroundColor3 = Theme.SurfaceHover}):Play()
            end)
            ToggleFrame.MouseLeave:Connect(function()
                TweenService:Create(ToggleFrame, TweenPresets.Fast, {BackgroundColor3 = Theme.Surface}):Play()
            end)
            
            Tab:RefreshCanvas()
            
            local ToggleObj = {}
            function ToggleObj:Set(bool)
                if bool == nil then return end
                Toggled = bool
                UpdateToggle()
                pcall(Callback, Toggled)
            end
            function ToggleObj:Get()
                return Toggled
            end
            return ToggleObj
        end
        
