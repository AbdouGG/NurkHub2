-- PandaAuth Library - PRO Modern Theme with Notifications, Grid Layout, and Section ScrollBars
local PandaAuth = {}
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- PRO Theme Colors
local COLORS = {
    BACKGROUND     = Color3.fromRGB(32, 34, 37),   -- Dark, modern background
    ACCENT         = Color3.fromRGB(80, 150, 255),  -- A bright blue accent
    SECONDARY      = Color3.fromRGB(40, 42, 46),    -- Slightly lighter than BACKGROUND
    TEXT           = Color3.fromRGB(230, 230, 230), -- Near white text
    SUCCESS        = Color3.fromRGB(80, 250, 123),  -- Vibrant green for success
    ERROR          = Color3.fromRGB(250, 80, 80),   -- Bold red for errors
    HOVER          = Color3.fromRGB(50, 52, 57),    -- Subtle hover shade
    TAB_SELECTED   = Color3.fromRGB(80, 150, 255),  -- Use accent color for selected tab
    TAB_UNSELECTED = Color3.fromRGB(40, 42, 46)     -- Use secondary color for unselected
}

-- Animation settings
local TWEEN_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Utility function for hover effects
local function createHoverEffect(button)
    local originalColor = button.BackgroundColor3
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = COLORS.HOVER}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = originalColor}):Play()
    end)
end

function PandaAuth:CreateWindow(title)
