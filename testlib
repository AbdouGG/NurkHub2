                    Parent = TogFrame,
                })
                AddCorner(Track, UDim.new(0, 11))
 
                local Knob = Create("Frame", {
                    Size = UDim2.new(0, 16, 0, 16),
                    Position = toggled
                        and UDim2.new(0, 21, 0.5, -8)
                        or  UDim2.new(0, 3,  0.5, -8),
                    BackgroundColor3 = toggled and Theme.ToggleKnob or Theme.TextSecondary,
                    BorderSizePixel = 0,
                    Parent = Track,
                })
                AddCorner(Knob, UDim.new(0, 8))
 
                local function UpdateToggle()
                    FastTween(Track, {
                        BackgroundColor3 = toggled and Theme.ToggleOn or Theme.ToggleOff
                    }, 0.15)
                    FastTween(Knob, {
                        Position = toggled
                            and UDim2.new(0, 21, 0.5, -8)
                            or  UDim2.new(0, 3,  0.5, -8),
                        BackgroundColor3 = toggled and Theme.ToggleKnob or Theme.TextSecondary
                    }, 0.15)
                end
 
                Btn.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    UpdateToggle()
                    local ok, err = pcall(Callback, toggled)
                    if not ok then warn("[NexusUI] Toggle Callback Error: " .. tostring(err)) end
                end)
                Btn.MouseEnter:Connect(function()
                    FastTween(TogFrame, { BackgroundColor3 = Theme.ElementHover }, 0.12)
                end)
                Btn.MouseLeave:Connect(function()
                    FastTween(TogFrame, { BackgroundColor3 = Theme.ElementBg }, 0.12)
                end)
 
                local ToggleAPI = {}
                function ToggleAPI:Set(val)
                    toggled = val
                    UpdateToggle()
                    pcall(Callback, toggled)
                end
                function ToggleAPI:Get()
                    return toggled
                end
                return ToggleAPI
            end
 
            -- ── Slider ────────────────────────────────────────────────────────
            function SectionObj:AddSlider(cfg)
                cfg = cfg or {}
                local Text     = cfg.Text     or "Slider"
                local Min      = cfg.Min      or 0
                local Max      = cfg.Max      or 100
                local Default  = cfg.Default  or Min
                local Suffix   = cfg.Suffix   or ""
                local Callback = cfg.Callback or function() end
 
                local value = math.clamp(Default, Min, Max)
 
                local SliderFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, Theme.ElementHeight + 16),
                    BackgroundColor3 = Theme.ElementBg,
                    LayoutOrder = #ElementContainer:GetChildren(),
                    Parent = ElementContainer,
                })
                AddCorner(SliderFrame, UDim.new(0, 6))
                AddStroke(SliderFrame, Theme.Border, 1)
 
                -- Label row
                Create("TextLabel", {
                    Size = UDim2.new(1, -80, 0, 20),
                    Position = UDim2.new(0, 12, 0, 8),
                    BackgroundTransparency = 1,
                    Text = Text,
                    TextColor3 = Theme.TextPrimary,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = SliderFrame,
                })
 
                local ValueLabel = Create("TextLabel", {
                    Size = UDim2.new(0, 70, 0, 20),
                    Position = UDim2.new(1, -82, 0, 8),
                    BackgroundTransparency = 1,
                    Text = tostring(value) .. Suffix,
                    TextColor3 = Theme.TextSecondary,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = SliderFrame,
                })
 
                -- Track
                local Track = Create("Frame", {
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 0, 36),
                    BackgroundColor3 = Theme.SliderTrack,
                    BorderSizePixel = 0,
                    Parent = SliderFrame,
                })
                AddCorner(Track, UDim.new(0, 3))
 
                local Fill = Create("Frame", {
                    Size = UDim2.new((value - Min) / (Max - Min), 0, 1, 0),
                    BackgroundColor3 = Theme.SliderFill,
                    BorderSizePixel = 0,
                    Parent = Track,
                })
                AddCorner(Fill, UDim.new(0, 3))
 
                local Knob = Create("Frame", {
                    Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new((value - Min) / (Max - Min), -7, 0.5, -7),
                    BackgroundColor3 = Theme.SliderKnob,
                    BorderSizePixel = 0,
                    ZIndex = 3,
                    Parent = Track,
                })
                AddCorner(Knob, UDim.new(0, 7))
                AddStroke(Knob, Color3.fromRGB(0,0,0), 2)
 
                local sliding = false
 
                local function UpdateSlider(input)
                    local trackPos = Track.AbsolutePosition.X
                    local trackSize = Track.AbsoluteSize.X
                    local relX = math.clamp(input.Position.X - trackPos, 0, trackSize)
                    local pct  = relX / trackSize
                    value = math.floor(Min + (Max - Min) * pct)
                    ValueLabel.Text = tostring(value) .. Suffix
                    FastTween(Fill,  { Size = UDim2.new(pct, 0, 1, 0) }, 0.05)
                    FastTween(Knob, { Position = UDim2.new(pct, -7, 0.5, -7) }, 0.05)
                    local ok, err = pcall(Callback, value)
                    if not ok then warn("[NexusUI] Slider Callback Error: " .. tostring(err)) end
                end
 
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = true
                        UpdateSlider(input)
                    end
                end)
 
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                        UpdateSlider(input)
                    end
                end)
 
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = false
                    end
                end)
 
                local SliderAPI = {}
                function SliderAPI:Set(val)
                    value = math.clamp(val, Min, Max)
                    local pct = (value - Min) / (Max - Min)
                    ValueLabel.Text = tostring(value) .. Suffix
                    FastTween(Fill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.1)
                    FastTween(Knob, { Position = UDim2.new(pct, -7, 0.5, -7) }, 0.1)
                end
                function SliderAPI:Get()
                    return value
                end
                return SliderAPI
            end
 
            -- ── TextBox ───────────────────────────────────────────────────────
            function SectionObj:AddTextBox(cfg)
                cfg = cfg or {}
                local Text        = cfg.Text        or "TextBox"
                local Placeholder = cfg.Placeholder or "Enter text..."
                local Default     = cfg.Default     or ""
                local Callback    = cfg.Callback    or function() end
