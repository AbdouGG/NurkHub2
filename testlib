                end
                return TextBoxAPI
            end
 
            -- ── Dropdown ──────────────────────────────────────────────────────
            function SectionObj:AddDropdown(cfg)
                cfg = cfg or {}
                local Text     = cfg.Text     or "Dropdown"
                local Options  = cfg.Options  or {}
                local Default  = cfg.Default  or (Options[1] or "Select...")
                local Callback = cfg.Callback or function() end
 
                local selected = Default
                local open     = false
 
                local DDFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, Theme.ElementHeight),
                    BackgroundColor3 = Theme.ElementBg,
                    LayoutOrder = #ElementContainer:GetChildren(),
                    ClipsDescendants = false,
                    ZIndex = 5,
                    Parent = ElementContainer,
                })
                AddCorner(DDFrame, UDim.new(0, 6))
                AddStroke(DDFrame, Theme.Border, 1)
 
                local Header = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, Theme.ElementHeight),
                    BackgroundTransparency = 1,
                    Text = "",
                    ZIndex = 6,
                    Parent = DDFrame,
                })
 
                Create("TextLabel", {
                    Size = UDim2.new(1, -16, 1, 0),
                    Position = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text = Text,
                    TextColor3 = Theme.TextPrimary,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                    Parent = Header,
                })
 
                local SelectedLabel = Create("TextLabel", {
                    Size = UDim2.new(0, 100, 1, 0),
                    Position = UDim2.new(1, -120, 0, 0),
                    BackgroundTransparency = 1,
                    Text = selected,
                    TextColor3 = Theme.TextSecondary,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 6,
                    Parent = Header,
                })
 
                local Arrow = Create("TextLabel", {
                    Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -26, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "⌄",
                    TextColor3 = Theme.TextMuted,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    ZIndex = 6,
                    Parent = Header,
                })
 
                -- Dropdown List
                local ListHeight = math.min(#Options, 5) * 30
                local DropList = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 0, Theme.ElementHeight + 4),
                    BackgroundColor3 = Theme.DropdownBg,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    ZIndex = 10,
                    Visible = false,
                    Parent = DDFrame,
                })
                AddCorner(DropList, UDim.new(0, 6))
                AddStroke(DropList, Theme.Border, 1)
 
                local DropScroll = Create("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = Color3.fromRGB(80, 80, 80),
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ZIndex = 10,
                    Parent = DropList,
                })
                AddPadding(DropScroll, 4, 6, 4, 6)
                Create("UIListLayout", {
                    Padding = UDim.new(0, 3),
                    Parent = DropScroll,
                })
 
                for _, opt in ipairs(Options) do
                    local Item = Create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = Theme.DropdownItem,
                        Text = opt,
                        TextColor3 = opt == selected and Theme.TextPrimary or Theme.TextSecondary,
                        TextSize = 12,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 11,
                        Parent = DropScroll,
                    })
                    AddCorner(Item, UDim.new(0, 4))
                    AddPadding(Item, 0, 0, 0, 8)
 
                    Item.MouseEnter:Connect(function()
                        FastTween(Item, { BackgroundColor3 = Theme.DropdownHover }, 0.1)
                    end)
                    Item.MouseLeave:Connect(function()
                        FastTween(Item, { BackgroundColor3 = Theme.DropdownItem }, 0.1)
                    end)
                    Item.MouseButton1Click:Connect(function()
                        selected = opt
                        SelectedLabel.Text = opt
                        -- close
                        open = false
                        FastTween(DropList, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
                        task.delay(0.15, function() DropList.Visible = false end)
                        FastTween(Arrow, { Rotation = 0 }, 0.15)
                        -- update item colors
                        for _, c in ipairs(DropScroll:GetChildren()) do
                            if c:IsA("TextButton") then
                                c.TextColor3 = c.Text == selected and Theme.TextPrimary or Theme.TextSecondary
                            end
                        end
                        local ok, err = pcall(Callback, opt)
                        if not ok then warn("[NexusUI] Dropdown Callback Error: " .. tostring(err)) end
                    end)
                end
 
                Header.MouseEnter:Connect(function()
                    FastTween(DDFrame, { BackgroundColor3 = Theme.ElementHover }, 0.12)
                end)
                Header.MouseLeave:Connect(function()
                    FastTween(DDFrame, { BackgroundColor3 = Theme.ElementBg }, 0.12)
                end)
                Header.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        DropList.Visible = true
                        DropList.Size = UDim2.new(1, 0, 0, 0)
                        FastTween(DropList, { Size = UDim2.new(1, 0, 0, ListHeight + 8) }, 0.15)
                        FastTween(Arrow, { Rotation = 180 }, 0.15)
                    else
                        FastTween(DropList, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
                        task.delay(0.15, function() DropList.Visible = false end)
                        FastTween(Arrow, { Rotation = 0 }, 0.15)
                    end
                end)
 
                local DropAPI = {}
                function DropAPI:Set(val)
                    if table.find(Options, val) then
                        selected = val
                        SelectedLabel.Text = val
                        for _, c in ipairs(DropScroll:GetChildren()) do
                            if c:IsA("TextButton") then
                                c.TextColor3 = c.Text == selected and Theme.TextPrimary or Theme.TextSecondary
                            end
                        end
                    end
                end
                function DropAPI:Get()
                    return selected
                end
                return DropAPI
            end
 
            -- ── Label ─────────────────────────────────────────────────────────
            function SectionObj:AddLabel(cfg)
                cfg = cfg or {}
                local Text  = cfg.Text  or "Label"
                local Color = cfg.Color or Theme.TextSecondary
 
                local LblFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundTransparency = 1,
                    LayoutOrder = #ElementContainer:GetChildren(),
                    Parent = ElementContainer,
                })
 
                local Lbl = Create("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = Text,
                    TextColor3 = Color,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    Parent = LblFrame,
                })
 
                local LabelAPI = {}
                function LabelAPI:Set(t) Lbl.Text = t end
                function LabelAPI:SetColor(c) Lbl.TextColor3 = c end
                return LabelAPI
            end
 
            -- ── Separator ─────────────────────────────────────────────────────
            function SectionObj:AddSeparator()
                Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Theme.Border,
                    BorderSizePixel = 0,
                    LayoutOrder = #ElementContainer:GetChildren(),
                    Parent = ElementContainer,
                })
            end
 
            return SectionObj
        end
 
        return Tab
    end
 
    -- Animate window in
    MainFrame.BackgroundTransparency = 1
    MainFrame.Size = UDim2.new(0, Theme.WindowWidth, 0, 0)
    FastTween(MainFrame, {
        BackgroundTransparency = 0,
        Size = UDim2.new(0, Theme.WindowWidth, 0, Theme.WindowHeight)
    }, 0.25)
 
    return Window
end
 
-- ─── Notification System ──────────────────────────────────────────────────────
function NexusUI:Notify(cfg)
    cfg = cfg or {}
    local Title    = cfg.Title    or "Notification"
    local Message  = cfg.Message  or ""
    local Duration = cfg.Duration or 4
 
    local ScreenGui = CoreGui:FindFirstChild("NexusUI_GUI")
    if not ScreenGui then return end
 
    local NotifHolder = ScreenGui:FindFirstChild("NotifHolder")
    if not NotifHolder then
        NotifHolder = Create("Frame", {
            Name = "NotifHolder",
            Size = UDim2.new(0, 280, 1, 0),
            Position = UDim2.new(1, -290, 0, 0),
            BackgroundTransparency = 1,
            Parent = ScreenGui,
        })
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            Padding = UDim.new(0, 8),
            Parent = NotifHolder,
        })
        AddPadding(NotifHolder, 0, 0, 16, 0)
    end
 
    local Notif = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 70),
        BackgroundColor3 = Color3.fromRGB(22, 22, 22),
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Position = UDim2.new(1, 10, 0, 0),
        Parent = NotifHolder,
    })
    AddCorner(Notif, UDim.new(0, 8))
    AddStroke(Notif, Theme.Border, 1)
    AddPadding(Notif, 10, 14, 10, 14)
 
    Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Text = Title,
        TextColor3 = Theme.TextPrimary,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Notif,
    })
 
    Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 30),
        Position = UDim2.new(0, 0, 0, 22),
        BackgroundTransparency = 1,
        Text = Message,
        TextColor3 = Theme.TextSecondary,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = Notif,
    })
 
    -- Progress bar
    local ProgBg = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = Theme.SliderTrack,
        BorderSizePixel = 0,
        Parent = Notif,
    })
    AddCorner(ProgBg, UDim.new(0, 1))
    local Prog = Create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = ProgBg,
    })
    AddCorner(Prog, UDim.new(0, 1))
 
    FastTween(Notif, { Position = UDim2.new(0, 0, 0, 0) }, 0.25)
    Tween(Prog, TweenInfo.new(Duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })
 
    task.delay(Duration, function()
        FastTween(Notif, { BackgroundTransparency = 1 }, 0.3)
        task.delay(0.3, function() Notif:Destroy() end)
    end)
end
 
-- ─── Keybind for toggle visibility ───────────────────────────────────────────
function NexusUI:SetToggleKey(key)
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == key then
            local gui = CoreGui:FindFirstChild("NexusUI_GUI")
            if gui then
                local main = gui:FindFirstChild("MainFrame")
                if main then
                    main.Visible = not main.Visible
                end
            end
        end
    end)
end
 
return NexusUI
