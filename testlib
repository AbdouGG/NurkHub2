----------------------------------------------------------------
-- Utility:  Better Hover Effect (with support for ImageLabels)
----------------------------------------------------------------
local function createHoverEffect(button)
    local originalColor

    -- Check if it's an ImageLabel or a TextButton/Frame
    if button:IsA("ImageLabel") then
        originalColor = button.ImageColor3
    else  -- Assume TextButton or Frame
        originalColor = button.BackgroundColor3
    end

    button.MouseEnter:Connect(function()
        if button:IsA("ImageLabel") then
             TweenService:Create(button, TWEEN_INFO, {ImageColor3 = COLORS.HOVER}):Play()
        else
            TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = COLORS.HOVER}):Play()
        end
    end)

    button.MouseLeave:Connect(function()
        if button:IsA("ImageLabel") then
            TweenService:Create(button, TWEEN_INFO, {ImageColor3 = originalColor}):Play()
        else
             TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = originalColor}):Play()
        end
    end)
end

