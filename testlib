                SliderBackground.Position = UDim2.new(0.05, 0, 0.75, -3)  -- Centered
                SliderBackground.BackgroundColor3 = COLORS.BACKGROUND
                local UICorner_2 = Instance.new("UICorner", SliderBackground)
                UICorner_2.CornerRadius = UDim.new(1, 0)  -- Fully rounded corners

                local SliderFill = Instance.new("Frame", SliderBackground)
                SliderFill.Name = "SliderFill"
                SliderFill.BackgroundColor3 = COLORS.ACCENT
                local UICorner_3 = Instance.new("UICorner", SliderFill)
                UICorner_3.CornerRadius = UDim.new(1, 0) -- Fully rounded

                local SliderValue = Instance.new("TextLabel", SliderFrame)
                SliderValue.Name = "SliderValue"
                SliderValue.Size = UDim2.new(0, math.floor(0.15 * 320), 0, 20)  -- For value display
                SliderValue.Position = UDim2.new(1, -math.floor(0.15 * 320), 0, 0)
                SliderValue.BackgroundTransparency = 1
                SliderValue.Text = tostring(default)
                SliderValue.TextColor3 = COLORS.TEXT
                SliderValue.TextSize = 15
                SliderValue.Font = Enum.Font.GothamSemibold

                local SliderButton = Instance.new("ImageButton", SliderBackground) -- Use ImageButton
                SliderButton.Name = "SliderButton"
                SliderButton.Size = UDim2.new(0, 12, 0, 12)  -- Small, circular thumb
                SliderButton.BackgroundTransparency = 1
                SliderButton.Image = "rbxassetid://1353326629"   -- Circle image
                SliderButton.ImageColor3 = COLORS.SLIDER_THUMB
                SliderButton.ZIndex = 2  -- Ensure thumb is above the fill

                local function updateSlider(input)
                    local pos = input.Position
                    local relativePos = (pos.X - SliderBackground.AbsolutePosition.X) / SliderBackground.AbsoluteSize.X
                    relativePos = math.clamp(relativePos, 0, 1)
                    local value = min + (max - min) * relativePos
                    value = math.floor(value + 0.5)  -- Round to nearest integer
                    SliderValue.Text = tostring(value)
                    SliderFill.Size = UDim2.new(relativePos, 0, 1, 0)
					local ThumbPos = (relativePos * SliderBackground.AbsoluteSize.X) - (SliderButton.AbsoluteSize.X/2)
                    SliderButton.Position = UDim2.new(0,ThumbPos,0.5,-6)
                    callback(value)
                end

                -- Set initial position of fill and thumb
                local defaultRelative = (default - min) / (max - min)
                SliderFill.Size = UDim2.new(defaultRelative, 0, 1, 0)
				local ThumbPos = (defaultRelative * SliderBackground.AbsoluteSize.X) - (SliderButton.AbsoluteSize.X/2)
                SliderButton.Position = UDim2.new(0,ThumbPos,0.5,-6)
                
                local sliding = false
                SliderButton.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        updateSlider(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateSlider(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
                createHoverEffect(SliderFrame)
                return SliderFrame
            end


