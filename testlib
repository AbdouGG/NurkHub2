                    Parent = ElementContainer,
                })
                AddCorner(TBFrame, UDim.new(0, 6))
                AddStroke(TBFrame, Theme.Border, 1)
 
                Create("TextLabel", {
                    Size = UDim2.new(1, -16, 0, 20),
