                    local targetPosition = toggled and UDim2.new(0.55, 0, 0.1, 0) or UDim2.new(0.05, 0, 0.1, 0)
                    TweenService:Create(ToggleButton, TWEEN_INFO, {BackgroundColor3 = targetColor}):Play()
                    TweenService:Create(ToggleInner, TWEEN_INFO, {Position = targetPosition}):Play()
                    callback(toggled)
                end)
                createHoverEffect(ToggleFrame)
                return ToggleFrame
            end

