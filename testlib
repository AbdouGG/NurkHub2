                TextXAlignment = Enum.TextXAlignment.Right
            })

            local Tracker = Create("TextButton", {
                Parent = SliderFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 30),
                Size = UDim2.new(1, -24, 0, 6),
                Text = "",
                AutoButtonColor = false
            })

            local TrackBg = Create("Frame", {
                Parent = Tracker,
                BackgroundColor3 = Color3.fromRGB(50, 50, 60),
                Size = UDim2.new(1, 0, 1, 0)
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = TrackBg})

            local Fill = Create("Frame", {
                Parent = TrackBg,
                BackgroundColor3 = Theme.AccentStart,
                Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})
            ApplyGradient(Fill)

            local Knob = Create("Frame", {
                Parent = Fill,
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Position = UDim2.new(1, -5, 0.5, -5),
                Size = UDim2.new(0, 10, 0, 10),
                ZIndex = 2
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Knob})
            
            local Dragging = false
            local function Update(input)
                local SizeX = Tracker.AbsoluteSize.X
                local PositionX = Tracker.AbsolutePosition.X
                local InputX = input.Position.X
                local Percent = math.clamp((InputX - PositionX) / SizeX, 0, 1)
                local Value = math.floor(min + ((max - min) * Percent))
                
                Fill.Size = UDim2.new(Percent, 0, 1, 0)
                ValueLabel.Text = tostring(Value)
                callback(Value)
            end

            Tracker.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = true
                    Update(input)
                    TweenService:Create(Knob, TweenInfo.new(0.1), {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -7, 0.5, -7)}):Play()
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                 if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = false
                    TweenService:Create(Knob, TweenInfo.new(0.1), {Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(1, -5, 0.5, -5)}):Play()
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input)
                end
            end)
        end

        -- DROPDOWN
        function Elements:Dropdown(options)
            local text = options.Text or "Dropdown"
            local list = options.Options or {}
            local callback = options.Callback or function() end
            
            local IsOpen = false
            local BaseHeight = 42

            local DropFrame = Create("TextButton", {
                Parent = Page,
                BackgroundColor3 = Theme.Element,
                Size = UDim2.new(1, 0, 0, BaseHeight),
                AutoButtonColor = false,
                Text = "",
                ClipsDescendants = true
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = DropFrame})
            local Stroke = Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = DropFrame})

            local Title = Create("TextLabel", {
                Parent = DropFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 0),
                Size = UDim2.new(1, -40, 0, BaseHeight),
                Font = Enum.Font.GothamBold,
                Text = text,
                TextColor3 = Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left
            })
            
            local Arrow = Create("ImageLabel", {
                Parent = DropFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -30, 0.5, -10),
                Size = UDim2.new(0, 20, 0, 20),
                Image = "rbxassetid://6031091004",
                ImageColor3 = Theme.TextSub
            })

            local ItemHolder = Create("Frame", {
                Parent = DropFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, BaseHeight),
                Size = UDim2.new(1, 0, 0, 0)
            })
            
            local ListLayout = Create("UIListLayout", {Parent = ItemHolder, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)})
            Create("UIPadding", {Parent = ItemHolder, PaddingTop = UDim.new(0, 5), PaddingLeft = UDim.new(0,5), PaddingRight=UDim.new(0,5), PaddingBottom=UDim.new(0,5)})

            local function Refresh()
                for _, v in pairs(ItemHolder:GetChildren()) do
                    if v:IsA("TextButton") then v:Destroy() end
                end
                
                for _, opt in pairs(list) do
                    local Item = Create("TextButton", {
                        Parent = ItemHolder,
                        BackgroundColor3 = Theme.Main,
                        Size = UDim2.new(1, 0, 0, 30),
                        Text = "  " .. opt,
                        Font = Enum.Font.GothamSemibold,
                        TextColor3 = Theme.TextSub,
                        TextSize = 13,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        AutoButtonColor = false
                    })
                    Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = Item})
                    
                    Item.MouseEnter:Connect(function()
                        TweenService:Create(Item, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover, TextColor3 = Theme.AccentStart}):Play()
                    end)
                    Item.MouseLeave:Connect(function()
                        TweenService:Create(Item, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Main, TextColor3 = Theme.TextSub}):Play()
                    end)
                    
                    Item.MouseButton1Click:Connect(function()
                        Title.Text = text .. ": " .. opt
                        callback(opt)
                        IsOpen = false
                        TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, BaseHeight)}):Play()
                        TweenService:Create(Arrow, TweenInfo.new(0.2), {Rotation = 0}):Play()
                        TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Theme.Stroke}):Play()
                    end)
                end
            end
            Refresh()

            DropFrame.MouseButton1Click:Connect(function()
                IsOpen = not IsOpen
                if IsOpen then
                    local contentSize = ListLayout.AbsoluteContentSize.Y + BaseHeight + 10
                    TweenService:Create(DropFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, contentSize)}):Play()
                    TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 180}):Play()
                    TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Theme.AccentStart}):Play()
                else
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, BaseHeight)}):Play()
                    TweenService:Create(Arrow, TweenInfo.new(0.2), {Rotation = 0}):Play()
                    TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Theme.Stroke}):Play()
                end
            end)
        end

        return Elements
    end

    return WindowObj
end

return Library
