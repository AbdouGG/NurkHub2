-- Library Definition
-----------------------------------------------------------------
function Library:CreateWindow(title)
    -- Main window frame
    local WindowFrame = Instance.new("Frame")
    WindowFrame.Name = "WindowFrame"
    WindowFrame.Size = UDim2.new(0, 450, 0, 350)
    WindowFrame.Position = UDim2.new(0.5, -225, 0.5, -175)
    WindowFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    WindowFrame.BorderSizePixel = 0
    WindowFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    WindowFrame.Parent = ScreenGui
    WindowFrame.Active = true

    -- Gradient background
    local WinGradient = Instance.new("UIGradient")
    WinGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(45, 45, 45)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 30, 30))
    })
    WinGradient.Rotation = 90
    WinGradient.Parent = WindowFrame

    local WinCorner = Instance.new("UICorner")
    WinCorner.CornerRadius = UDim.new(0, 10)
    WinCorner.Parent = WindowFrame

    -- Title bar (display only; background is draggable)
    local TitleBar = Instance.new("Frame")
    TitleBar.Name = "TitleBar"
    TitleBar.Size = UDim2.new(1, 0, 0, 35)
    TitleBar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    TitleBar.BorderSizePixel = 0
    TitleBar.Parent = WindowFrame

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -10, 1, 0)
    TitleLabel.Position = UDim2.new(0, 5, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = tostring(title)
    TitleLabel.TextColor3 = Color3.new(1, 1, 1)
    TitleLabel.Font = Enum.Font.GothamSemibold
    TitleLabel.TextSize = 20
    TitleLabel.Parent = TitleBar

    -- Subtle gradient on the TitleBar
    local TitleGradient = Instance.new("UIGradient")
    TitleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 30, 30)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 20, 20))
    })
    TitleGradient.Rotation = 90
    TitleGradient.Parent = TitleBar

    -- Container for sections with scrolling
    local SectionContainer = Instance.new("ScrollingFrame")
    SectionContainer.Name = "SectionContainer"
    SectionContainer.Size = UDim2.new(1, 0, 1, -35)
    SectionContainer.Position = UDim2.new(0, 0, 0, 35)
    SectionContainer.BackgroundTransparency = 1
    SectionContainer.ScrollBarThickness = 6
    SectionContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    SectionContainer.BorderSizePixel = 0
    SectionContainer.Parent = WindowFrame

    local SectionLayout = Instance.new("UIListLayout")
    SectionLayout.Padding = UDim.new(0, 8)
    SectionLayout.SortOrder = Enum.SortOrder.LayoutOrder
    SectionLayout.Parent = SectionContainer

    SectionLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        SectionContainer.CanvasSize = UDim2.new(0, 0, 0, SectionLayout.AbsoluteContentSize.Y)
    end)

    -- Make the entire window draggable
    MakeDraggable(WindowFrame, WindowFrame)

    local Window = {}

    -----------------------------------------------------------------
    -- CreateSection
    -----------------------------------------------------------------
    function Window:CreateSection(sectionTitle)
        local Section = {}

        local SectionFrame = Instance.new("Frame")
        SectionFrame.Name = "Section_" .. tostring(sectionTitle)
        SectionFrame.Size = UDim2.new(1, -16, 0, 0)
        SectionFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        SectionFrame.BorderSizePixel = 0
        SectionFrame.Parent = SectionContainer

        local SectionUICorner = Instance.new("UICorner")
        SectionUICorner.CornerRadius = UDim.new(0, 6)
        SectionUICorner.Parent = SectionFrame

        local SectionLayout = Instance.new("UIListLayout")
        SectionLayout.Padding = UDim.new(0, 8)
        SectionLayout.SortOrder = Enum.SortOrder.LayoutOrder
        SectionLayout.Parent = SectionFrame

        SectionLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            SectionFrame.Size = UDim2.new(1, -16, 0, SectionLayout.AbsoluteContentSize.Y + 10)
        end)

        local TitleLabel = Instance.new("TextLabel")
        TitleLabel.Name = "SectionTitle"
        TitleLabel.Size = UDim2.new(1, -10, 0, 30)
        TitleLabel.BackgroundTransparency = 1
        TitleLabel.Text = tostring(sectionTitle)
        TitleLabel.TextColor3 = Color3.new(1, 1, 1)
        TitleLabel.Font = Enum.Font.GothamBold
        TitleLabel.TextSize = 18
        TitleLabel.Parent = SectionFrame

        local ElementContainer = Instance.new("Frame")
        ElementContainer.Name = "ElementContainer"
        ElementContainer.Size = UDim2.new(1, -10, 0, 0)
        ElementContainer.BackgroundTransparency = 1
        ElementContainer.Parent = SectionFrame

        local ElementLayout = Instance.new("UIListLayout")
        ElementLayout.Padding = UDim.new(0, 6)
        ElementLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ElementLayout.Parent = ElementContainer

        ElementLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            ElementContainer.Size = UDim2.new(1, -10, 0, ElementLayout.AbsoluteContentSize.Y)
        end)

        -------------------------------------------
        -- Button with hover tween effect
        -------------------------------------------
        function Section:AddButton(name, callback)
            local Button = Instance.new("TextButton")
            Button.Name = "Button_" .. tostring(name)
            Button.Size = UDim2.new(1, 0, 0, 35)
            Button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            Button.Text = tostring(name)
            Button.TextColor3 = Color3.new(1, 1, 1)
            Button.Font = Enum.Font.GothamSemibold
            Button.TextSize = 17
            Button.Parent = ElementContainer
            Button.AutoButtonColor = false

            local ButtonCorner = Instance.new("UICorner")
            ButtonCorner.CornerRadius = UDim.new(0, 6)
            ButtonCorner.Parent = Button

            -- Hover effect
            Button.MouseEnter:Connect(function()
                TweenService:Create(Button, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                }):Play()
            end)
            Button.MouseLeave:Connect(function()
                TweenService:Create(Button, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                }):Play()
            end)

            Button.MouseButton1Click:Connect(function()
                if callback then
                    callback()
                end
            end)
        end

        -------------------------------------------
        -- Label with update functionality
        -------------------------------------------
        function Section:AddLabel(name)
            local Label = Instance.new("TextLabel")
            Label.Name = "Label_" .. tostring(name)
            Label.Size = UDim2.new(1, 0, 0, 28)
            Label.BackgroundTransparency = 1
            Label.Text = tostring(name)
            Label.TextColor3 = Color3.new(1, 1, 1)
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 16
            Label.Parent = ElementContainer

            return {
                Update = function(newText)
                    Label.Text = tostring(newText)
                end
            }
        end

        -------------------------------------------
        -- Toggle Button
        -------------------------------------------
        function Section:AddToggle(name, callback)
            local ToggleFrame = Instance.new("Frame")
            ToggleFrame.Name = "Toggle_" .. tostring(name)
            ToggleFrame.Size = UDim2.new(1, 0, 0, 35)
            ToggleFrame.BackgroundTransparency = 1
            ToggleFrame.Parent = ElementContainer

            local ToggleLabel = Instance.new("TextLabel")
            ToggleLabel.Name = "ToggleLabel_" .. tostring(name)
            ToggleLabel.Size = UDim2.new(0.65, 0, 1, 0)
            ToggleLabel.BackgroundTransparency = 1
            ToggleLabel.Text = tostring(name)
            ToggleLabel.TextColor3 = Color3.new(1, 1, 1)
            ToggleLabel.Font = Enum.Font.Gotham
            ToggleLabel.TextSize = 16
            ToggleLabel.Parent = ToggleFrame

            local ToggleButton = Instance.new("TextButton")
            ToggleButton.Name = "ToggleButton_" .. tostring(name)
            ToggleButton.Size = UDim2.new(0.3, -5, 0.6, 0)
            ToggleButton.Position = UDim2.new(0.65, 5, 0.2, 0)
            ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            ToggleButton.Text = "Off"
            ToggleButton.TextColor3 = Color3.new(1, 1, 1)
            ToggleButton.Font = Enum.Font.GothamSemibold
            ToggleButton.TextSize = 16
            ToggleButton.Parent = ToggleFrame

            local ToggleCorner = Instance.new("UICorner")
            ToggleCorner.CornerRadius = UDim.new(0, 6)
            ToggleCorner.Parent = ToggleButton

            local toggled = false
            ToggleButton.MouseButton1Click:Connect(function()
                toggled = not toggled
                if toggled then
                    ToggleButton.Text = "On"
                    TweenService:Create(ToggleButton, TweenInfo.new(0.15), {
                        BackgroundColor3 = Color3.fromRGB(80, 200, 120)
                    }):Play()
                else
                    ToggleButton.Text = "Off"
                    TweenService:Create(ToggleButton, TweenInfo.new(0.15), {
                        BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                    }):Play()
                end
                if callback then
                    callback(toggled)
                end
            end)
        end

        -------------------------------------------
        -- Slider (blocks window-drag while in use)
        -------------------------------------------
        function Section:AddSlider(name, min, max, callback)
            local SliderFrame = Instance.new("Frame")
            SliderFrame.Name = "Slider_" .. tostring(name)
            SliderFrame.Size = UDim2.new(1, 0, 0, 45)
            SliderFrame.BackgroundTransparency = 1
            SliderFrame.Parent = ElementContainer

            local SliderLabel = Instance.new("TextLabel")
            SliderLabel.Name = "SliderLabel_" .. tostring(name)
            SliderLabel.Size = UDim2.new(1, 0, 0, 20)
            SliderLabel.BackgroundTransparency = 1
            SliderLabel.Text = tostring(name) .. ": " .. min
            SliderLabel.TextColor3 = Color3.new(1, 1, 1)
            SliderLabel.Font = Enum.Font.Gotham
            SliderLabel.TextSize = 16
            SliderLabel.Parent = SliderFrame

            local SliderBar = Instance.new("Frame")
            SliderBar.Name = "SliderBar_" .. tostring(name)
            SliderBar.Size = UDim2.new(1, 0, 0, 10)
            SliderBar.Position = UDim2.new(0, 0, 0, 25)
            SliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            SliderBar.Parent = SliderFrame

            local SliderFill = Instance.new("Frame")
            SliderFill.Name = "SliderFill_" .. tostring(name)
            SliderFill.Size = UDim2.new(0, 0, 1, 0)
            SliderFill.BackgroundColor3 = Color3.fromRGB(100, 100, 255)
            SliderFill.Parent = SliderBar

            local BarCorner = Instance.new("UICorner")
            BarCorner.CornerRadius = UDim.new(0, 6)
            BarCorner.Parent = SliderBar

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(0, 6)
            FillCorner.Parent = SliderFill

            local dragging = false
            local value = min

            local function updateSlider(inputX)
                local relative = math.clamp(
                    (inputX - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 
                    0, 
                    1
                )
                value = min + (max - min) * relative
                SliderFill.Size = UDim2.new(relative, 0, 1, 0)
                SliderLabel.Text = tostring(name) .. ": " .. math.floor(value)
                if callback then
                    callback(value)
                end
            end

            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Library.BlockDrag = true  -- block window dragging
                    dragging = true
                    updateSlider(input.Position.X)
                end
            end)
            SliderBar.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    Library.BlockDrag = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    updateSlider(input.Position.X)
                end
            end)
        end

        -------------------------------------------
        -- Dropdown (improved design, smooth expand)
        -------------------------------------------
        function Section:AddDropdown(name, options, callback)
            local DropdownFrame = Instance.new("Frame")
            DropdownFrame.Name = "Dropdown_" .. tostring(name)
            DropdownFrame.Size = UDim2.new(1, 0, 0, 35)
            DropdownFrame.BackgroundTransparency = 1
            DropdownFrame.Parent = ElementContainer

            local DropdownLabel = Instance.new("TextLabel")
            DropdownLabel.Name = "DropdownLabel_" .. tostring(name)
            DropdownLabel.Size = UDim2.new(0.65, 0, 1, 0)
            DropdownLabel.BackgroundTransparency = 1
            DropdownLabel.Text = tostring(name)
            DropdownLabel.TextColor3 = Color3.new(1, 1, 1)
            DropdownLabel.Font = Enum.Font.Gotham
            DropdownLabel.TextSize = 16
            DropdownLabel.Parent = DropdownFrame

            local DropdownButton = Instance.new("TextButton")
            DropdownButton.Name = "DropdownButton_" .. tostring(name)
            DropdownButton.Size = UDim2.new(0.3, -5, 0.8, 0)
            DropdownButton.Position = UDim2.new(0.65, 5, 0.1, 0)
            DropdownButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            DropdownButton.Text = "Select"
            DropdownButton.TextColor3 = Color3.new(1, 1, 1)
            DropdownButton.Font = Enum.Font.GothamSemibold
            DropdownButton.TextSize = 16
            DropdownButton.Parent = DropdownFrame
            DropdownButton.AutoButtonColor = false

            local DB_Corner = Instance.new("UICorner")
            DB_Corner.CornerRadius = UDim.new(0, 6)
            DB_Corner.Parent = DropdownButton

            -- ScrollingFrame for the dropdown list
            local DropdownList = Instance.new("ScrollingFrame")
            DropdownList.Name = "DropdownList_" .. tostring(name)
            DropdownList.Size = UDim2.new(1, 0, 0, 0)
            DropdownList.Position = UDim2.new(0, 0, 1, 0)
            DropdownList.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            DropdownList.BorderSizePixel = 0
            DropdownList.Visible = false
            DropdownList.Parent = DropdownButton

            DropdownList.ScrollingEnabled = true
            DropdownList.ScrollBarThickness = 4
            DropdownList.AutomaticCanvasSize = Enum.AutomaticSize.Y

            -- Rounded corners, stroke, gradient for the dropdown
            local DropListCorner = Instance.new("UICorner")
            DropListCorner.CornerRadius = UDim.new(0, 6)
            DropListCorner.Parent = DropdownList

            local DropListStroke = Instance.new("UIStroke")
            DropListStroke.Thickness = 1
            DropListStroke.Color = Color3.fromRGB(80, 80, 80)
            DropListStroke.Parent = DropdownList

            local DropListGradient = Instance.new("UIGradient")
            DropListGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 60, 60)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 50))
            })
            DropListGradient.Rotation = 90
            DropListGradient.Parent = DropdownList

            -- Prevent window-drag while scrolling/clicking inside dropdown
            DropdownList.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Library.BlockDrag = true
                end
            end)
            DropdownList.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Library.BlockDrag = false
                end
            end)

            local ListLayout = Instance.new("UIListLayout")
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Padding = UDim.new(0, 2)
            ListLayout.Parent = DropdownList

            local expanded = false
            local maxHeight = 200 -- max height before scrolling

            DropdownButton.MouseButton1Click:Connect(function()
                expanded = not expanded

                if expanded then
                    -- Create option buttons
                    for _, option in ipairs(options) do
                        local OptionButton = Instance.new("TextButton")
                        OptionButton.Name = "Option_" .. tostring(option)
                        OptionButton.Size = UDim2.new(1, 0, 0, 28)
                        OptionButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                        OptionButton.Text = tostring(option)
                        OptionButton.TextColor3 = Color3.new(1, 1, 1)
                        OptionButton.Font = Enum.Font.Gotham
                        OptionButton.TextSize = 16
                        OptionButton.AutoButtonColor = false
                        OptionButton.Parent = DropdownList

                        OptionButton.MouseEnter:Connect(function()
                            TweenService:Create(OptionButton, TweenInfo.new(0.2), {
                                BackgroundColor3 = Color3.fromRGB(70, 70, 70)
                            }):Play()
                        end)
                        OptionButton.MouseLeave:Connect(function()
                            TweenService:Create(OptionButton, TweenInfo.new(0.2), {
                                BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                            }):Play()
                        end)

                        OptionButton.MouseButton1Click:Connect(function()
                            DropdownButton.Text = tostring(option)
                            expanded = false
                            -- Tween dropdown to height 0
                            TweenService:Create(DropdownList, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
                                Size = UDim2.new(1, 0, 0, 0)
                            }):Play()
                            wait(0.2)
                            DropdownList.Visible = false
                            -- Clear old option buttons
                            for _, child in ipairs(DropdownList:GetChildren()) do
                                if child:IsA("TextButton") then
                                    child:Destroy()
                                end
                            end
                            if callback then
                                callback(option)
                            end
                        end)
                    end

                    -- Calculate final height
                    local desiredHeight = #options * 28
                    if desiredHeight > maxHeight then
                        desiredHeight = maxHeight
                    end

                    DropdownList.Visible = true
                    TweenService:Create(DropdownList, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
                        Size = UDim2.new(1, 0, 0, desiredHeight)
                    }):Play()
                else
                    -- Collapse
                    TweenService:Create(DropdownList, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
                        Size = UDim2.new(1, 0, 0, 0)
                    }):Play()
                    wait(0.2)
                    DropdownList.Visible = false
                    -- Clear old options
                    for _, child in ipairs(DropdownList:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end
                end
            end)
        end

        return Section
    end

    -- Return a small proxy that lets you do window:CreateSection(...)
    return setmetatable({}, {
        __index = function(_, key)
            if key == "CreateSection" then
                return function(...)
                    return Window:CreateSection(...)
                end
            end
        end
    })
end

return Library
