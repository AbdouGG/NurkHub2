    else
        screenGui.Parent = game:GetService("CoreGui")
    end
    
    local mainFrame = create("Frame", {
        Name = "MainFrame",
        Parent = screenGui,
        BackgroundColor3 = colors.background,
        Position = UDim2.new(0.5, -200, 0.5, -150),
        Size = UDim2.new(0, 400, 0, 350),
        AnchorPoint = Vector2.new(0.5, 0.5),
