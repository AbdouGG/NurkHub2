        CornerRadius = UDim.new(0, 8),
        Parent = mainFrame
    })
    
    create("UIStroke", {
        Parent = mainFrame,
        Color = Color3.fromRGB(60, 60, 70),
        Thickness = 2
    })
    
    local titleBar = create("Frame", {
        Name = "TitleBar",
        Parent = mainFrame,
        BackgroundColor3 = colors.secondary,
        Size = UDim2.new(1, 0, 0, 40),
        ZIndex = 2
    })
    
    create("UICorner", {
        CornerRadius = UDim.new(0, 8),
        Parent = titleBar
    })
    
    create("UIStroke", {
        Parent = titleBar,
