--[[
    Orion UI Library
    Version: 1.0.0
    Author: YourName/AI
    Description: A modern, aesthetic UI library for Roblox executors.
]]

local OrionLib = {}
OrionLib.Name = "Orion UI"
OrionLib.Version = "1.0.0"

-- // Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- // Configuration
OrionLib.Config = {
    AccentColor = Color3.fromRGB(0, 122, 255), -- A nice blue
    BackgroundColor = Color3.fromRGB(30, 30, 30),
    LightBackgroundColor = Color3.fromRGB(45, 45, 45),
    TextColor = Color3.fromRGB(240, 240, 240),
    PlaceholderColor = Color3.fromRGB(150, 150, 150),
    Font = Enum.Font.GothamSemibold,
    SmallFont = Enum.Font.Gotham,
    ElementHeight = 30, -- Offset pixels
    ElementSpacing = 5, -- Offset pixels
    CornerRadius = 6,   -- Offset pixels
    MainPanelWidth = 0.3, -- Scale (30% of screen width)
    MainPanelMinWidth = 280, -- Minimum width in pixels
    MainPanelHeight = 0.5, -- Scale (50% of screen height)
    MainPanelMinHeight = 300, -- Minimum height in pixels
    ToggleKey = Enum.KeyCode.RightControl -- Key to toggle UI visibility
}

-- // State
OrionLib.State = {
    Initialized = false,
    Visible = true,
    Dragging = false,
    DragStart = nil,
    FrameStart = nil,
    CurrentSection = nil,
    ActiveDropdown = nil
}

-- // UI Elements (will be populated in Init)
OrionLib.Elements = {
    ScreenGui = nil,
    ToggleGuiButton = nil,
    MainPanel = nil,
    TitleBar = nil,
    TitleLabel = nil,
    CloseButton = nil, -- For internal close, works same as toggle
    ContentFrame = nil,
    ContentListLayout = nil
}

-- // Private Helper Functions
local function Create(instanceType, properties)
    local inst = Instance.new(instanceType)
    for prop, val in pairs(properties or {}) do
        inst[prop] = val
    end
    return inst
end

local function ApplyCorner(parent)
    Create("UICorner", {
        CornerRadius = UDim.new(0, OrionLib.Config.CornerRadius),
        Parent = parent
    })
end

local function ApplyStroke(parent, color, thickness)
    Create("UIStroke", {
        Color = color or OrionLib.Config.AccentColor,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent
    })
end

local function GetScaledSize(widthScale, heightScale, widthOffset, heightOffset)
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local w = math.max(OrionLib.Config.MainPanelMinWidth, viewportSize.X * widthScale)
    local h = math.max(OrionLib.Config.MainPanelMinHeight, viewportSize.Y * heightScale)
    return UDim2.new(0, w + (widthOffset or 0), 0, h + (heightOffset or 0))
end

local function ToggleUIVisibility()
    OrionLib.State.Visible = not OrionLib.State.Visible
    if OrionLib.Elements.MainPanel then
        OrionLib.Elements.MainPanel.Visible = OrionLib.State.Visible
    end
    if OrionLib.Elements.ToggleGuiButton then
        OrionLib.Elements.ToggleGuiButton.Text = OrionLib.State.Visible and "Hide" or "Show"
    end
end

local function CloseActiveDropdown()
    if OrionLib.State.ActiveDropdown then
        OrionLib.State.ActiveDropdown.OptionsFrame.Visible = false
        OrionLib.State.ActiveDropdown = nil
    end
end

-- // Core Initialization
function OrionLib:Init(title)
    if OrionLib.State.Initialized then
        warn(OrionLib.Name .. " is already initialized.")
        return self
    end

    title = title or OrionLib.Name

    -- ScreenGui
    OrionLib.Elements.ScreenGui = Create("ScreenGui", {
        Name = OrionLib.Name .. "Gui",
        DisplayOrder = 999, -- High display order
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        Parent = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui") or game:GetService("CoreGui")
    })

    -- Main Panel
    OrionLib.Elements.MainPanel = Create("Frame", {
        Name = "MainPanel",
        Size = GetScaledSize(OrionLib.Config.MainPanelWidth, OrionLib.Config.MainPanelHeight),
        Position = UDim2.new(0.5, 0, 0.5, 0), -- Centered
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = OrionLib.Config.BackgroundColor,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = OrionLib.State.Visible,
        Parent = OrionLib.Elements.ScreenGui
    })
    ApplyCorner(OrionLib.Elements.MainPanel)
    ApplyStroke(OrionLib.Elements.MainPanel, OrionLib.Config.LightBackgroundColor, 2)

    -- Title Bar
    OrionLib.Elements.TitleBar = Create("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        BorderSizePixel = 0,
        Parent = OrionLib.Elements.MainPanel
    })

    OrionLib.Elements.TitleLabel = Create("TextLabel", {
        Name = "TitleLabel",
        Size = UDim2.new(0.9, -35, 1, 0), -- Leave space for close button
        Position = UDim2.new(0.05, 0, 0, 0),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.Font,
        TextColor3 = OrionLib.Config.TextColor,
        Text = title,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = OrionLib.Elements.TitleBar
    })
    Create("UIPadding", {
        PaddingLeft = UDim.new(0, 10),
        Parent = OrionLib.Elements.TitleLabel
    })

    -- Close Button (acts as a toggle for the main panel)
    OrionLib.Elements.CloseButton = Create("TextButton", {
        Name = "CloseButton",
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -33, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        Font = OrionLib.Config.Font,
        Text = "X",
        TextColor3 = OrionLib.Config.TextColor,
        Parent = OrionLib.Elements.TitleBar
    })
    ApplyCorner(OrionLib.Elements.CloseButton)
    OrionLib.Elements.CloseButton.MouseEnter:Connect(function()
        TweenService:Create(OrionLib.Elements.CloseButton, TweenInfo.new(0.2), {BackgroundColor3 = OrionLib.Config.AccentColor}):Play()
    end)
    OrionLib.Elements.CloseButton.MouseLeave:Connect(function()
        TweenService:Create(OrionLib.Elements.CloseButton, TweenInfo.new(0.2), {BackgroundColor3 = OrionLib.Config.LightBackgroundColor}):Play()
    end)
    OrionLib.Elements.CloseButton.MouseButton1Click:Connect(ToggleUIVisibility)


    -- Content Frame (for scrolling)
    OrionLib.Elements.ContentFrame = Create("ScrollingFrame", {
        Name = "ContentFrame",
        Size = UDim2.new(1, -20, 1, -45), -- -20 for padding, -45 for titlebar + bottom padding
        Position = UDim2.new(0, 10, 0, 40), -- 10 padding left, 40 below titlebar
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 6,
        ScrollBarImageColor3 = OrionLib.Config.AccentColor,
        CanvasSize = UDim2.new(0,0,0,0), -- Will be updated by UIListLayout
        Parent = OrionLib.Elements.MainPanel
    })

    OrionLib.Elements.ContentListLayout = Create("UIListLayout", {
        Name = "ContentListLayout",
        Padding = UDim.new(0, OrionLib.Config.ElementSpacing),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Parent = OrionLib.Elements.ContentFrame
    })
    
    -- Add UIPadding to ContentFrame for inner margins
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 5),
        PaddingBottom = UDim.new(0, 5),
        Parent = OrionLib.Elements.ContentFrame
    })

    -- Draggable Functionality
    OrionLib.Elements.TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            CloseActiveDropdown()
            OrionLib.State.Dragging = true
            OrionLib.State.DragStart = input.Position
            OrionLib.State.FrameStart = OrionLib.Elements.MainPanel.Position
        end
    end)

    OrionLib.Elements.TitleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            OrionLib.State.Dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if OrionLib.State.Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - OrionLib.State.DragStart
            OrionLib.Elements.MainPanel.Position = UDim2.new(
                OrionLib.State.FrameStart.X.Scale, OrionLib.State.FrameStart.X.Offset + delta.X,
                OrionLib.State.FrameStart.Y.Scale, OrionLib.State.FrameStart.Y.Offset + delta.Y
            )
        end
    end)
    
    -- Handle window resize for scaled UI
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if OrionLib.Elements.MainPanel then
            OrionLib.Elements.MainPanel.Size = GetScaledSize(OrionLib.Config.MainPanelWidth, OrionLib.Config.MainPanelHeight)
        end
    end)

    -- External Toggle Button
    OrionLib.Elements.ToggleGuiButton = Create("TextButton", {
        Name = "ToggleUI",
        Size = UDim2.new(0, 80, 0, 30),
        Position = UDim2.new(0, 10, 0, 10), -- Top-left corner
        BackgroundColor3 = OrionLib.Config.AccentColor,
        Font = OrionLib.Config.SmallFont,
        Text = OrionLib.State.Visible and "Hide" or "Show",
        TextColor3 = OrionLib.Config.TextColor,
        ZIndex = 1000, -- Above MainPanel
        Parent = OrionLib.Elements.ScreenGui
    })
    ApplyCorner(OrionLib.Elements.ToggleGuiButton)
    OrionLib.Elements.ToggleGuiButton.MouseButton1Click:Connect(ToggleUIVisibility)

    -- Keybind to toggle
    UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
        if gameProcessedEvent then return end
        if input.KeyCode == OrionLib.Config.ToggleKey then
            ToggleUIVisibility()
        end
    end)

    -- Default section
    OrionLib.State.CurrentSection = OrionLib.Elements.ContentFrame 
    OrionLib.State.Initialized = true
    print(OrionLib.Name .. " v" .. OrionLib.Version .. " Initialized.")
    return self
end

-- // UI Element Creation Functions

function OrionLib:AddSection(name)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized. Call :Init() first.")
    CloseActiveDropdown()

    local sectionFrame = Create("Frame", {
        Name = name .. "Section",
        Size = UDim2.new(1, -10, 0, OrionLib.Config.ElementHeight + 10), -- Slightly taller for title
        BackgroundTransparency = 1, -- Sections are organizational
        Parent = OrionLib.Elements.ContentFrame -- All sections go into main content
    })

    local titleLabel = Create("TextLabel", {
        Name = "SectionTitle",
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.Font,
        TextColor3 = OrionLib.Config.TextColor,
        Text = ":: " .. name .. " ::",
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sectionFrame
    })
    
    local line = Create("Frame", {
        Name = "SectionLine",
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0,0,0,22),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        BorderSizePixel = 0,
        Parent = sectionFrame
    })


    local elementsContainer = Create("Frame", { -- Container for this section's elements
        Name = "ElementsContainer",
        Size = UDim2.new(1, 0, 1, -25), -- Fill below title
        Position = UDim2.new(0, 0, 0, 25),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = sectionFrame
    })
    
    local listLayout = Create("UIListLayout", {
        Padding = UDim.new(0, OrionLib.Config.ElementSpacing),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Parent = elementsContainer
    })

    OrionLib.State.CurrentSection = elementsContainer -- New elements go into this section's container
    return sectionFrame
end


function OrionLib:AddButton(text, callback)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()

    local button = Create("TextButton", {
        Name = "OrionButton",
        Size = UDim2.new(1, 0, 0, OrionLib.Config.ElementHeight),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        Font = OrionLib.Config.Font,
        Text = text,
        TextColor3 = OrionLib.Config.TextColor,
        Parent = OrionLib.State.CurrentSection
    })
    ApplyCorner(button)

    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = OrionLib.Config.AccentColor}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = OrionLib.Config.LightBackgroundColor}):Play()
    end)

    if callback then
        button.MouseButton1Click:Connect(function()
            pcall(callback)
        end)
    end
    return button
end

function OrionLib:AddToggle(text, initialValue, callback)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()

    local toggleFrame = Create("Frame", {
        Name = "OrionToggleFrame",
        Size = UDim2.new(1, 0, 0, OrionLib.Config.ElementHeight),
        BackgroundTransparency = 1,
        Parent = OrionLib.State.CurrentSection
    })

    local label = Create("TextLabel", {
        Name = "ToggleLabel",
        Size = UDim2.new(0.7, -5, 1, 0), -- 70% width, minus 5px spacing
        Position = UDim2.new(0,0,0,0),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.Font,
        Text = text,
        TextColor3 = OrionLib.Config.TextColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = toggleFrame
    })

    local switchButton = Create("TextButton", {
        Name = "SwitchButton",
        Size = UDim2.new(0.3, 0, 1, 0),
        Position = UDim2.new(0.7, 5, 0, 0), -- 30% width, plus 5px spacing
        BackgroundColor3 = initialValue and OrionLib.Config.AccentColor or OrionLib.Config.LightBackgroundColor,
        Font = OrionLib.Config.SmallFont,
        Text = initialValue and "ON" or "OFF",
        TextColor3 = OrionLib.Config.TextColor,
        Parent = toggleFrame
    })
    ApplyCorner(switchButton)

    local state = initialValue

    switchButton.MouseButton1Click:Connect(function()
        state = not state
        switchButton.Text = state and "ON" or "OFF"
        TweenService:Create(switchButton, TweenInfo.new(0.2), {
            BackgroundColor3 = state and OrionLib.Config.AccentColor or OrionLib.Config.LightBackgroundColor
        }):Play()
        if callback then
            pcall(callback, state)
        end
    end)
    
    local publicMethods = {
        GetValue = function() return state end,
        SetValue = function(newState)
            state = newState
            switchButton.Text = state and "ON" or "OFF"
            switchButton.BackgroundColor3 = state and OrionLib.Config.AccentColor or OrionLib.Config.LightBackgroundColor
            if callback then pcall(callback, state) end
        end,
        Instance = toggleFrame
    }
    return publicMethods
end

function OrionLib:AddSlider(text, min, max, initialValue, callback, showValueDecimalPlaces)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()
    showValueDecimalPlaces = showValueDecimalPlaces or 0 -- Default to no decimal places

    local sliderFrame = Create("Frame", {
        Name = "OrionSliderFrame",
        Size = UDim2.new(1, 0, 0, OrionLib.Config.ElementHeight + 15), -- Extra height for label
        BackgroundTransparency = 1,
        Parent = OrionLib.State.CurrentSection
    })

    local label = Create("TextLabel", {
        Name = "SliderLabel",
        Size = UDim2.new(1, 0, 0, 15),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.SmallFont,
        Text = text .. ": " .. string.format("%." .. showValueDecimalPlaces .. "f", initialValue),
        TextColor3 = OrionLib.Config.TextColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sliderFrame
    })

    local track = Create("Frame", {
        Name = "Track",
        Size = UDim2.new(1, -10, 0, 8), -- -10 to center handle, 8px height
        Position = UDim2.new(0, 5, 0, 20), -- Below label, 5px padding
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        BorderSizePixel = 0,
        Parent = sliderFrame
    })
    ApplyCorner(track)

    local fillTrack = Create("Frame", {
        Name = "FillTrack",
        Size = UDim2.new(0,0,1,0), -- Initial size set later
        BackgroundColor3 = OrionLib.Config.AccentColor,
        BorderSizePixel = 0,
        Parent = track
    })
    ApplyCorner(fillTrack)


    local handle = Create("TextButton", { -- TextButton for better input detection
        Name = "Handle",
        Size = UDim2.new(0, 16, 0, 16), -- Square handle
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0,0,0.5,0), -- Initial position set later
        BackgroundColor3 = OrionLib.Config.TextColor, -- A lighter handle
        BorderSizePixel = 0,
        Text = "",
        ZIndex = 2,
        Parent = track
    })
    ApplyCorner(handle)

    local currentValue = initialValue
    local isDraggingHandle = false

    local function updateSlider(value)
        currentValue = math.clamp(value, min, max)
        local percentage = (currentValue - min) / (max - min)
        percentage = math.clamp(percentage, 0, 1)

        handle.Position = UDim2.new(percentage, 0, 0.5, 0)
        fillTrack.Size = UDim2.new(percentage, 0, 1, 0)
        label.Text = text .. ": " .. string.format("%." .. showValueDecimalPlaces .. "f", currentValue)

        if callback then
            pcall(callback, currentValue)
        end
    end
    
    updateSlider(initialValue) -- Set initial position

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingHandle = true
            CloseActiveDropdown()
        end
    end)
    
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingHandle = false
        end
    end)

    local function processInput(input)
        if not track.AbsoluteSize.X or track.AbsoluteSize.X == 0 then return end -- Avoid division by zero

        local relativeMouseX = input.Position.X - track.AbsolutePosition.X
        local percentage = math.clamp(relativeMouseX / track.AbsoluteSize.X, 0, 1)
        local newValue = min + (max - min) * percentage
        updateSlider(newValue)
    end

    -- Allow clicking on track to set value
    track.InputBegan:Connect(function(input)
         if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingHandle = true -- Allow dragging from track click
            CloseActiveDropdown()
            processInput(input)
        end
    end)
    track.InputEnded:Connect(function(input)
         if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingHandle = false
        end
    end)


    RunService.RenderStepped:Connect(function()
        if isDraggingHandle and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local mouseLocation = UserInputService:GetMouseLocation()
            processInput(mouseLocation)
        elseif isDraggingHandle and UserInputService:IsTouchActive() then
             local touchPositions = UserInputService:GetTouchPositions()
             if #touchPositions > 0 then
                 processInput(touchPositions[1]) -- Use first touch
             end
        elseif isDraggingHandle then -- If mouse released outside of an InputEnded event
            isDraggingHandle = false
        end
    end)
    
    local publicMethods = {
        GetValue = function() return currentValue end,
        SetValue = function(newValue) updateSlider(newValue) end,
        Instance = sliderFrame
    }
    return publicMethods
end


function OrionLib:AddDropdown(labelText, options, callback) -- options = {"Opt1", "Opt2", Value = "opt3"}
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown() -- Close any other dropdown

    local dropdownFrame = Create("Frame", {
        Name = "OrionDropdownFrame",
        Size = UDim2.new(1, 0, 0, OrionLib.Config.ElementHeight),
        BackgroundTransparency = 1,
        Parent = OrionLib.State.CurrentSection,
        ZIndex = 2 -- Dropdowns need to appear above other elements
    })

    local currentSelectionDisplay = Create("TextButton", {
        Name = "CurrentSelection",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        Font = OrionLib.Config.Font,
        Text = labelText .. ": " .. (options[1] or "Select..."), -- Default to first or placeholder
        TextColor3 = OrionLib.Config.TextColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = dropdownFrame
    })
    ApplyCorner(currentSelectionDisplay)
    Create("UIPadding", {PaddingLeft = UDim.new(0,10), Parent = currentSelectionDisplay})


    local arrow = Create("TextLabel", {
        Name = "Arrow",
        Size = UDim2.new(0,20,1,0),
        Position = UDim2.new(1,-25,0,0),
        BackgroundTransparency = 1,
        Font = Enum.Font.SourceSansBold,
        Text = "▼",
        TextColor3 = OrionLib.Config.TextColor,
        TextScaled = true,
        Parent = currentSelectionDisplay
    })

    local optionsFrameHeight = math.min(#options * (OrionLib.Config.ElementHeight + 2), 150) -- Max height 150px
    local optionsFrame = Create("ScrollingFrame", {
        Name = "OptionsFrame",
        Size = UDim2.new(1, 0, 0, optionsFrameHeight),
        Position = UDim2.new(0, 0, 1, 2), -- Below the display button, 2px gap
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        BorderSizePixel = 1,
        BorderColor3 = OrionLib.Config.AccentColor,
        Visible = false,
        ClipsDescendants = true,
        ScrollBarThickness = 4,
        ZIndex = 3, -- Above dropdownFrame
        Parent = dropdownFrame -- Parent to dropdownFrame for positioning, then reparent to ScreenGui for visibility
    })
    ApplyCorner(optionsFrame)
    optionsFrame.Parent = OrionLib.Elements.ScreenGui -- Reparent for global visibility

    local optionsListLayout = Create("UIListLayout", {
        Padding = UDim.new(0, 2),
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Parent = optionsFrame
    })

    local selectedValue = options[1] -- Default selection

    for i, optionText in ipairs(options) do
        local optionButton = Create("TextButton", {
            Name = "Option_" .. tostring(optionText),
            Size = UDim2.new(1, -4, 0, OrionLib.Config.ElementHeight), -- -4 for scrollbar padding
            BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
            Font = OrionLib.Config.SmallFont,
            Text = tostring(optionText),
            TextColor3 = OrionLib.Config.TextColor,
            Parent = optionsFrame
        })

        optionButton.MouseEnter:Connect(function()
            optionButton.BackgroundColor3 = OrionLib.Config.AccentColor
        end)
        optionButton.MouseLeave:Connect(function()
            optionButton.BackgroundColor3 = OrionLib.Config.LightBackgroundColor
        end)

        optionButton.MouseButton1Click:Connect(function()
            selectedValue = optionText
            currentSelectionDisplay.Text = labelText .. ": " .. tostring(selectedValue)
            optionsFrame.Visible = false
            OrionLib.State.ActiveDropdown = nil
            if callback then
                pcall(callback, selectedValue)
            end
        end)
    end
    
    local function updateOptionsFramePosition()
        -- Ensure it's positioned correctly relative to the display button, even if main panel moves
        local displayAbsolutePos = currentSelectionDisplay.AbsolutePosition
        local displayAbsoluteSize = currentSelectionDisplay.AbsoluteSize
        optionsFrame.Position = UDim2.fromOffset(displayAbsolutePos.X, displayAbsolutePos.Y + displayAbsoluteSize.Y + 2)
        optionsFrame.Size = UDim2.fromOffset(displayAbsoluteSize.X, optionsFrameHeight)
    end

    currentSelectionDisplay.MouseButton1Click:Connect(function()
        if optionsFrame.Visible then
            optionsFrame.Visible = false
            OrionLib.State.ActiveDropdown = nil
        else
            CloseActiveDropdown() -- Close any other active dropdown
            updateOptionsFramePosition()
            optionsFrame.Visible = true
            OrionLib.State.ActiveDropdown = { OptionsFrame = optionsFrame }
        end
    end)
    
    -- Keep options frame position updated if main panel moves (e.g. dragging)
    OrionLib.Elements.MainPanel:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        if optionsFrame.Visible then
            updateOptionsFramePosition()
        end
    end)
    -- And if main panel size changes (though less likely to affect dropdown position directly unless anchor points are involved)
     OrionLib.Elements.MainPanel:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if optionsFrame.Visible then
            updateOptionsFramePosition()
        end
    end)


    local publicMethods = {
        GetValue = function() return selectedValue end,
        SetValue = function(newValue) -- Ensure newValue is one of the options
            for _, opt in ipairs(options) do
                if opt == newValue then
                    selectedValue = newValue
                    currentSelectionDisplay.Text = labelText .. ": " .. tostring(selectedValue)
                    if callback then pcall(callback, selectedValue) end -- Optionally trigger callback
                    break
                end
            end
        end,
        Instance = dropdownFrame,
        OptionsFrameInstance = optionsFrame -- For debugging or advanced manipulation
    }
    return publicMethods
end

function OrionLib:AddTextBox(placeholderText, callbackOnEnter, allowMultiline)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()

    local height = allowMultiline and (OrionLib.Config.ElementHeight * 2.5) or OrionLib.Config.ElementHeight
    local textBox = Create("TextBox", {
        Name = "OrionTextBox",
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        Font = OrionLib.Config.Font,
        Text = "",
        PlaceholderText = placeholderText,
        PlaceholderColor3 = OrionLib.Config.PlaceholderColor,
        TextColor3 = OrionLib.Config.TextColor,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = allowMultiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        MultiLine = allowMultiline or false,
        Parent = OrionLib.State.CurrentSection
    })
    ApplyCorner(textBox)
    Create("UIPadding", {
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        PaddingTop = UDim.new(0, allowMultiline and 5 or 0),
        Parent = textBox
    })

    textBox.FocusLost:Connect(function(enterPressed)
        if enterPressed and callbackOnEnter then
            pcall(callbackOnEnter, textBox.Text)
        elseif not enterPressed and callbackOnEnter and not allowMultiline then 
            -- Trigger for non-multiline on focus lost even if not enter
            pcall(callbackOnEnter, textBox.Text)
        end
        CloseActiveDropdown() -- Make sure if user clicks outside to lose focus
    })
    
    textBox.Focused:Connect(function()
        CloseActiveDropdown()
    end)

    local publicMethods = {
        GetValue = function() return textBox.Text end,
        SetValue = function(newText) textBox.Text = newText end,
        Clear = function() textBox.Text = "" end,
        Instance = textBox
    }
    return publicMethods
end

function OrionLib:AddLabel(text, alignment, size)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()
    
    alignment = alignment or Enum.TextXAlignment.Left
    size = size or OrionLib.Config.ElementHeight -- In pixels

    local label = Create("TextLabel", {
        Name = "OrionLabel",
        Size = UDim2.new(1, 0, 0, size),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.Font,
        Text = text,
        TextColor3 = OrionLib.Config.TextColor,
        TextXAlignment = alignment,
        TextWrapped = true, -- Important for labels that might exceed width
        Parent = OrionLib.State.CurrentSection
    })
    
    local publicMethods = {
        SetText = function(newText) label.Text = newText end,
        Instance = label
    }
    return publicMethods
end

function OrionLib:Destroy()
    if OrionLib.Elements.ScreenGui then
        OrionLib.Elements.ScreenGui:Destroy()
    end
    -- Reset state
    OrionLib.State = {
        Initialized = false,
        Visible = true,
        Dragging = false,
        DragStart = nil,
        FrameStart = nil,
        CurrentSection = nil,
        ActiveDropdown = nil
    }
    OrionLib.Elements = {} -- Clear references
    print(OrionLib.Name .. " Destroyed.")
end


-- Make the library globally accessible IF loaded directly by executor,
-- or return it if required by another script.
-- For loadstring, this makes `_G.OrionLib` available.
_G.OrionLib = OrionLib

return OrionLib
