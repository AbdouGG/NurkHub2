function DropdownElement:SetEnabled(enabled)
    BaseElement.SetEnabled(self, enabled)
    local theme = self:GetTheme()
    self.DisplayButton.Active = enabled; self.DisplayButton.AutoButtonColor = enabled
    self.ArrowIcon.TextColor3 = enabled and (self.Properties.TextColor or theme.DefaultTextColor) or Color3.fromRGB(150,150,150)
    if not enabled then self.DisplayButton.BackgroundColor3 = theme.DisabledColor; if self.IsExpanded then self.IsExpanded=false; self.OptionsScrollFrame.Visible=false; self.ArrowIcon.Text="▼" end
    else self.DisplayButton.BackgroundColor3 = self.Properties.BackgroundColor or theme.DefaultElementColor end
    for _,opt in ipairs(self.Options) do if opt.ButtonInstance then opt.ButtonInstance.Active=enabled; opt.ButtonInstance.AutoButtonColor=enabled end end
end

