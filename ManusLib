-- Add star button (for favorites)
function MercUI:AddStarButton(tab, section, text, starred, callback)
    local button = self:AddButton(tab, section, text, callback)
    
    if not button then return nil end
    
    -- Replace the right arrow with a star
    local starIcon = button:FindFirstChild("Icon")
    if starIcon then
        starIcon.Text = config.icons.star
        
        -- Set initial state
        if starred then
            starIcon.TextColor3 = config.colors.warning
        else
            starIcon.TextColor3 = config.colors.textDim
        end
        
        -- Add toggle functionality
        local isStarred = starred
        
        -- Add separate click handler for the star
        local clickArea = Instance.new("TextButton")
        clickArea.Name = "StarClickArea"
        clickArea.Size = UDim2.fromOffset(30, 30)
        clickArea.Position = UDim2.new(1, -35, 0.5, -15)
        clickArea.BackgroundTransparency = 1
        clickArea.Text = ""
        clickArea.ZIndex = 107
        clickArea.Parent = button
        
        clickArea.MouseButton1Click:Connect(function()
            isStarred = not isStarred
            
            if isStarred then
                starIcon:TweenProperty(
                    "TextColor3",
                    config.colors.warning,
                    Enum.EasingDirection.Out,
                    config.animation.easing,
                    0.2,
                    true
                )
            else
                starIcon:TweenProperty(
                    "TextColor3",
                    config.colors.textDim,
                    Enum.EasingDirection.Out,
                    config.animation.easing,
                    0.2,
                    true
                )
            end
        end)
    end
    
    return button
end

