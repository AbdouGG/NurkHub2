--[[
    Orion UI Library
    Version: 1.0.1 (Updated with deferred service init)
    Author: YourName/AI
    Description: A modern, aesthetic UI library for Roblox executors.
]]
print("OrionLib: Loading script...")

local OrionLib = {}
OrionLib.Name = "Orion UI"
OrionLib.Version = "1.0.1"

-- // Services (declare them, will be initialized by EnsureServices)
local Players
local UserInputService
local TweenService
local RunService
local ServicesInitialized = false -- Flag

-- // Configuration
OrionLib.Config = {
    AccentColor = Color3.fromRGB(0, 122, 255),
    BackgroundColor = Color3.fromRGB(30, 30, 30),
    LightBackgroundColor = Color3.fromRGB(45, 45, 45),
    TextColor = Color3.fromRGB(240, 240, 240),
    PlaceholderColor = Color3.fromRGB(150, 150, 150),
    Font = Enum.Font.GothamSemibold,
    SmallFont = Enum.Font.Gotham,
    ElementHeight = 30,
    ElementSpacing = 5,
    CornerRadius = 6,
    MainPanelWidth = 0.3,
    MainPanelMinWidth = 280,
    MainPanelHeight = 0.5,
    MainPanelMinHeight = 300,
    ToggleKey = Enum.KeyCode.RightControl
}

-- // State
OrionLib.State = {
    Initialized = false,
    Visible = true,
    Dragging = false,
    DragStart = nil,
    FrameStart = nil,
    CurrentSection = nil,
    ActiveDropdown = nil
}

-- // UI Elements (will be populated in Init)
OrionLib.Elements = {
    ScreenGui = nil,
    ToggleGuiButton = nil,
    MainPanel = nil,
    TitleBar = nil,
    TitleLabel = nil,
    CloseButton = nil,
    ContentFrame = nil,
    ContentListLayout = nil
}

-- // Service Initializer
local function EnsureServices()
    if ServicesInitialized then return end
    print("OrionLib: Initializing services...")

    if not game or typeof(game.GetService) ~= "function" then
        local message = "OrionLib: CRITICAL ERROR - 'game' or 'game.GetService' is not available or not a function. UI cannot function."
        warn(message)
        if OrionLib.Elements.ScreenGui and OrionLib.Elements.ScreenGui.Parent then -- Try to show in UI if possible
            pcall(function() -- Wrap in pcall as Create/ApplyCorner might not be safe if core things are broken
                local errorLabel = Instance.new("TextLabel")
                errorLabel.Size = UDim2.new(0.9, 0, 0, 80)
                errorLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
                errorLabel.AnchorPoint = Vector2.new(0.5, 0.5)
                errorLabel.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                errorLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                errorLabel.Font = Enum.Font.SourceSansBold
                errorLabel.TextWrapped = true
                errorLabel.Text = message
                errorLabel.ZIndex = 10000
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, OrionLib.Config.CornerRadius)
                corner.Parent = errorLabel
                errorLabel.Parent = OrionLib.Elements.ScreenGui
            end)
        end
        error(message) -- This will stop the script
    end

    Players = game:GetService("Players")
    UserInputService = game:GetService("UserInputService")
    TweenService = game:GetService("TweenService")
    RunService = game:GetService("RunService")

    if not (Players and UserInputService and TweenService and RunService) then
        local missing = {}
        if not Players then table.insert(missing, "Players") end
        if not UserInputService then table.insert(missing, "UserInputService") end
        if not TweenService then table.insert(missing, "TweenService") end
        if not RunService then table.insert(missing, "RunService") end
        local errMsg = "OrionLib: CRITICAL ERROR - Failed to initialize core services: " .. table.concat(missing, ", ")
        warn(errMsg)
        error(errMsg)
    end

    ServicesInitialized = true
    print("OrionLib: Services initialized successfully.")
end


-- // Private Helper Functions
local function Create(instanceType, properties)
    local inst = Instance.new(instanceType)
    for prop, val in pairs(properties or {}) do
        inst[prop] = val
    end
    return inst
end

local function ApplyCorner(parent)
    Create("UICorner", {
        CornerRadius = UDim.new(0, OrionLib.Config.CornerRadius),
        Parent = parent
    })
end

local function ApplyStroke(parent, color, thickness)
    Create("UIStroke", {
        Color = color or OrionLib.Config.AccentColor,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent
    })
end

local function GetScaledSize(widthScale, heightScale, widthOffset, heightOffset)
    EnsureServices() -- Needs workspace.CurrentCamera
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local w = math.max(OrionLib.Config.MainPanelMinWidth, viewportSize.X * widthScale)
    local h = math.max(OrionLib.Config.MainPanelMinHeight, viewportSize.Y * heightScale)
    return UDim2.new(0, w + (widthOffset or 0), 0, h + (heightOffset or 0))
end

local function ToggleUIVisibility()
    OrionLib.State.Visible = not OrionLib.State.Visible
    if OrionLib.Elements.MainPanel then
        OrionLib.Elements.MainPanel.Visible = OrionLib.State.Visible
    end
    if OrionLib.Elements.ToggleGuiButton then
        OrionLib.Elements.ToggleGuiButton.Text = OrionLib.State.Visible and "Hide" or "Show"
    end
end

local function CloseActiveDropdown()
    if OrionLib.State.ActiveDropdown then
        OrionLib.State.ActiveDropdown.OptionsFrame.Visible = false
        OrionLib.State.ActiveDropdown = nil
    end
end

-- // Core Initialization
function OrionLib:Init(title)
    if OrionLib.State.Initialized then
        warn(OrionLib.Name .. " is already initialized.")
        return self
    end
    print("OrionLib: Init called.")

    -- Create ScreenGui first, as EnsureServices might want to display an error on it.
    OrionLib.Elements.ScreenGui = Create("ScreenGui", {
        Name = OrionLib.Name .. "Gui",
        DisplayOrder = 999,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
    })
    -- Tentative parenting, will be confirmed after services are up.
    local tempPlayer = game and pcall(function() return game:GetService("Players") end) and game:GetService("Players").LocalPlayer
    local tempPlayerGui = tempPlayer and tempPlayer:FindFirstChildOfClass("PlayerGui")
    OrionLib.Elements.ScreenGui.Parent = tempPlayerGui or game:GetService("CoreGui") -- CoreGui as a fallback

    EnsureServices() -- Crucial: Initialize all Roblox services now.

    -- Confirm ScreenGui parent now that Players service is guaranteed (if EnsureServices didn't error)
    if not (OrionLib.Elements.ScreenGui.Parent and OrionLib.Elements.ScreenGui.Parent:IsA("CoreGui")) then
         OrionLib.Elements.ScreenGui.Parent = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui") or game:GetService("CoreGui")
    end


    title = title or OrionLib.Name

    -- Main Panel
    OrionLib.Elements.MainPanel = Create("Frame", {
        Name = "MainPanel",
        Size = GetScaledSize(OrionLib.Config.MainPanelWidth, OrionLib.Config.MainPanelHeight),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = OrionLib.Config.BackgroundColor,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = OrionLib.State.Visible,
        Parent = OrionLib.Elements.ScreenGui
    })
    ApplyCorner(OrionLib.Elements.MainPanel)
    ApplyStroke(OrionLib.Elements.MainPanel, OrionLib.Config.LightBackgroundColor, 2)

    -- Title Bar
    OrionLib.Elements.TitleBar = Create("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        BorderSizePixel = 0,
        Parent = OrionLib.Elements.MainPanel
    })

    OrionLib.Elements.TitleLabel = Create("TextLabel", {
        Name = "TitleLabel",
        Size = UDim2.new(0.9, -35, 1, 0),
        Position = UDim2.new(0.05, 0, 0, 0),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.Font,
        TextColor3 = OrionLib.Config.TextColor,
        Text = title,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = OrionLib.Elements.TitleBar
    })
    Create("UIPadding", {
        PaddingLeft = UDim.new(0, 10),
        Parent = OrionLib.Elements.TitleLabel
    })

    OrionLib.Elements.CloseButton = Create("TextButton", {
        Name = "CloseButton",
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -33, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        Font = OrionLib.Config.Font,
        Text = "X",
        TextColor3 = OrionLib.Config.TextColor,
        Parent = OrionLib.Elements.TitleBar
    })
    ApplyCorner(OrionLib.Elements.CloseButton)
    OrionLib.Elements.CloseButton.MouseEnter:Connect(function()
        TweenService:Create(OrionLib.Elements.CloseButton, TweenInfo.new(0.2), {BackgroundColor3 = OrionLib.Config.AccentColor}):Play()
    end)
    OrionLib.Elements.CloseButton.MouseLeave:Connect(function()
        TweenService:Create(OrionLib.Elements.CloseButton, TweenInfo.new(0.2), {BackgroundColor3 = OrionLib.Config.LightBackgroundColor}):Play()
    end)
    OrionLib.Elements.CloseButton.MouseButton1Click:Connect(ToggleUIVisibility)

    OrionLib.Elements.ContentFrame = Create("ScrollingFrame", {
        Name = "ContentFrame",
        Size = UDim2.new(1, -20, 1, -45),
        Position = UDim2.new(0, 10, 0, 40),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 6,
        ScrollBarImageColor3 = OrionLib.Config.AccentColor,
        CanvasSize = UDim2.new(0,0,0,0),
        Parent = OrionLib.Elements.MainPanel
    })

    OrionLib.Elements.ContentListLayout = Create("UIListLayout", {
        Name = "ContentListLayout",
        Padding = UDim.new(0, OrionLib.Config.ElementSpacing),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Parent = OrionLib.Elements.ContentFrame
    })
    
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 5),
        PaddingBottom = UDim.new(0, 5),
        Parent = OrionLib.Elements.ContentFrame
    })

    OrionLib.Elements.TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            CloseActiveDropdown()
            OrionLib.State.Dragging = true
            OrionLib.State.DragStart = input.Position
            OrionLib.State.FrameStart = OrionLib.Elements.MainPanel.Position
        end
    end)

    OrionLib.Elements.TitleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            OrionLib.State.Dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if OrionLib.State.Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - OrionLib.State.DragStart
            OrionLib.Elements.MainPanel.Position = UDim2.new(
                OrionLib.State.FrameStart.X.Scale, OrionLib.State.FrameStart.X.Offset + delta.X,
                OrionLib.State.FrameStart.Y.Scale, OrionLib.State.FrameStart.Y.Offset + delta.Y
            )
        end
    end)
    
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if OrionLib.Elements.MainPanel then
            OrionLib.Elements.MainPanel.Size = GetScaledSize(OrionLib.Config.MainPanelWidth, OrionLib.Config.MainPanelHeight)
        end
    end)

    OrionLib.Elements.ToggleGuiButton = Create("TextButton", {
        Name = "ToggleUI",
        Size = UDim2.new(0, 80, 0, 30),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundColor3 = OrionLib.Config.AccentColor,
        Font = OrionLib.Config.SmallFont,
        Text = OrionLib.State.Visible and "Hide" or "Show",
        TextColor3 = OrionLib.Config.TextColor,
        ZIndex = 1000,
        Parent = OrionLib.Elements.ScreenGui
    })
    ApplyCorner(OrionLib.Elements.ToggleGuiButton)
    OrionLib.Elements.ToggleGuiButton.MouseButton1Click:Connect(ToggleUIVisibility)

    UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
        if gameProcessedEvent then return end
        if input.KeyCode == OrionLib.Config.ToggleKey then
            ToggleUIVisibility()
        end
    end)

    OrionLib.State.CurrentSection = OrionLib.Elements.ContentFrame 
    OrionLib.State.Initialized = true
    print(OrionLib.Name .. " v" .. OrionLib.Version .. " Initialized successfully.")
    return self
end

-- // UI Element Creation Functions (EnsureServices already called by Init or other callers)

function OrionLib:AddSection(name)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized. Call :Init() first.")
    CloseActiveDropdown()

    local sectionFrame = Create("Frame", {
        Name = name .. "Section",
        Size = UDim2.new(1, -10, 0, OrionLib.Config.ElementHeight + 10),
        BackgroundTransparency = 1,
        Parent = OrionLib.Elements.ContentFrame
    })

    local titleLabel = Create("TextLabel", {
        Name = "SectionTitle",
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.Font,
        TextColor3 = OrionLib.Config.TextColor,
        Text = ":: " .. name .. " ::",
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sectionFrame
    })
    
    local line = Create("Frame", {
        Name = "SectionLine",
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0,0,0,22),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        BorderSizePixel = 0,
        Parent = sectionFrame
    })

    local elementsContainer = Create("Frame", {
        Name = "ElementsContainer",
        Size = UDim2.new(1, 0, 1, -25),
        Position = UDim2.new(0, 0, 0, 25),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = sectionFrame
    })
    
    Create("UIListLayout", {
        Padding = UDim.new(0, OrionLib.Config.ElementSpacing),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Parent = elementsContainer
    })

    OrionLib.State.CurrentSection = elementsContainer
    return sectionFrame
end

function OrionLib:AddButton(text, callback)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()

    local button = Create("TextButton", {
        Name = "OrionButton",
        Size = UDim2.new(1, 0, 0, OrionLib.Config.ElementHeight),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        Font = OrionLib.Config.Font,
        Text = text,
        TextColor3 = OrionLib.Config.TextColor,
        Parent = OrionLib.State.CurrentSection
    })
    ApplyCorner(button)

    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = OrionLib.Config.AccentColor}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = OrionLib.Config.LightBackgroundColor}):Play()
    end)

    if callback then
        button.MouseButton1Click:Connect(function()
            pcall(callback)
        end)
    end
    return button
end

function OrionLib:AddToggle(text, initialValue, callback)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()

    local toggleFrame = Create("Frame", {
        Name = "OrionToggleFrame",
        Size = UDim2.new(1, 0, 0, OrionLib.Config.ElementHeight),
        BackgroundTransparency = 1,
        Parent = OrionLib.State.CurrentSection
    })

    local label = Create("TextLabel", {
        Name = "ToggleLabel",
        Size = UDim2.new(0.7, -5, 1, 0),
        Position = UDim2.new(0,0,0,0),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.Font,
        Text = text,
        TextColor3 = OrionLib.Config.TextColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = toggleFrame
    })

    local switchButton = Create("TextButton", {
        Name = "SwitchButton",
        Size = UDim2.new(0.3, 0, 1, 0),
        Position = UDim2.new(0.7, 5, 0, 0),
        BackgroundColor3 = initialValue and OrionLib.Config.AccentColor or OrionLib.Config.LightBackgroundColor,
        Font = OrionLib.Config.SmallFont,
        Text = initialValue and "ON" or "OFF",
        TextColor3 = OrionLib.Config.TextColor,
        Parent = toggleFrame
    })
    ApplyCorner(switchButton)

    local state = initialValue

    switchButton.MouseButton1Click:Connect(function()
        state = not state
        switchButton.Text = state and "ON" or "OFF"
        TweenService:Create(switchButton, TweenInfo.new(0.2), {
            BackgroundColor3 = state and OrionLib.Config.AccentColor or OrionLib.Config.LightBackgroundColor
        }):Play()
        if callback then
            pcall(callback, state)
        end
    end)
    
    return {
        GetValue = function() return state end,
        SetValue = function(newState)
            state = newState
            switchButton.Text = state and "ON" or "OFF"
            switchButton.BackgroundColor3 = state and OrionLib.Config.AccentColor or OrionLib.Config.LightBackgroundColor
            if callback then pcall(callback, state) end
        end,
        Instance = toggleFrame
    }
end

function OrionLib:AddSlider(text, min, max, initialValue, callback, showValueDecimalPlaces)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()
    showValueDecimalPlaces = showValueDecimalPlaces or 0

    local sliderFrame = Create("Frame", {
        Name = "OrionSliderFrame",
        Size = UDim2.new(1, 0, 0, OrionLib.Config.ElementHeight + 15),
        BackgroundTransparency = 1,
        Parent = OrionLib.State.CurrentSection
    })

    local label = Create("TextLabel", {
        Name = "SliderLabel",
        Size = UDim2.new(1, 0, 0, 15),
        BackgroundTransparency = 1,
        Font = OrionLib.Config.SmallFont,
        Text = text .. ": " .. string.format("%." .. showValueDecimalPlaces .. "f", initialValue),
        TextColor3 = OrionLib.Config.TextColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sliderFrame
    })

    local track = Create("Frame", {
        Name = "Track",
        Size = UDim2.new(1, -10, 0, 8),
        Position = UDim2.new(0, 5, 0, 20),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor,
        BorderSizePixel = 0,
        Parent = sliderFrame
    })
    ApplyCorner(track)

    local fillTrack = Create("Frame", {
        Name = "FillTrack",
        Size = UDim2.new(0,0,1,0),
        BackgroundColor3 = OrionLib.Config.AccentColor,
        BorderSizePixel = 0,
        Parent = track
    })
    ApplyCorner(fillTrack)

    local handle = Create("TextButton", {
        Name = "Handle",
        Size = UDim2.new(0, 16, 0, 16),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0,0,0.5,0),
        BackgroundColor3 = OrionLib.Config.TextColor,
        BorderSizePixel = 0, Text = "", ZIndex = 2,
        Parent = track
    })
    ApplyCorner(handle)

    local currentValue = initialValue
    local isDraggingHandle = false

    local function updateSlider(value)
        currentValue = math.clamp(value, min, max)
        local percentage = (max - min) == 0 and 0 or (currentValue - min) / (max - min) -- Avoid div by zero
        percentage = math.clamp(percentage, 0, 1)

        handle.Position = UDim2.new(percentage, 0, 0.5, 0)
        fillTrack.Size = UDim2.new(percentage, 0, 1, 0)
        label.Text = text .. ": " .. string.format("%." .. showValueDecimalPlaces .. "f", currentValue)

        if callback then pcall(callback, currentValue) end
    end
    
    updateSlider(initialValue)

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingHandle = true; CloseActiveDropdown()
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingHandle = false
        end
    end)

    local function processInput(inputPos)
        if not track.AbsoluteSize.X or track.AbsoluteSize.X == 0 then return end
        local relativeMouseX = inputPos.X - track.AbsolutePosition.X
        local percentage = math.clamp(relativeMouseX / track.AbsoluteSize.X, 0, 1)
        local newValue = min + (max - min) * percentage
        updateSlider(newValue)
    end

    track.InputBegan:Connect(function(input)
         if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingHandle = true; CloseActiveDropdown()
            processInput(input.Position)
        end
    end)
    track.InputEnded:Connect(function(input)
         if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingHandle = false
        end
    end)

    RunService:BindToRenderStep("OrionSliderUpdate_"..text, Enum.RenderPriority.Input.Value + 1, function()
        if isDraggingHandle then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                processInput(UserInputService:GetMouseLocation())
            elseif UserInputService:IsTouchActive() and #UserInputService:GetTouchPositions() > 0 then
                 processInput(UserInputService:GetTouchPositions()[1])
            else -- Mouse/touch released outside of an InputEnded event for the handle/track
                isDraggingHandle = false
            end
        end
    end)
    
    return {
        GetValue = function() return currentValue end,
        SetValue = function(newValue) updateSlider(newValue) end,
        Instance = sliderFrame,
        Destroy = function() -- Cleanup renderstep
            RunService:UnbindFromRenderStep("OrionSliderUpdate_"..text)
        end
    }
end

function OrionLib:AddDropdown(labelText, options, callback)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()

    local dropdownFrame = Create("Frame", {
        Name = "OrionDropdownFrame",
        Size = UDim2.new(1, 0, 0, OrionLib.Config.ElementHeight),
        BackgroundTransparency = 1, Parent = OrionLib.State.CurrentSection, ZIndex = 2
    })

    local currentSelectionDisplay = Create("TextButton", {
        Name = "CurrentSelection", Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor, Font = OrionLib.Config.Font,
        Text = labelText .. ": " .. (options[1] or "Select..."), TextColor3 = OrionLib.Config.TextColor,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = dropdownFrame
    })
    ApplyCorner(currentSelectionDisplay)
    Create("UIPadding", {PaddingLeft = UDim.new(0,10), Parent = currentSelectionDisplay})

    Create("TextLabel", { Name = "Arrow", Size = UDim2.new(0,20,1,0), Position = UDim2.new(1,-25,0,0),
        BackgroundTransparency = 1, Font = Enum.Font.SourceSansBold, Text = "▼",
        TextColor3 = OrionLib.Config.TextColor, TextScaled = true, Parent = currentSelectionDisplay
    })

    local optionsFrameHeight = math.min(#options * (OrionLib.Config.ElementHeight + 2), 150)
    local optionsFrame = Create("ScrollingFrame", { Name = "OptionsFrame",
        Size = UDim2.new(1, 0, 0, optionsFrameHeight), Position = UDim2.new(0, 0, 1, 2),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor, BorderSizePixel = 1,
        BorderColor3 = OrionLib.Config.AccentColor, Visible = false, ClipsDescendants = true,
        ScrollBarThickness = 4, ZIndex = 10001, -- Higher ZIndex for options
        Parent = OrionLib.Elements.ScreenGui -- Parent to ScreenGui for global visibility
    })
    ApplyCorner(optionsFrame)

    Create("UIListLayout", { Padding = UDim.new(0, 2), FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = optionsFrame
    })

    local selectedValue = options[1]

    for _, optionText in ipairs(options) do
        local optionButton = Create("TextButton", { Name = "Option_" .. tostring(optionText),
            Size = UDim2.new(1, -4, 0, OrionLib.Config.ElementHeight),
            BackgroundColor3 = OrionLib.Config.LightBackgroundColor, Font = OrionLib.Config.SmallFont,
            Text = tostring(optionText), TextColor3 = OrionLib.Config.TextColor, Parent = optionsFrame
        })
        optionButton.MouseEnter:Connect(function() optionButton.BackgroundColor3 = OrionLib.Config.AccentColor end)
        optionButton.MouseLeave:Connect(function() optionButton.BackgroundColor3 = OrionLib.Config.LightBackgroundColor end)
        optionButton.MouseButton1Click:Connect(function()
            selectedValue = optionText
            currentSelectionDisplay.Text = labelText .. ": " .. tostring(selectedValue)
            optionsFrame.Visible = false; OrionLib.State.ActiveDropdown = nil
            if callback then pcall(callback, selectedValue) end
        end)
    end
    
    local function updateOptionsFramePosition()
        local displayAbsolutePos = currentSelectionDisplay.AbsolutePosition
        local displayAbsoluteSize = currentSelectionDisplay.AbsoluteSize
        optionsFrame.Position = UDim2.fromOffset(displayAbsolutePos.X, displayAbsolutePos.Y + displayAbsoluteSize.Y + 2)
        optionsFrame.Size = UDim2.fromOffset(displayAbsoluteSize.X, optionsFrame.AbsoluteSize.Y) -- Keep original calculated height
    end

    currentSelectionDisplay.MouseButton1Click:Connect(function()
        if optionsFrame.Visible then
            optionsFrame.Visible = false; OrionLib.State.ActiveDropdown = nil
        else
            CloseActiveDropdown()
            updateOptionsFramePosition()
            optionsFrame.Visible = true
            OrionLib.State.ActiveDropdown = { OptionsFrame = optionsFrame }
        end
    end)
    
    local mainPanelPosChangedConn, mainPanelSizeChangedConn
    mainPanelPosChangedConn = OrionLib.Elements.MainPanel:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        if optionsFrame.Visible then updateOptionsFramePosition() end
    end)
    mainPanelSizeChangedConn = OrionLib.Elements.MainPanel:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if optionsFrame.Visible then updateOptionsFramePosition() end
    end)

    return {
        GetValue = function() return selectedValue end,
        SetValue = function(newValue)
            for _, opt in ipairs(options) do
                if opt == newValue then
                    selectedValue = newValue
                    currentSelectionDisplay.Text = labelText .. ": " .. tostring(selectedValue)
                    if callback then pcall(callback, selectedValue) end
                    break
                end
            end
        end,
        Instance = dropdownFrame,
        Destroy = function() -- Cleanup connections
            if mainPanelPosChangedConn then mainPanelPosChangedConn:Disconnect() end
            if mainPanelSizeChangedConn then mainPanelSizeChangedConn:Disconnect() end
            optionsFrame:Destroy() -- Options frame is parented to ScreenGui
            dropdownFrame:Destroy()
        end
    }
end

function OrionLib:AddTextBox(placeholderText, callbackOnEnter, allowMultiline)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()

    local height = allowMultiline and (OrionLib.Config.ElementHeight * 2.5) or OrionLib.Config.ElementHeight
    local textBox = Create("TextBox", { Name = "OrionTextBox", Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = OrionLib.Config.LightBackgroundColor, Font = OrionLib.Config.Font,
        Text = "", PlaceholderText = placeholderText, PlaceholderColor3 = OrionLib.Config.PlaceholderColor,
        TextColor3 = OrionLib.Config.TextColor, ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = allowMultiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        MultiLine = allowMultiline or false, Parent = OrionLib.State.CurrentSection
    })
    ApplyCorner(textBox)
    Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
        PaddingTop = UDim.new(0, allowMultiline and 5 or 0), Parent = textBox
    })

    textBox.FocusLost:Connect(function(enterPressed)
        CloseActiveDropdown()
        if enterPressed and callbackOnEnter then
            pcall(callbackOnEnter, textBox.Text)
        elseif not enterPressed and callbackOnEnter and not allowMultiline then 
            pcall(callbackOnEnter, textBox.Text)
        end
    end)
    textBox.Focused:Connect(CloseActiveDropdown)

    return {
        GetValue = function() return textBox.Text end,
        SetValue = function(newText) textBox.Text = newText end,
        Clear = function() textBox.Text = "" end,
        Instance = textBox
    }
end

function OrionLib:AddLabel(text, alignment, size)
    assert(OrionLib.State.Initialized, OrionLib.Name .. " not initialized.")
    assert(OrionLib.State.CurrentSection, "No section active. Call :AddSection() first.")
    CloseActiveDropdown()
    
    local label = Create("TextLabel", { Name = "OrionLabel",
        Size = UDim2.new(1, 0, 0, size or OrionLib.Config.ElementHeight),
        BackgroundTransparency = 1, Font = OrionLib.Config.Font, Text = text,
        TextColor3 = OrionLib.Config.TextColor,
        TextXAlignment = alignment or Enum.TextXAlignment.Left,
        TextWrapped = true, Parent = OrionLib.State.CurrentSection
    })
    return {
        SetText = function(newText) label.Text = newText end,
        Instance = label
    }
end

function OrionLib:Destroy()
    print("OrionLib: Destroy called.")
    if OrionLib.Elements.ScreenGui then
        -- Manually destroy elements that have renderstep or event connections to prevent memory leaks
        for _, child in ipairs(OrionLib.Elements.ContentFrame:GetChildren()) do
            if child:IsA("Frame") and child.Name:match("OrionSliderFrame") then
                local sliderObject = nil -- Need to find a way to get back the slider object to call its Destroy method
                -- This part is tricky without storing all created objects with their Destroy methods.
                -- For now, just destroying the GUI elements. Proper cleanup needs more structure.
            elseif child:IsA("Frame") and child.Name:match("OrionDropdownFrame") then
                -- Similar issue for dropdowns, optionsFrame is parented elsewhere.
            end
        end
        -- A simpler approach for now, assuming most connections are handled by Roblox GC when instances are destroyed.
        -- However, RenderStepped functions MUST be unbound.
        -- This is a simplified Destroy. A full one would iterate created elements and call their specific destroy methods if they exist.
        RunService:UnbindFromRenderStep("OrionSliderUpdate_.*") -- Attempt to unbind all sliders (regex might not work here)
                                                                -- Proper way is to store names and unbind one by one.

        OrionLib.Elements.ScreenGui:Destroy()
    end
    OrionLib.State = { Initialized = false, Visible = true, Dragging = false, DragStart = nil,
                       FrameStart = nil, CurrentSection = nil, ActiveDropdown = nil }
    OrionLib.Elements = {}
    ServicesInitialized = false -- Reset service init flag
    print(OrionLib.Name .. " Destroyed.")
end

print("OrionLib: Script loaded. Ready for Init.")
_G.OrionLib = OrionLib
return OrionLib
