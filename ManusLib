    mainFrame.Parent = owner.ContentFrame
    mainFrame.ZIndex = properties.ZIndex or (owner.ContentFrame.ZIndex + #owner.Elements + 50) -- Higher ZIndex for dropdown list

    setmetatable(newDropdownObj, DropdownElement)
    newDropdownObj = DropdownElement:New("Dropdown", properties, mainFrame, owner)

    newDropdownObj.Options = {}; newDropdownObj.SelectedOption = nil; newDropdownObj.SelectedIndex = -1
    newDropdownObj.ChangedCallback = nil; newDropdownObj.IsExpanded = false

    newDropdownObj.DisplayButton = Instance.new("TextButton")
    newDropdownObj.DisplayButton.Name = "DisplayButton"; newDropdownObj.DisplayButton.Size = UDim2.new(1,0,1,0)
    newDropdownObj.DisplayButton.BackgroundColor3 = properties.BackgroundColor or theme.DefaultElementColor
    newDropdownObj.DisplayButton.BorderColor3 = properties.BorderColor or theme.DefaultBorderColor
    newDropdownObj.DisplayButton.BorderSizePixel = properties.BorderSizePixel or 1
    newDropdownObj.DisplayButton.Font = properties.Font or theme.DefaultFont
    newDropdownObj.DisplayButton.TextColor3 = properties.TextColor or theme.DefaultTextColor
    newDropdownObj.DisplayButton.TextSize = properties.TextSize or 14
    newDropdownObj.DisplayButton.Text = properties.PlaceholderText or "Select..."
    newDropdownObj.DisplayButton.TextXAlignment = Enum.TextXAlignment.Left
    local pad = Instance.new("UIPadding"); pad.PaddingLeft=UDim.new(0,5); pad.Parent = newDropdownObj.DisplayButton
    newDropdownObj.DisplayButton.Parent = mainFrame

    newDropdownObj.ArrowIcon = Instance.new("TextLabel")
    newDropdownObj.ArrowIcon.Name = "ArrowIcon"; newDropdownObj.ArrowIcon.Size = UDim2.new(0,20,1,0)
    newDropdownObj.ArrowIcon.Position = UDim2.new(1,-20,0,0); newDropdownObj.ArrowIcon.BackgroundTransparency=1
    newDropdownObj.ArrowIcon.Font = Enum.Font.SourceSansBold; newDropdownObj.ArrowIcon.TextColor3 = newDropdownObj.DisplayButton.TextColor3
    newDropdownObj.ArrowIcon.TextSize = 18; newDropdownObj.ArrowIcon.Text = "▼"; newDropdownObj.ArrowIcon.Parent = newDropdownObj.DisplayButton

    newDropdownObj.OptionsScrollFrame = Instance.new("ScrollingFrame")
    newDropdownObj.OptionsScrollFrame.Name = "OptionsScrollFrame"
    newDropdownObj.OptionsScrollFrame.Size = UDim2.new(1,0,0, properties.MaxVisibleOptionsHeight or 100)
    newDropdownObj.OptionsScrollFrame.Position = UDim2.new(0,0,1,2)
    newDropdownObj.OptionsScrollFrame.BackgroundColor3 = properties.ListBackgroundColor or Color3.fromRGB(55,55,55)
    newDropdownObj.OptionsScrollFrame.BorderColor3 = properties.ListBorderColor or Color3.fromRGB(40,40,40)
    newDropdownObj.OptionsScrollFrame.BorderSizePixel = 1; newDropdownObj.OptionsScrollFrame.Visible = false
    newDropdownObj.OptionsScrollFrame.ZIndex = mainFrame.ZIndex + 1 
    newDropdownObj.OptionsScrollFrame.ScrollBarThickness = 6; newDropdownObj.OptionsScrollFrame.Parent = mainFrame

    newDropdownObj.OptionsLayout = Instance.new("UIListLayout")
    newDropdownObj.OptionsLayout.SortOrder = Enum.SortOrder.LayoutOrder; newDropdownObj.OptionsLayout.Padding = UDim.new(0,2)
    newDropdownObj.OptionsLayout.Parent = newDropdownObj.OptionsScrollFrame

    local function toggleList() 
        if not newDropdownObj.IsEnabled then return end
        newDropdownObj.IsExpanded = not newDropdownObj.IsExpanded
        newDropdownObj.OptionsScrollFrame.Visible = newDropdownObj.IsExpanded
        newDropdownObj.ArrowIcon.Text = newDropdownObj.IsExpanded and "▲" or "▼"
        if newDropdownObj.IsExpanded then 
            newDropdownObj.OptionsScrollFrame.CanvasSize = UDim2.new(0,0,0, newDropdownObj.OptionsLayout.AbsoluteContentSize.Y)
        end
    end
    newDropdownObj.DisplayButton.MouseButton1Click:Connect(toggleList)

    function newDropdownObj:AddOption(optionText, optionValue)
        local value = optionValue or optionText
        local entry = {Text=optionText, Value=value, Index = #self.Options+1}
        table.insert(self.Options, entry)
        local optButton = Instance.new("TextButton")
        optButton.Name = "Option_"..entry.Index; optButton.Text = optionText
        optButton.Size = UDim2.new(1,0,0,properties.OptionHeight or 25)
        optButton.BackgroundColor3 = properties.OptionBackgroundColor or Color3.fromRGB(70,70,70)
        optButton.BorderColor3 = properties.OptionBorderColor or Color3.fromRGB(50,50,50)
        optButton.Font = properties.OptionFont or theme.DefaultFont
        optButton.TextColor3 = properties.OptionTextColor or theme.DefaultTextColor
        optButton.TextSize = properties.OptionTextSize or 13; optButton.LayoutOrder = entry.Index
        optButton.Parent = self.OptionsScrollFrame
        optButton.MouseButton1Click:Connect(function() if not self.IsEnabled then return end self:SetSelected(entry.Index, true); toggleList() end)
        local normalOptColor = optButton.BackgroundColor3
        local hoverOptColor = properties.OptionHoverColor or normalOptColor:Lerp(Color3.new(1,1,1),0.1)
        optButton.MouseEnter:Connect(function() if self.IsEnabled then optButton.BackgroundColor3 = hoverOptColor end end)
        optButton.MouseLeave:Connect(function() optButton.BackgroundColor3 = normalOptColor end)
        entry.ButtonInstance = optButton
        if #self.Options == 1 and not self.SelectedOption and (properties.SelectFirstByDefault==nil or properties.SelectFirstByDefault) then self:SetSelected(1,false) end
        return entry
    end
    function newDropdownObj:SetSelected(idxOrVal, triggerCb)
        local optSel, newIdx = nil,-1
        if type(idxOrVal)=="number" and idxOrVal > 0 and idxOrVal <= #self.Options then optSel,newIdx=self.Options[idxOrVal],idxOrVal
        elseif type(idxOrVal)~="number" then for i,opt in ipairs(self.Options) do if opt.Value==idxOrVal then optSel,newIdx=opt,i; break end end end
        if optSel then self.SelectedOption,self.SelectedIndex=optSel,newIdx; self.DisplayButton.Text=optSel.Text
            if (triggerCb==nil or triggerCb) and self.ChangedCallback then pcall(self.ChangedCallback, optSel.Value, optSel.Index) end
        end
    end
    if properties.Options then for _,optD in ipairs(properties.Options) do if type(optD)=="table" then newDropdownObj:AddOption(optD.Text, optD.Value) else newDropdownObj:AddOption(tostring(optD)) end end end
    if properties.DefaultValue then newDropdownObj:SetSelected(properties.DefaultValue, false) elseif properties.DefaultIndex then newDropdownObj:SetSelected(properties.DefaultIndex, false) end

    table.insert(owner.Elements, newDropdownObj)
    newDropdownObj:SetEnabled(newDropdownObj.IsEnabled)
    return newDropdownObj
end
function Tab:AddDropdown(properties) return AddDropdown_Impl(self, properties) end
function Window:AddDropdown(properties) return delegateToActiveTab(self, "AddDropdown", properties) end

