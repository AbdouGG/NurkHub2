                return textBox
            end
            
            -- Create Label
            function section:CreateLabel(text)
                local label = {}
                
                label.Container = createInstance("Frame", {
                    Name = "Label",
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
