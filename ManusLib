--[[
    ProUI - A Modern, Smooth UI Library for Roblox Executors
    
    Features:
    - Clean, modern design
    - Mobile friendly
    - Toggleable UI with outside button
    - Easy-to-use API
    - Smooth animations
]]

local ProUI = {}
ProUI.__index = ProUI

-- Configuration
local config = {
    colors = {
        background = Color3.fromRGB(30, 30, 35),
        accent = Color3.fromRGB(90, 120, 255),
        text = Color3.fromRGB(255, 255, 255),
        button = Color3.fromRGB(45, 45, 50),
        buttonHover = Color3.fromRGB(55, 55, 60),
        shadow = Color3.fromRGB(15, 15, 20),
        success = Color3.fromRGB(70, 200, 120),
        error = Color3.fromRGB(255, 80, 80),
        warning = Color3.fromRGB(255, 180, 70)
    },
    cornerRadius = UDim.new(0, 6),
    padding = UDim.new(0, 10),
    fonts = {
        title = Enum.Font.GothamBold,
        regular = Enum.Font.Gotham,
        light = Enum.Font.GothamMedium
    },
    animation = {
        duration = 0.3,
        easing = Enum.EasingStyle.Quint
    }
}

-- Utility functions
local function createShadow(parent, size, position, radius)
    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://6014261993"
    shadow.ImageColor3 = config.colors.shadow
    shadow.ImageTransparency = 0.5
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(49, 49, 450, 450)
    shadow.Size = UDim2.new(size.X.Scale, size.X.Offset + 20, size.Y.Scale, size.Y.Offset + 20)
    shadow.Position = UDim2.new(position.X.Scale, position.X.Offset - 10, position.Y.Scale, position.Y.Offset - 10)
    shadow.ZIndex = parent.ZIndex - 1
    shadow.Parent = parent
    return shadow
end

local function createRipple(button)
    local ripple = Instance.new("Frame")
    ripple.Name = "Ripple"
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ripple.BackgroundTransparency = 0.7
    ripple.BorderSizePixel = 0
    ripple.Position = UDim2.fromScale(0.5, 0.5)
    ripple.Size = UDim2.fromScale(0, 0)
    ripple.ZIndex = button.ZIndex + 1
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = ripple
    
    ripple.Parent = button
    
    -- Animate ripple
    local targetSize = UDim2.fromScale(2, 2)
    ripple:TweenSize(
        targetSize,
        Enum.EasingDirection.Out,
        config.animation.easing,
        config.animation.duration,
        false,
        function()
            ripple:TweenProperty(
                "BackgroundTransparency",
                1,
                Enum.EasingDirection.Out,
                config.animation.easing,
                config.animation.duration,
                false,
                function()
                    ripple:Destroy()
                end
            )
        end
    )
end

-- Create new UI library instance
function ProUI.new(title)
    local self = setmetatable({}, ProUI)
    
    -- Main instances
    self.connections = {}
    self.title = title or "ProUI"
    self.visible = true
    self.dragging = false
    self.dragInput = nil
    self.dragStart = nil
    self.startPos = nil
    
    -- Create ScreenGui
    self.screenGui = Instance.new("ScreenGui")
    self.screenGui.Name = "ProUI"
    self.screenGui.ResetOnSpawn = false
    self.screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    -- Set parent based on environment
    if syn and syn.protect_gui then
        syn.protect_gui(self.screenGui)
        self.screenGui.Parent = game:GetService("CoreGui")
    elseif gethui then
        self.screenGui.Parent = gethui()
    elseif game:GetService("CoreGui"):FindFirstChild("RobloxGui") then
        self.screenGui.Parent = game:GetService("CoreGui").RobloxGui
    else
        self.screenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end
    
    -- Create toggle button (outside main panel)
    self.toggleButton = Instance.new("TextButton")
    self.toggleButton.Name = "ToggleButton"
    self.toggleButton.Size = UDim2.fromOffset(40, 40)
    self.toggleButton.Position = UDim2.new(0, 20, 0.5, -20)
    self.toggleButton.BackgroundColor3 = config.colors.accent
    self.toggleButton.Font = config.fonts.title
    self.toggleButton.Text = "≡"
    self.toggleButton.TextColor3 = config.colors.text
    self.toggleButton.TextSize = 20
    self.toggleButton.AutoButtonColor = false
    self.toggleButton.ZIndex = 1000
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = self.toggleButton
    
    createShadow(self.toggleButton, self.toggleButton.Size, self.toggleButton.Position, UDim.new(1, 0))
    
    self.toggleButton.MouseButton1Click:Connect(function()
        self:Toggle()
        createRipple(self.toggleButton)
    end)
    self.toggleButton.Parent = self.screenGui
    
    -- Main panel
    self.mainFrame = Instance.new("Frame")
    self.mainFrame.Name = "MainPanel"
    self.mainFrame.Size = UDim2.fromOffset(300, 350)
    self.mainFrame.Position = UDim2.new(0, 100, 0.5, -175)
    self.mainFrame.BackgroundColor3 = config.colors.background
    self.mainFrame.BorderSizePixel = 0
    self.mainFrame.ZIndex = 100
    
    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = config.cornerRadius
    mainCorner.Parent = self.mainFrame
    
    createShadow(self.mainFrame, self.mainFrame.Size, self.mainFrame.Position, config.cornerRadius)
    
    -- Title bar
    self.titleBar = Instance.new("Frame")
    self.titleBar.Name = "TitleBar"
    self.titleBar.Size = UDim2.new(1, 0, 0, 40)
    self.titleBar.Position = UDim2.fromOffset(0, 0)
    self.titleBar.BackgroundColor3 = config.colors.accent
    self.titleBar.BorderSizePixel = 0
    self.titleBar.ZIndex = 101
    
    local titleCorner = Instance.new("UICorner")
    titleCorner.CornerRadius = config.cornerRadius
    titleCorner.Parent = self.titleBar
    
    local cornerFix = Instance.new("Frame")
    cornerFix.Name = "CornerFix"
    cornerFix.Size = UDim2.new(1, 0, 0, 10)
    cornerFix.Position = UDim2.new(0, 0, 1, -10)
    cornerFix.BackgroundColor3 = config.colors.accent
    cornerFix.BorderSizePixel = 0
    cornerFix.ZIndex = 101
    cornerFix.Parent = self.titleBar
    
    self.titleText = Instance.new("TextLabel")
    self.titleText.Name = "Title"
    self.titleText.Size = UDim2.new(1, -20, 1, 0)
    self.titleText.Position = UDim2.fromOffset(10, 0)
    self.titleText.BackgroundTransparency = 1
    self.titleText.Font = config.fonts.title
    self.titleText.Text = self.title
    self.titleText.TextColor3 = config.colors.text
    self.titleText.TextSize = 18
    self.titleText.TextXAlignment = Enum.TextXAlignment.Left
    self.titleText.ZIndex = 102
    self.titleText.Parent = self.titleBar
    
    -- Close button
    self.closeButton = Instance.new("TextButton")
    self.closeButton.Name = "CloseButton"
    self.closeButton.Size = UDim2.fromOffset(30, 30)
    self.closeButton.Position = UDim2.new(1, -35, 0, 5)
    self.closeButton.BackgroundColor3 = config.colors.error
    self.closeButton.Font = config.fonts.title
    self.closeButton.Text = "×"
    self.closeButton.TextColor3 = config.colors.text
    self.closeButton.TextSize = 20
    self.closeButton.AutoButtonColor = false
    self.closeButton.ZIndex = 102
    
    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 6)
    closeCorner.Parent = self.closeButton
    
    self.closeButton.MouseButton1Click:Connect(function()
        createRipple(self.closeButton)
        self:Destroy()
    end)
    self.closeButton.Parent = self.titleBar
    
