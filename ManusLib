                local pos
                if input then
                    pos = Vector2.new(input.Position.X, input.Position.Y)
                else
                    pos = Vector2.new(SliderButton.AbsolutePosition.X + (currentValue - min) / (max - min) * SliderTrack.AbsoluteSize.X, SliderButton.AbsolutePosition.Y)
                end
                
                local relativeX = pos.X - SliderTrack.AbsolutePosition.X
                local percent = math.clamp(relativeX / SliderTrack.AbsoluteSize.X, 0, 1)
                
                if precise then
                    currentValue = math.floor(min + (max - min) * percent)
                else
                    currentValue = min + (max - min) * percent
                end
                
                SliderFill.Size = UDim2.new(percent, 0, 1, 0)
                SliderValue.Text = tostring(math.floor(currentValue * 100) / 100)
                callback(currentValue)
            end
            
            SliderButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input)
                end
