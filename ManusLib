                local sliderBackCorner = createInstance("UICorner", {
                    Name = "SliderBackCorner",
                    CornerRadius = UDim.new(0, 3),
                    Parent = slider.SliderBackground
                })
                
                slider.SliderFill = createInstance("Frame", {
                    Name = "SliderFill",
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = Color3.fromRGB(0, 170, 255),
                    BorderSizePixel = 0,
                    Parent = slider.SliderBackground
                })
                
                local sliderFillCorner = createInstance("UICorner", {
                    Name = "SliderFillCorner",
                    CornerRadius = UDim.new(0, 3),
                    Parent = slider.SliderFill
                })
                
                function slider:Set(value)
                    value = math.clamp(value, min, max)
                    value = math.floor(value * (10 ^ decimals)) / (10 ^ decimals)
                    
                    slider.Value = value
                    slider.ValueLabel.Text = tostring(value)
                    slider.SliderFill:TweenSize(
                        UDim2.new((value - min) / (max - min), 0, 1, 0),
                        Enum.EasingDirection.Out,
                        Enum.EasingStyle.Quad,
                        0.2,
                        true
                    )
                    
                    if flag then
                        PlantUI.Flags[flag] = value
                    end
                    
                    callback(value)
                end
                
                slider.SliderBackground.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        local relativePos = math.clamp((input.Position.X - slider.SliderBackground.AbsolutePosition.X) / slider.SliderBackground.AbsoluteSize.X, 0, 1)
                        local value = min + ((max - min) * relativePos)
                        slider:Set(value)
                        
                        local dragging = true
                        local connection
                        
                        connection = RunService.RenderStepped:Connect(function()
                            if dragging then
                                local relativePos = math.clamp((Mouse.X - slider.SliderBackground.AbsolutePosition.X) / slider.SliderBackground.AbsoluteSize.X, 0, 1)
                                local value = min + ((max - min) * relativePos)
                                slider:Set(value)
                            else
                                connection:Disconnect()
                            end
                        end)
                        
                        input.Changed:Connect(function()
                            if input.UserInputState == Enum.UserInputState.End then
                                dragging = false
                            end
                        end)
                    end
                end)
                
                if flag then
                    PlantUI.Flags[flag] = default
                end
                
                slider:Set(default)
                return slider
            end
            
