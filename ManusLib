function OrionLib:CreateWindow(properties)
    properties = properties or {}
    local newWindow = {}
    setmetatable(newWindow, Window)

    newWindow.Theme = properties.Theme or {}
    -- Default theme values
    newWindow.Theme.BackgroundColor = newWindow.Theme.BackgroundColor or Color3.fromRGB(35,35,35)
    newWindow.Theme.TitleBarColor = newWindow.Theme.TitleBarColor or Color3.fromRGB(25,25,25)
    newWindow.Theme.TitleTextColor = newWindow.Theme.TitleTextColor or Color3.fromRGB(220,220,220)
    newWindow.Theme.CloseButtonColor = newWindow.Theme.CloseButtonColor or Color3.fromRGB(200,50,50)
    newWindow.Theme.CloseButtonHoverColor = newWindow.Theme.CloseButtonHoverColor or Color3.fromRGB(230,80,80)
    newWindow.Theme.BorderColor = newWindow.Theme.BorderColor or Color3.fromRGB(15,15,15)
    newWindow.Theme.TabBarColor = newWindow.Theme.TabBarColor or Color3.fromRGB(30,30,30)
    newWindow.Theme.TabInactiveColor = newWindow.Theme.TabInactiveColor or Color3.fromRGB(50,50,50)
    newWindow.Theme.TabActiveColor = newWindow.Theme.TabActiveColor or newWindow.Theme.BackgroundColor 
    newWindow.Theme.TabInactiveTextColor = newWindow.Theme.TabInactiveTextColor or Color3.fromRGB(160,160,160)
    newWindow.Theme.TabActiveTextColor = newWindow.Theme.TabActiveTextColor or Color3.fromRGB(255,255,255)
    newWindow.Theme.TabFont = newWindow.Theme.TabFont or Enum.Font.SourceSansSemibold
    newWindow.Theme.TabTextSize = newWindow.Theme.TabTextSize or 14
    newWindow.Theme.DefaultFont = newWindow.Theme.DefaultFont or Enum.Font.SourceSans
    newWindow.Theme.DefaultTextColor = newWindow.Theme.DefaultTextColor or Color3.fromRGB(220,220,220)
    newWindow.Theme.DefaultElementColor = newWindow.Theme.DefaultElementColor or Color3.fromRGB(60,60,60)
    newWindow.Theme.DefaultElementHoverColor = newWindow.Theme.DefaultElementHoverColor or Color3.fromRGB(75,75,75)
    newWindow.Theme.DefaultBorderColor = newWindow.Theme.DefaultBorderColor or Color3.fromRGB(45,45,45)
    newWindow.Theme.DisabledColor = newWindow.Theme.DisabledColor or Color3.fromRGB(80,80,80)
    newWindow.Theme.TitleFont = newWindow.Theme.TitleFont or Enum.Font.SourceSansBold
    newWindow.Theme.TitleTextSize = newWindow.Theme.TitleTextSize or 16

    newWindow.RobloxInstance = Instance.new("Frame")
    newWindow.RobloxInstance.Name = properties.Name or "OrionWindow"
    newWindow.RobloxInstance.Size = properties.Size or UDim2.new(0, 450, 0, 350)
    newWindow.RobloxInstance.Position = properties.Position or UDim2.new(0.5, -newWindow.RobloxInstance.AbsoluteSize.X/2, 0.5, -newWindow.RobloxInstance.AbsoluteSize.Y/2)
    newWindow.RobloxInstance.BackgroundColor3 = newWindow.Theme.BackgroundColor
    newWindow.RobloxInstance.BorderSizePixel = 1
    newWindow.RobloxInstance.BorderColor3 = newWindow.Theme.BorderColor
    newWindow.RobloxInstance.Active = true
    newWindow.RobloxInstance.Draggable = false 
    newWindow.RobloxInstance.Visible = properties.Visible == nil and true or properties.Visible
    newWindow.RobloxInstance.ClipsDescendants = true
    newWindow.RobloxInstance.Parent = properties.Parent or getScreenGui()
    newWindow.RobloxInstance.ZIndex = properties.ZIndex or 1

    local titleBarHeight = properties.TitleBarHeight or 28
    newWindow.TitleBar = Instance.new("Frame")
    newWindow.TitleBar.Name = "TitleBar"
    newWindow.TitleBar.Size = UDim2.new(1, 0, 0, titleBarHeight)
    newWindow.TitleBar.BackgroundColor3 = newWindow.Theme.TitleBarColor
    newWindow.TitleBar.Parent = newWindow.RobloxInstance

    newWindow.TitleLabel = Instance.new("TextLabel")
    newWindow.TitleLabel.Name = "TitleLabel"
    newWindow.TitleLabel.Size = UDim2.new(1, -(titleBarHeight + 5), 1, 0) 
    newWindow.TitleLabel.Text = properties.Title or "OrionLib Window"
    newWindow.TitleLabel.Font = newWindow.Theme.TitleFont
    newWindow.TitleLabel.TextColor3 = newWindow.Theme.TitleTextColor
    newWindow.TitleLabel.TextSize = newWindow.Theme.TitleTextSize
    newWindow.TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    local titlePadding = Instance.new("UIPadding"); titlePadding.PaddingLeft = UDim.new(0,8); titlePadding.Parent = newWindow.TitleLabel
    newWindow.TitleLabel.Parent = newWindow.TitleBar

    if properties.Closable == nil or properties.Closable then
        newWindow.CloseButton = Instance.new("TextButton")
        newWindow.CloseButton.Name = "CloseButton"
        newWindow.CloseButton.Size = UDim2.new(0, titleBarHeight - 6, 0, titleBarHeight - 6)
        newWindow.CloseButton.Position = UDim2.new(1, -(titleBarHeight - 3) , 0.5, -(titleBarHeight-6)/2)
        newWindow.CloseButton.Text = "X"
        newWindow.CloseButton.Font = Enum.Font.SourceSansBold
        newWindow.CloseButton.TextColor3 = newWindow.Theme.TitleTextColor
        newWindow.CloseButton.TextSize = 16
        newWindow.CloseButton.BackgroundColor3 = newWindow.Theme.CloseButtonColor
        newWindow.CloseButton.Parent = newWindow.TitleBar
        newWindow.CloseButton.MouseButton1Click:Connect(function() newWindow:Close() end)
        local cbNormalColor = newWindow.Theme.CloseButtonColor
        local cbHoverColor = newWindow.Theme.CloseButtonHoverColor
        newWindow.CloseButton.MouseEnter:Connect(function() newWindow.CloseButton.BackgroundColor3 = cbHoverColor end)
        newWindow.CloseButton.MouseLeave:Connect(function() newWindow.CloseButton.BackgroundColor3 = cbNormalColor end)
    end

    if properties.Draggable == nil or properties.Draggable then
        local dragging = false; local dragInput, dragStart, startPos
        newWindow.TitleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                newWindow:Focus() -- Bring to front on drag
                dragging = true; dragStart = input.Position; startPos = newWindow.RobloxInstance.Position
                input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
            end
        end)
        newWindow.TitleBar.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                newWindow.RobloxInstance.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    local tabBarHeightPx = properties.TabBarHeight or 30
    newWindow.TabBarFrame = Instance.new("Frame")
    newWindow.TabBarFrame.Name = "TabBarFrame"
    newWindow.TabBarFrame.Size = UDim2.new(1, 0, 0, tabBarHeightPx)
    newWindow.TabBarFrame.Position = UDim2.new(0, 0, 0, titleBarHeight) 
    newWindow.TabBarFrame.BackgroundColor3 = newWindow.Theme.TabBarColor
    newWindow.TabBarFrame.Parent = newWindow.RobloxInstance

    newWindow.TabBarLayout = Instance.new("UIListLayout")
    newWindow.TabBarLayout.FillDirection = Enum.FillDirection.Horizontal
    newWindow.TabBarLayout.Padding = UDim.new(0, properties.TabSpacing or 2)
    newWindow.TabBarLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    newWindow.TabBarLayout.Parent = newWindow.TabBarFrame

    newWindow.TabDisplayFrame = Instance.new("Frame")
    newWindow.TabDisplayFrame.Name = "TabDisplayFrame"
    newWindow.TabDisplayFrame.Size = UDim2.new(1, 0, 1, -(titleBarHeight + tabBarHeightPx))
    newWindow.TabDisplayFrame.Position = UDim2.new(0, 0, 0, titleBarHeight + tabBarHeightPx)
    newWindow.TabDisplayFrame.BackgroundTransparency = 1
    newWindow.TabDisplayFrame.Parent = newWindow.RobloxInstance

    newWindow.Tabs = {}
    newWindow.ActiveTab = nil
    newWindow.Elements = {} 

    OrionLib.ActiveWindows = OrionLib.ActiveWindows or {}
    table.insert(OrionLib.ActiveWindows, newWindow)
    newWindow:Focus() -- Focus new window
    return newWindow
end

function Window:SetTitle(title) self.TitleLabel.Text = title end
function Window:SetVisible(visible) self.RobloxInstance.Visible = visible; if visible then self:Focus() end end
function Window:IsVisible() return self.RobloxInstance.Visible end
function Window:Close() self:SetVisible(false) end -- Could be :Destroy() or configurable

function Window:Destroy()
    if self.RobloxInstance then self.RobloxInstance:Destroy() end
    if OrionLib.ActiveWindows then
        for i, win in ipairs(OrionLib.ActiveWindows) do if win == self then table.remove(OrionLib.ActiveWindows, i); break end end
    end
    for k in pairs(self) do self[k] = nil end; setmetatable(self, nil)
end

function Window:Focus()
    if not OrionLib.MaxZIndex then OrionLib.MaxZIndex = (getScreenGui().DisplayOrder * 1000) + 100 end
    OrionLib.MaxZIndex = OrionLib.MaxZIndex + 5 -- Increment by more to ensure layers are distinct
    self.RobloxInstance.ZIndex = OrionLib.MaxZIndex
    self.TitleBar.ZIndex = OrionLib.MaxZIndex + 1
    self.TabBarFrame.ZIndex = OrionLib.MaxZIndex + 1
    if self.CloseButton then self.CloseButton.ZIndex = OrionLib.MaxZIndex + 2 end
    if self.ActiveTab and self.ActiveTab.TabButton then self.ActiveTab.TabButton.ZIndex = OrionLib.MaxZIndex + 2 end
end

function Window:AddTab(tabProperties)
    tabProperties = tabProperties or {}
    local newTabObj = Tab:New(self, tabProperties)
    local theme = self.Theme

    local tabButton = Instance.new("TextButton")
    tabButton.Name = newTabObj.Name .. "_Button"
    tabButton.Text = newTabObj.Title
    tabButton.Size = UDim2.new(0, tabProperties.ButtonWidth or 100, 0, (self.TabBarFrame.AbsoluteSize.Y) - 4)
    tabButton.BackgroundColor3 = theme.TabInactiveColor
    tabButton.TextColor3 = theme.TabInactiveTextColor
    tabButton.Font = theme.TabFont
    tabButton.TextSize = theme.TabTextSize
    tabButton.Parent = self.TabBarFrame
    tabButton.ZIndex = self.TabBarFrame.ZIndex

    newTabObj.TabButton = tabButton
    tabButton.MouseButton1Click:Connect(function() self:SelectTab(newTabObj) end)
    table.insert(self.Tabs, newTabObj)
    if not self.ActiveTab or (#self.Tabs == 1 and (tabProperties.SelectByDefault == nil or tabProperties.SelectByDefault)) then
        self:SelectTab(newTabObj)
    end
    return newTabObj
end

function Window:SelectTab(tabToSelect)
    local targetTab = nil
    if type(tabToSelect) == "string" then
        for _, t in ipairs(self.Tabs) do if t.Name == tabToSelect or t.Title == tabToSelect then targetTab = t; break end end
    elseif type(tabToSelect) == "table" and getmetatable(tabToSelect) == Tab then targetTab = tabToSelect end

    if targetTab and targetTab ~= self.ActiveTab then
        if self.ActiveTab then self.ActiveTab:Deselect() end
        targetTab:Select()
        self:Focus() -- Bring window to front when tab changes
    elseif targetTab and targetTab == self.ActiveTab and targetTab.OnSelectedCallback and type(targetTab.OnSelectedCallback) == "function" then
        -- pcall(targetTab.OnSelectedCallback, targetTab) -- Optionally re-trigger if already selected
    end
end

local function delegateToActiveTab(window, methodName, properties)
    if not window.ActiveTab then
        if #window.Tabs == 0 then
            local defaultTab = window:AddTab({Title = "Main", Name = "_defaultMainTab", SelectByDefault = true})
        else window:SelectTab(window.Tabs[1]) end
    end
    if window.ActiveTab and window.ActiveTab[methodName] then
        return window.ActiveTab[methodName](window.ActiveTab, properties)
    else warn("OrionLib: No active tab or method " .. methodName .. " not found on tab."); return nil end
end

-- Element Definitions (Button, ToggleButton, Slider, Dropdown, Label, Paragraph, Section)
-- Forward declare specific element types
local ButtonElement, ToggleButtonElement, SliderElement, DropdownElement, TextLabelElement, ParagraphElement

--[[------------------------------------------------------------------------------------------------
-- Button Element
--------------------------------------------------------------------------------------------------]]
ButtonElement = setmetatable({}, BaseElement)
ButtonElement.__index = ButtonElement

local function AddButton_Impl(owner, properties) -- owner is Tab or Section
    properties = properties or {}
    local newButtonObj = {}
    local theme = owner:GetTheme() -- Use GetTheme from owner (Tab/Section)

    local button = Instance.new("TextButton")
    button.Name = properties.Name or "Button"
    button.Text = properties.Text or "Button"
    button.Size = properties.Size or UDim2.new(1, (owner.Type == "Tab" and -10 or 0), 0, 30)
    button.BackgroundColor3 = properties.BackgroundColor or theme.DefaultElementColor
    button.BorderColor3 = properties.BorderColor or theme.DefaultBorderColor
    button.BorderSizePixel = properties.BorderSizePixel or 1
    button.Font = properties.Font or theme.DefaultFont
    button.TextColor3 = properties.TextColor or theme.DefaultTextColor
    button.TextSize = properties.TextSize or 14
    button.LayoutOrder = properties.LayoutOrder or #owner.Elements + 1
    button.Parent = owner.ContentFrame

    setmetatable(newButtonObj, ButtonElement)
    newButtonObj = ButtonElement:New("Button", properties, button, owner)

    newButtonObj.ClickCallback = nil
    button.MouseButton1Click:Connect(function()
        if newButtonObj.IsEnabled and newButtonObj.ClickCallback then pcall(newButtonObj.ClickCallback) end
    end)
    local normalColor = button.BackgroundColor3
    local hoverColor = properties.HoverColor or theme.DefaultElementHoverColor or normalColor:Lerp(Color3.new(1,1,1), 0.1)
    button.MouseEnter:Connect(function() if newButtonObj.IsEnabled then button.BackgroundColor3 = hoverColor end end)
    button.MouseLeave:Connect(function() if newButtonObj.IsEnabled then button.BackgroundColor3 = normalColor end end)

    table.insert(owner.Elements, newButtonObj)
    newButtonObj:SetEnabled(newButtonObj.IsEnabled) 
    return newButtonObj
end
function Tab:AddButton(properties) return AddButton_Impl(self, properties) end
function Window:AddButton(properties) return delegateToActiveTab(self, "AddButton", properties) end

function ButtonElement:OnClick(callback) self.ClickCallback = callback end
function ButtonElement:SetText(text) self.RobloxInstance.Text = text end
function ButtonElement:SetEnabled(enabled)
    BaseElement.SetEnabled(self, enabled)
    local theme = self:GetTheme()
    local normalColor = self.Properties.BackgroundColor or theme.DefaultElementColor
    self.RobloxInstance.BackgroundColor3 = enabled and normalColor or theme.DisabledColor
    if enabled then -- Re-apply hover setup if re-enabled
        local hoverColor = self.Properties.HoverColor or theme.DefaultElementHoverColor or normalColor:Lerp(Color3.new(1,1,1), 0.1)
        self.RobloxInstance.MouseEnter:Connect(function() if self.IsEnabled then self.RobloxInstance.BackgroundColor3 = hoverColor end end)
        self.RobloxInstance.MouseLeave:Connect(function() if self.IsEnabled then self.RobloxInstance.BackgroundColor3 = normalColor end end)
    else
        self.RobloxInstance.MouseEnter:ClearAllConnections() -- Simplified, might need specific connection management
        self.RobloxInstance.MouseLeave:ClearAllConnections()
    end
end

--[[------------------------------------------------------------------------------------------------
-- ToggleButton Element
--------------------------------------------------------------------------------------------------]]
ToggleButtonElement = setmetatable({}, ButtonElement)
ToggleButtonElement.__index = ToggleButtonElement

local function AddToggleButton_Impl(owner, properties)
    properties = properties or {}
    local newToggleObj = {}
    local theme = owner:GetTheme()

    local buttonInstance = Instance.new("TextButton")
    buttonInstance.Name = properties.Name or "ToggleButton"
    buttonInstance.Size = properties.Size or UDim2.new(1, (owner.Type == "Tab" and -10 or 0), 0, 30)
    buttonInstance.Font = properties.Font or theme.DefaultFont
    buttonInstance.TextColor3 = properties.TextColor or theme.DefaultTextColor
    buttonInstance.TextSize = properties.TextSize or 14
    buttonInstance.LayoutOrder = properties.LayoutOrder or #owner.Elements + 1
    buttonInstance.Parent = owner.ContentFrame

    setmetatable(newToggleObj, ToggleButtonElement)
    newToggleObj = ToggleButtonElement:New("ToggleButton", properties, buttonInstance, owner)
    
    newToggleObj.IsToggled = properties.InitialState or false
    newToggleObj.ToggleCallback = nil
    newToggleObj.ActiveColor = properties.ActiveColor or Color3.fromRGB(80, 160, 80)
    newToggleObj.InactiveColor = properties.InactiveColor or (properties.BackgroundColor or theme.DefaultElementColor)
    newToggleObj.ActiveText = properties.ActiveText or (properties.Text and properties.Text .. " (ON)") or "ON"
    newToggleObj.InactiveText = properties.InactiveText or (properties.Text and properties.Text .. " (OFF)") or "OFF"

    local function updateVisualState(isToggled)
        if isToggled then
            buttonInstance.BackgroundColor3 = newToggleObj.ActiveColor
            buttonInstance.Text = newToggleObj.ActiveText
        else
            buttonInstance.BackgroundColor3 = newToggleObj.InactiveColor
            buttonInstance.Text = newToggleObj.InactiveText
        end
    end
    updateVisualState(newToggleObj.IsToggled)

    buttonInstance.MouseButton1Click:Connect(function()
        if newToggleObj.IsEnabled then newToggleObj:SetState(not newToggleObj.IsToggled, true) end
    end)
    
    table.insert(owner.Elements, newToggleObj)
    newToggleObj:SetEnabled(newToggleObj.IsEnabled) 
    return newToggleObj
end
function Tab:AddToggleButton(properties) return AddToggleButton_Impl(self, properties) end
function Window:AddToggleButton(properties) return delegateToActiveTab(self, "AddToggleButton", properties) end

function ToggleButtonElement:OnToggle(callback) self.ToggleCallback = callback end
function ToggleButtonElement:SetState(toggled, triggerCallback)
    self.IsToggled = toggled
    if self.IsEnabled then
        if self.IsToggled then
            self.RobloxInstance.BackgroundColor3 = self.ActiveColor; self.RobloxInstance.Text = self.ActiveText
        else
            self.RobloxInstance.BackgroundColor3 = self.InactiveColor; self.RobloxInstance.Text = self.InactiveText
        end
    end
    if triggerCallback and self.ToggleCallback then pcall(self.ToggleCallback, self.IsToggled) end
end
function ToggleButtonElement:GetState() return self.IsToggled end
function ToggleButtonElement:SetEnabled(enabled)
    BaseElement.SetEnabled(self, enabled)
    local theme = self:GetTheme()
    if not enabled then self.RobloxInstance.BackgroundColor3 = theme.DisabledColor
    else self:SetState(self.IsToggled, false) end
end

--[[------------------------------------------------------------------------------------------------
-- Slider Element
--------------------------------------------------------------------------------------------------]]
SliderElement = setmetatable({}, BaseElement)
SliderElement.__index = SliderElement

local function AddSlider_Impl(owner, properties)
    properties = properties or {}
    local newSliderObj = {}
    local theme = owner:GetTheme()

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = properties.Name or "SliderFrame"
    mainFrame.Size = properties.Size or UDim2.new(1, (owner.Type == "Tab" and -10 or 0), 0, 40) 
    mainFrame.BackgroundTransparency = 1
    mainFrame.LayoutOrder = properties.LayoutOrder or #owner.Elements + 1
    mainFrame.Parent = owner.ContentFrame

    setmetatable(newSliderObj, SliderElement)
    newSliderObj = SliderElement:New("Slider", properties, mainFrame, owner)

    newSliderObj.Min = properties.Min or 0
    newSliderObj.Max = properties.Max or 100
    newSliderObj.Step = properties.Step or 1
    newSliderObj.CurrentValue = properties.Default or newSliderObj.Min
    newSliderObj.ChangedCallback = nil
    newSliderObj.ValueFormat = properties.ValueFormat or "%.2f"

    local labelHeight = 18
    newSliderObj.Label = Instance.new("TextLabel"); newSliderObj.Label.Name = "SliderLabel"
    newSliderObj.Label.Size = UDim2.new(0.6, -5, 0, labelHeight); newSliderObj.Label.Position = UDim2.new(0,0,0,0)
    newSliderObj.Label.Text = properties.Label or "Slider:"; newSliderObj.Label.Font = properties.Font or theme.DefaultFont
    newSliderObj.Label.TextColor3 = properties.TextColor or theme.DefaultTextColor; newSliderObj.Label.TextSize = properties.TextSize or 12
    newSliderObj.Label.BackgroundTransparency = 1; newSliderObj.Label.TextXAlignment = Enum.TextXAlignment.Left
    newSliderObj.Label.Parent = mainFrame

    newSliderObj.ValueLabel = Instance.new("TextLabel"); newSliderObj.ValueLabel.Name = "SliderValueLabel"
    newSliderObj.ValueLabel.Size = UDim2.new(0.4, 0, 0, labelHeight); newSliderObj.ValueLabel.Position = UDim2.new(0.6, 5, 0, 0)
    newSliderObj.ValueLabel.Font = properties.Font or theme.DefaultFont; newSliderObj.ValueLabel.TextColor3 = properties.ValueColor or theme.DefaultTextColor
    newSliderObj.ValueLabel.TextSize = properties.TextSize or 12; newSliderObj.ValueLabel.BackgroundTransparency = 1
    newSliderObj.ValueLabel.TextXAlignment = Enum.TextXAlignment.Right; newSliderObj.ValueLabel.Parent = mainFrame

    local trackHeight = 8
    newSliderObj.Track = Instance.new("Frame"); newSliderObj.Track.Name = "SliderTrack"
    newSliderObj.Track.Size = UDim2.new(1, 0, 0, trackHeight); newSliderObj.Track.Position = UDim2.new(0,0,0,labelHeight + 2)
    newSliderObj.Track.BackgroundColor3 = properties.TrackColor or Color3.fromRGB(50,50,50); newSliderObj.Track.BorderSizePixel = 0
    newSliderObj.Track.Parent = mainFrame

    newSliderObj.FillTrack = Instance.new("Frame"); newSliderObj.FillTrack.Name = "SliderFillTrack"
    newSliderObj.FillTrack.Size = UDim2.new(0,0,1,0); newSliderObj.FillTrack.BackgroundColor3 = properties.FillColor or Color3.fromRGB(100,100,200)
    newSliderObj.FillTrack.BorderSizePixel = 0; newSliderObj.FillTrack.Parent = newSliderObj.Track

    newSliderObj.Thumb = Instance.new("Frame"); newSliderObj.Thumb.Name = "SliderThumb"
    newSliderObj.Thumb.Size = UDim2.new(0, trackHeight + 4, 0, trackHeight + 4); newSliderObj.Thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    newSliderObj.Thumb.Position = UDim2.new(0,0,0.5,0); newSliderObj.Thumb.BackgroundColor3 = properties.ThumbColor or Color3.fromRGB(150,150,220)
    newSliderObj.Thumb.BorderSizePixel = 1; newSliderObj.Thumb.BorderColor3 = Color3.fromRGB(30,30,30); newSliderObj.Thumb.Parent = newSliderObj.Track

    local function updateSliderVisuals(value)
        local clampedVal = math.clamp(value, newSliderObj.Min, newSliderObj.Max)
        local percentage = (clampedVal - newSliderObj.Min) / (newSliderObj.Max - newSliderObj.Min)
        if (newSliderObj.Max - newSliderObj.Min) == 0 then percentage = 0 end -- Avoid div by zero
        percentage = math.clamp(percentage, 0, 1)
        newSliderObj.FillTrack.Size = UDim2.new(percentage, 0, 1, 0)
        newSliderObj.Thumb.Position = UDim2.new(percentage, 0, 0.5, 0)
        newSliderObj.ValueLabel.Text = string.format(newSliderObj.ValueFormat, clampedVal)
    end

    local function setValue(newValue, triggerCb)
        local steppedValue = newSliderObj.Min + math.floor(((newValue - newSliderObj.Min) / newSliderObj.Step) + 0.5) * newSliderObj.Step
        steppedValue = math.clamp(steppedValue, newSliderObj.Min, newSliderObj.Max)
        if newSliderObj.CurrentValue ~= steppedValue or triggerCb == false then -- Update visuals even if value is same for initial set
            newSliderObj.CurrentValue = steppedValue
            updateSliderVisuals(steppedValue)
            if triggerCb and newSliderObj.ChangedCallback then pcall(newSliderObj.ChangedCallback, steppedValue) end
        end
    end
    setValue(newSliderObj.CurrentValue, false)
    newSliderObj.SetValue = setValue

    local dragging = false
    local function handleInput(input)
        if not newSliderObj.IsEnabled then return end
        local trackAbsPos = newSliderObj.Track.AbsolutePosition; local trackAbsSize = newSliderObj.Track.AbsoluteSize
        local mouseX = input.Position.X - trackAbsPos.X
        local percentage = math.clamp(mouseX / trackAbsSize.X, 0, 1)
        local newValue = newSliderObj.Min + (newSliderObj.Max - newSliderObj.Min) * percentage
        setValue(newValue, true)
    end
    newSliderObj.Track.InputBegan:Connect(function(input) if not newSliderObj.IsEnabled then return end; if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; handleInput(input) end end)
    newSliderObj.Track.InputChanged:Connect(function(input) if not newSliderObj.IsEnabled then return end; if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then handleInput(input) end end)
    newSliderObj.Track.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    newSliderObj.Thumb.InputBegan:Connect(function(input) newSliderObj.Track.InputBegan:Fire(input) end)
    newSliderObj.Thumb.InputChanged:Connect(function(input) newSliderObj.Track.InputChanged:Fire(input) end)
    newSliderObj.Thumb.InputEnded:Connect(function(input) newSliderObj.Track.InputEnded:Fire(input) end)

    table.insert(owner.Elements, newSliderObj)
    newSliderObj:SetEnabled(newSliderObj.IsEnabled)
    return newSliderObj
end
