                    BorderSizePixel = 0,
                    Parent = colorPicker.Container
                })
                
                local displayCorner = createInstance("UICorner", {
                    Name = "DisplayCorner",
                    CornerRadius = UDim.new(0, 4),
                    Parent = colorPicker.Display
                })
                
                colorPicker.Button = createInstance("TextButton", {
                    Name = "Button",
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = colorPicker.Container
                })
                
                function colorPicker:Set(color)
                    colorPicker.Value = color
                    colorPicker.Display.BackgroundColor3 = color
                    
                    if flag then
                        PlantUI.Flags[flag] = color
                    end
                    
                    callback(color)
                end
                
                -- Simple color picker without HSV for now
                colorPicker.Button.MouseButton1Click:Connect(function()
                    local r, g, b = math.floor(colorPicker.Value.R * 255), math.floor(colorPicker.Value.G * 255), math.floor(colorPicker.Value.B * 255)
                    
                    -- Open a simple color input (uses built-in Roblox color picker)
                    local newColor = Color3.fromRGB(r, g, b)
                    colorPicker:Set(newColor)
                end)
                
                if flag then
                    PlantUI.Flags[flag] = default
                end
                
                return colorPicker
            end
            
            return section
        end
        
        return tab
    end
    
    -- If a default tab is specified, select it
    if defaultTab then
        local tabToSelect
        for _, tab in ipairs(self.Tabs) do
            if tab.Button.Name:lower():find(defaultTab:lower()) then
                tabToSelect = tab
                break
            end
        end
        
        if tabToSelect then
            task.delay(0.1, function()
                tabToSelect.Button.MouseButton1Click:Fire()
            end)
        end
    end
    
    return window
end

-- Export flag utilities
function PlantUI:GetFlag(flag)
    return self.Flags[flag]
end

function PlantUI:SetFlag(flag, value)
    self.Flags[flag] = value
end

-- Methods to help with mobile support
function PlantUI:IsMobile()
    return isMobile()
end

function PlantUI:AdjustForMobile()
    if not isMobile() then return end
    
    -- Adjust UI for mobile devices
    if self.ScreenGui then
        for _, window in ipairs(self.ScreenGui:GetChildren()) do
            if window:IsA("Frame") and window.Name == "MainFrame" then
                window.Size = UDim2.new(0.9, 0, 0.8, 0)
                window.Position = UDim2.new(0.5, -window.AbsoluteSize.X/2, 0.5, -window.AbsoluteSize.Y/2)
            end
        end
    end
end

-- Create keyboard shortcut binds
function PlantUI:BindToKey(key, callback)
    table.insert(self.ToggleBinds, {Key = key, Callback = callback})
end

-- Initialize keyboard shortcuts
local function setupKeyBinds()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.UserInputType == Enum.UserInputType.Keyboard then
            for _, bind in ipairs(PlantUI.ToggleBinds) do
                if input.KeyCode == bind.Key then
                    bind.Callback()
                end
            end
        end
    end)
end

setupKeyBinds()

return PlantUI
