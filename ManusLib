    actionIcon.TextColor3 = config.colors.accent
    actionIcon.TextSize = 14
    actionIcon.ZIndex = 106
    actionIcon.Parent = button
    
    -- Button hover/click effects
    button.MouseEnter:Connect(function()
        button:TweenProperty(
            "BackgroundColor3",
            config.colors.buttonHover,
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.2,
            true
        )
    end)
    
    button.MouseLeave:Connect(function()
        button:TweenProperty(
            "BackgroundColor3",
            config.colors.buttonNormal,
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.2,
            true
        )
    end)
    
    button.MouseButton1Click:Connect(function()
        createRipple(button)
        
        -- Visual feedback
        button:TweenProperty(
            "BackgroundColor3",
            config.colors.accent,
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.1,
            true,
            function()
                button:TweenProperty(
                    "BackgroundColor3",
                    config.colors.buttonNormal,
                    Enum.EasingDirection.Out,
                    config.animation.easing,
                    0.2,
                    true
                )
            end
        )
        
        -- Call the callback
        callback()
    end)
    
    button.Parent = sectionInfo.content
    
    return button
end

-- Add a colored button to a section
function MercUI:AddColoredButton(tab, section, text, color, callback)
    local button = self:AddButton(tab, section, text, callback)
    
    if not button then return nil end
    
    button.BackgroundColor3 = color
    
    -- Update hover effect for colored button
    local colorConn1, colorConn2
    
    colorConn1 = button.MouseEnter:Connect(function()
        button:TweenProperty(
            "BackgroundColor3",
            Color3.new(
                math.min(color.R * 1.1, 1),
                math.min(color.G * 1.1, 1),
                math.min(color.B * 1.1, 1)
            ),
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.2,
            true
        )
    end)
    
    colorConn2 = button.MouseLeave:Connect(function()
        button:TweenProperty(
            "BackgroundColor3",
            color,
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.2,
            true
        )
    end)
    
    table.insert(self.connections, colorConn1)
    table.insert(self.connections, colorConn2)
    
    return button
end

