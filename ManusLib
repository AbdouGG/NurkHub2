-- Add a button to a section
function MercUI:AddButton(tab, section, text, callback)
    if not self.tabs[tab] then
        warn("Tab '" .. tab .. "' does not exist!")
        return nil
    end
    
    local tabInfo = self.tabs[tab]
    
    if not tabInfo.sections[section] then
