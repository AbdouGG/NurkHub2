local function AddDropdown_Impl(owner, properties)
    properties = properties or {}
    local newDropdownObj = {}
    local theme = owner:GetTheme()

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = properties.Name or "DropdownFrame"
    mainFrame.Size = properties.Size or UDim2.new(1, (owner.Type == "Tab" and -10 or 0), 0, 30) 
