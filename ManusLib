    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = self.contentFrame
    
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = config.padding
    padding.PaddingBottom = config.padding
    padding.Parent = self.contentFrame
    
    self.contentFrame.Parent = self.mainFrame
    
    -- Make UI draggable
    self:MakeDraggable(self.titleBar)
    
    self.mainFrame.Parent = self.screenGui
    
    return self
end

-- Make an object draggable
function ProUI:MakeDraggable(frame)
    local function update(input)
        local delta = input.Position - self.dragStart
        self.mainFrame.Position = UDim2.new(
            self.startPos.X.Scale,
            self.startPos.X.Offset + delta.X,
            self.startPos.Y.Scale,
            self.startPos.Y.Offset + delta.Y
        )
    end
    
    table.insert(self.connections, frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.dragging = true
            self.dragStart = input.Position
            self.startPos = self.mainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    self.dragging = false
                end
            end)
        end
    end))
    
    table.insert(self.connections, frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            self.dragInput = input
        end
    end))
    
    table.insert(self.connections, game:GetService("UserInputService").InputChanged:Connect(function(input)
        if input == self.dragInput and self.dragging then
            update(input)
        end
    end))
end

-- Toggle UI visibility
function ProUI:Toggle()
    self.visible = not self.visible
    self.mainFrame.Visible = self.visible
end

-- Add a button to the UI
function ProUI:AddButton(text, callback)
    callback = callback or function() end
    
    local button = Instance.new("TextButton")
    button.Name = "Button_" .. text
    button.Size = UDim2.new(1, 0, 0, 40)
    button.BackgroundColor3 = config.colors.button
    button.Font = config.fonts.regular
    button.Text = text
    button.TextColor3 = config.colors.text
    button.TextSize = 16
    button.AutoButtonColor = false
    button.ZIndex = 103
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = button
    
    -- Hover effect
    button.MouseEnter:Connect(function()
        button:TweenProperty(
            "BackgroundColor3",
            config.colors.buttonHover,
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.2,
            true
        )
    end)
    
    button.MouseLeave:Connect(function()
        button:TweenProperty(
            "BackgroundColor3",
            config.colors.button,
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.2,
            true
        )
    end)
    
    -- Click effect and callback
    button.MouseButton1Click:Connect(function()
        createRipple(button)
        callback()
    end)
    
    button.Parent = self.contentFrame
    return button
end

-- Add a colored button to the UI
function ProUI:AddColoredButton(text, color, callback)
    callback = callback or function() end
    
    local button = self:AddButton(text, callback)
    button.BackgroundColor3 = color
    
    -- Updated hover effect
    button.MouseEnter:Connect(function()
        button:TweenProperty(
            "BackgroundColor3",
            Color3.new(
                math.min(color.R * 1.1, 1),
                math.min(color.G * 1.1, 1),
                math.min(color.B * 1.1, 1)
            ),
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.2,
            true
        )
    end)
    
    button.MouseLeave:Connect(function()
        button:TweenProperty(
            "BackgroundColor3",
            color,
            Enum.EasingDirection.Out,
            config.animation.easing,
            0.2,
            true
        )
    end)
    
    return button
end

-- Add a success button (green)
function ProUI:AddSuccessButton(text, callback)
    return self:AddColoredButton(text, config.colors.success, callback)
end

-- Add an error button (red)
function ProUI:AddErrorButton(text, callback)
    return self:AddColoredButton(text, config.colors.error, callback)
end

-- Add a warning button (yellow/orange)
function ProUI:AddWarningButton(text, callback)
    return self:AddColoredButton(text, config.colors.warning, callback)
end

-- Add a primary button (accent color)
function ProUI:AddPrimaryButton(text, callback)
    return self:AddColoredButton(text, config.colors.accent, callback)
end

-- Destroy the UI library instance
function ProUI:Destroy()
    -- Clean up connections
    for _, connection in ipairs(self.connections) do
        connection:Disconnect()
    end
    
    -- Remove the UI
    self.screenGui:Destroy()
end

-- Return the library
return ProUI
