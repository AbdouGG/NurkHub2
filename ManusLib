                    Parent = label.Container
                })
                
                function label:Set(newText)
                    label.Label.Text = newText
                end
                
                return label
            end
            
            -- Create ColorPicker
            function section:CreateColorPicker(options)
                options = options or {}
                local colorPickerText = options.text or "Color Picker"
                local default = options.default or Color3.fromRGB(255, 255, 255)
                local flag = options.flag or nil
                local callback = options.callback or function() end
                
                local colorPicker = {}
                colorPicker.Value = default
                colorPicker.Open = false
                
                colorPicker.Container = createInstance("Frame", {
                    Name = colorPickerText.."ColorPicker",
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(45, 45, 45),
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    Parent = sectionContent
                })
                
                local colorPickerCorner = createInstance("UICorner", {
                    Name = "ColorPickerCorner",
                    CornerRadius = UDim.new(0, 4),
                    Parent = colorPicker.Container
                })
                
                local colorPickerLabel = createInstance("TextLabel", {
                    Name = "ColorPickerLabel",
                    Size = UDim2.new(1, -60, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    BackgroundTransparency = 1,
                    Text = colorPickerText,
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    TextSize = 14,
                    Font = Enum.Font.SourceSansSemibold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = colorPicker.Container
                })
                
                colorPicker.Display = createInstance("Frame", {
                    Name = "Display",
                    Size = UDim2.new(0, 22, 0, 22),
                    Position = UDim2.new(1, -32, 0.5, -11),
