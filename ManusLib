-- Make an object draggable
function MercUI:MakeDraggable(frame)
    local function update(input)
        local delta = input.Position - self.dragStart
        self.mainFrame.Position = UDim2.new(
            self.startPos.X.Scale,
            self.startPos.X.Offset + delta.X,
            self.startPos.Y.Scale,
            self.startPos.Y.Offset + delta.Y
        )
    end
    
    table.insert(self.connections, frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.dragging = true
            self.dragStart = input.Position
            self.startPos = self.mainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    self.dragging = false
                end
            end)
        end
    end))
    
    table.insert(self.connections, frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            self.dragInput = input
        end
    end))
    
    table.insert(self.connections, game:GetService("UserInputService").InputChanged:Connect(function(input)
        if input == self.dragInput and self.dragging then
            update(input)
        end
    end))
end

-- Toggle UI visibility
function MercUI:Toggle()
    self.visible = not self.visible
    self.mainFrame.Visible = self.visible
end

-- Minimize the UI
function MercUI:Minimize()
    if self.minimized then
        -- Restore
        self.mainFrame:TweenSize(
            UDim2.fromOffset(600, 400),
            Enum.EasingDirection.Out,
            config.animation.easing,
            config.animation.duration,
            true
        )
        
        self.contentContainer.Visible = true
        self.sidebar.Visible = true
    else
        -- Minimize
        self.mainFrame:TweenSize(
            UDim2.fromOffset(600, 40),
            Enum.EasingDirection.Out,
            config.animation.easing,
            config.animation.duration,
            true
        )
        
        self.contentContainer.Visible = false
        self.sidebar.Visible = false
    end
    
    self.minimized = not self.minimized
end

-- Maximize the UI
function MercUI:Maximize()
    if self.maximized then
        -- Restore
        self.mainFrame:TweenSize(
            UDim2.fromOffset(600, 400),
            Enum.EasingDirection.Out,
            config.animation.easing,
            config.animation.duration,
            true
        )
        
        self.mainFrame:TweenPosition(
            UDim2.new(0.5, -300, 0.5, -200),
            Enum.EasingDirection.Out,
            config.animation.easing,
            config.animation.duration,
            true
        )
    else
        -- Maximize
        local viewportSize = workspace.CurrentCamera.ViewportSize
        self.mainFrame:TweenSize(
            UDim2.fromOffset(viewportSize.X - 20, viewportSize.Y - 20),
            Enum.EasingDirection.Out,
            config.animation.easing,
            config.animation.duration,
            true
        )
        
        self.mainFrame:TweenPosition(
            UDim2.new(0, 10, 0, 10),
            Enum.EasingDirection.Out,
            config.animation.easing,
            config.animation.duration,
            true
        )
    end
    
    self.maximized = not self.maximized
end

