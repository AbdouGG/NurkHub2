-- OrionLib - Roblox UI Library with Tabs
-- Version 2.1 (Integrated Tabs and Sections)

local OrionLib = {}
OrionLib.__index = OrionLib

-- ScreenGui Management
local screenGui
local function getScreenGui()
    if screenGui and screenGui.Parent then
        return screenGui
    end
    -- Attempt to find existing or create new
    screenGui = game:GetService("CoreGui"):FindFirstChild("OrionLibScreenGui") 
                or game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui"):FindFirstChild("OrionLibScreenGui")
    if not screenGui or not screenGui.Parent then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "OrionLibScreenGui"
        screenGui.ResetOnSpawn = false
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling -- Ensures ZIndex works as expected across different ScreenGuis
        screenGui.Parent = game:GetService("CoreGui") or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end
    return screenGui
end

-- Forward declare Window, Tab, and SectionElement
local Window
local Tab
local SectionElement

--[[------------------------------------------------------------------------------------------------
-- Base Element (Common functionality for UI elements)
--------------------------------------------------------------------------------------------------]]
local BaseElement = {}
BaseElement.__index = BaseElement

function BaseElement:New(type, properties, robloxInstance, owner) -- owner can be Window, Tab or Section
    local newElement = {}
    setmetatable(newElement, BaseElement)
    newElement.Type = type
    newElement.Properties = properties or {}
    newElement.RobloxInstance = robloxInstance
    newElement.Owner = owner 
    newElement.IsEnabled = properties.Enabled == nil and true or properties.Enabled
    newElement.TooltipText = properties.TooltipText
    newElement.Visible = robloxInstance.Visible

    if newElement.TooltipText and robloxInstance:IsA("GuiObject") then
        local tooltipLabel = nil
        local userInputService = game:GetService("UserInputService")

        robloxInstance.MouseEnter:Connect(function()
            if not newElement.IsEnabled or not newElement.Visible then return end
            if not tooltipLabel or not tooltipLabel.Parent then
                tooltipLabel = Instance.new("TextLabel")
                tooltipLabel.Name = "OrionTooltip"
                tooltipLabel.Text = newElement.TooltipText
                tooltipLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                tooltipLabel.BackgroundTransparency = 0.1
                tooltipLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
                tooltipLabel.BorderSizePixel = 1
                tooltipLabel.BorderColor3 = Color3.fromRGB(50,50,50)
                tooltipLabel.Font = Enum.Font.SourceSans
                tooltipLabel.TextSize = 12
                tooltipLabel.TextWrapped = true
                tooltipLabel.TextXAlignment = Enum.TextXAlignment.Left
                tooltipLabel.ZIndex = 20000 
                tooltipLabel.Parent = getScreenGui()
            end
            local mouseLocation = userInputService:GetMouseLocation()
            tooltipLabel.Position = UDim2.fromOffset(mouseLocation.X + 15, mouseLocation.Y + 15)
            local textSize = tooltipLabel.TextBounds
            tooltipLabel.Size = UDim2.new(0, math.min(textSize.X + 10, 200), 0, textSize.Y + 6)
            tooltipLabel.Visible = true
        end)
        robloxInstance.MouseLeave:Connect(function()
            if tooltipLabel then
                tooltipLabel.Visible = false
            end
        end)
        robloxInstance.MouseMoved:Connect(function(x,y) -- x,y are screen coordinates from MouseMoved
            if tooltipLabel and tooltipLabel.Visible then 
                tooltipLabel.Position = UDim2.fromOffset(x + 15, y + 15)
            end
        end)
    end
    return newElement
end

function BaseElement:GetTheme()
    local owner = self.Owner
    if owner then
        if owner.Type == "Tab" and owner.ParentWindow and owner.ParentWindow.Theme then
            return owner.ParentWindow.Theme
        elseif owner.Type == "Section" and owner.Owner and owner.Owner.ParentWindow and owner.Owner.ParentWindow.Theme then -- Section's owner is Tab
            return owner.Owner.ParentWindow.Theme
        elseif owner.Type == "Window" and owner.Theme then -- Element directly on window (future use)
             return owner.Theme
        end
    end
    -- Fallback theme if something goes wrong
    warn("OrionLib: Theme could not be retrieved for element: " .. (self.RobloxInstance and self.RobloxInstance.Name or "Unknown"))
    return { DefaultElementColor = Color3.fromRGB(70,70,70), DefaultBorderColor = Color3.fromRGB(50,50,50), DefaultFont = Enum.Font.SourceSans, DefaultTextColor = Color3.fromRGB(220,220,220), DisabledColor = Color3.fromRGB(100,100,100), TabActiveColor=Color3.fromRGB(45,45,45), TabInactiveColor=Color3.fromRGB(70,70,70), TabActiveTextColor=Color3.fromRGB(255,255,255), TabInactiveTextColor=Color3.fromRGB(180,180,180) }
end

function BaseElement:SetEnabled(enabled)
    self.IsEnabled = enabled
    if self.RobloxInstance and self.RobloxInstance:IsA("GuiObject") then
        self.RobloxInstance.Active = enabled 
        if self.RobloxInstance:IsA("TextButton") or self.RobloxInstance:IsA("ImageButton") then
            self.RobloxInstance.AutoButtonColor = enabled
        end
    end
end

function BaseElement:SetVisible(visible)
    self.Visible = visible
    if self.RobloxInstance then
        self.RobloxInstance.Visible = visible
    end
end

function BaseElement:Destroy()
    if self.RobloxInstance then
        self.RobloxInstance:Destroy()
    end
    for k in pairs(self) do self[k] = nil end
    setmetatable(self, nil)
end

--[[------------------------------------------------------------------------------------------------
-- Tab Object
--------------------------------------------------------------------------------------------------]]
Tab = setmetatable({}, { __index = {} }) -- Using a table for __index for clarity
Tab.__index = Tab
Tab.Type = "Tab" -- For GetTheme identification

function Tab:New(window, properties)
    local newTab = {}
    setmetatable(newTab, Tab)

    newTab.ParentWindow = window
    newTab.Properties = properties or {}
    newTab.Title = properties.Title or "Tab"
    newTab.Name = properties.Name or newTab.Title
    newTab.Elements = {} 
    newTab.IsActive = false
    newTab.OnSelectedCallback = properties.OnSelected

    newTab.ContentFrame = Instance.new("Frame")
    newTab.ContentFrame.Name = newTab.Name .. "_Content"
    newTab.ContentFrame.Size = UDim2.new(1, 0, 1, 0)
    newTab.ContentFrame.BackgroundTransparency = 1
    newTab.ContentFrame.Visible = false
    newTab.ContentFrame.ClipsDescendants = true
    newTab.ContentFrame.Parent = window.TabDisplayFrame

    newTab.Layout = Instance.new("UIListLayout")
    newTab.Layout.Padding = UDim.new(0, properties.Padding or 5)
    newTab.Layout.SortOrder = Enum.SortOrder.LayoutOrder
    newTab.Layout.HorizontalAlignment = properties.HorizontalAlignment or Enum.HorizontalAlignment.Left
    newTab.Layout.Parent = newTab.ContentFrame

    newTab.TabButton = nil 
    return newTab
end

function Tab:Select()
    if self.IsActive then return end
    local theme = self.ParentWindow.Theme

    for _, otherTab in ipairs(self.ParentWindow.Tabs) do
        if otherTab.IsActive then
            otherTab:Deselect()
            break
        end
    end

    self.IsActive = true
    self.ContentFrame.Visible = true
    if self.TabButton then
        self.TabButton.BackgroundColor3 = theme.TabActiveColor
        self.TabButton.TextColor3 = theme.TabActiveTextColor
        self.TabButton.ZIndex = self.TabButton.Parent.ZIndex + 1
    end
    self.ParentWindow.ActiveTab = self

    if self.OnSelectedCallback and type(self.OnSelectedCallback) == "function" then
        pcall(self.OnSelectedCallback, self)
    end
end

function Tab:Deselect()
    self.IsActive = false
    self.ContentFrame.Visible = false
    local theme = self.ParentWindow.Theme
    if self.TabButton then
        self.TabButton.BackgroundColor3 = theme.TabInactiveColor
        self.TabButton.TextColor3 = theme.TabInactiveTextColor
        self.TabButton.ZIndex = self.TabButton.Parent.ZIndex
    end
end

--[[------------------------------------------------------------------------------------------------
-- Window Object
--------------------------------------------------------------------------------------------------]]
Window = setmetatable({}, { __index = {} })
