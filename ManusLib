                        itemButton.MouseButton1Click:Connect(function()
                            dropdown:Set(item)
                            dropdown:Toggle(false)
                        end)
                        
                        itemButton.MouseEnter:Connect(function()
                            TweenService:Create(itemButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
                        end)
                        
                        itemButton.MouseLeave:Connect(function()
                            TweenService:Create(itemButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 50)}):Play()
                        end)
                    end
                    
                    dropdown.ItemList.Size = UDim2.new(1, -20, 0, math.min(#items * 30, 150))
                end
                
                function dropdown:Set(value)
                    dropdown.Value = value
                    dropdown.Selected.Text = tostring(value)
                    dropdown.Selected.TextColor3 = Color3.fromRGB(255, 255, 255)
                    
                    if flag then
                        PlantUI.Flags[flag] = value
                    end
                    
                    callback(value)
                end
                
                function dropdown:Toggle(state)
                    if state == nil then
                        state = not dropdown.Open
                    end
                    
                    dropdown.Open = state
                    
                    if state then
                        dropdown.ItemList.Visible = true
                        dropdown.Container:TweenSize(
                            UDim2.new(1, 0, 0, 32 + dropdown.ItemList.Size.Y.Offset + 10),
                            Enum.EasingDirection.Out,
                            Enum.EasingStyle.Quad,
                            0.2,
                            true
                        )
                        TweenService:Create(dropdown.Arrow, TweenInfo.new(0.2), {Rotation = 180}):Play()
                    else
                        dropdown.Container:TweenSize(
                            UDim2.new(1, 0, 0, 32),
                            Enum.EasingDirection.Out,
                            Enum.EasingStyle.Quad,
                            0.2,
                            true,
                            function()
                                dropdown.ItemList.Visible = false
                            end
                        )
                        TweenService:Create(dropdown.Arrow, TweenInfo.new(0.2), {Rotation = 0}):Play()
                    end
                end
                
                dropdown.Button.MouseButton1Click:Connect(function()
                    dropdown:Toggle()
                end)
                
                -- Close dropdown when clicking outside
                UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if dropdown.Open and not dropdown.Container:IsDescendantOf(game) then
                            return
                        end
                        
                        local over = false
                        local position = UserInputService:GetMouseLocation()
                        
                        local objects = CoreGui:GetGuiObjectsAtPosition(position.X, position.Y)
                        for _, object in ipairs(objects) do
                            if object:IsDescendantOf(dropdown.Container) then
                                over = true
                                break
                            end
                        end
                        
                        if dropdown.Open and not over then
                            dropdown:Toggle(false)
                        end
                    end
                end)
                
                dropdown:UpdateItems(items)
                
                if default then
                    dropdown:Set(default)
                end
                
                if flag then
                    PlantUI.Flags[flag] = default
                end
                
                return dropdown
            end
            
