local Library = {}


function Library:validate(defaults, options)
	for i, v in pairs(defaults) do
		if options[i] == nil then
			options[i] = v
		end
	end
	return options
end

function Library:tween(object, goal, callback)
	local tween = tweenService:Create(object, tweenInfo, goal)
	tween.Completed:Connect(callback or function() end)
	tween:Play()
end

-- New Notification System
function Library:CreatNotify(title, message, duration)
	duration = duration or 2 -- Default duration is 2 seconds if not specified

	local notificationGui = Instance.new("ScreenGui", runService:IsStudio() and players.LocalPlayer:WaitForChild("PlayerGui") or coreGui)
	notificationGui.Name = "NotificationGui"

	local notificationFrame = Instance.new("Frame", notificationGui)
	notificationFrame.Size = UDim2.new(0, 220, 0, 100)
	notificationFrame.Position = UDim2.new(0.70, 0, 0.774, 0)
	notificationFrame.BackgroundTransparency = 0.2
	notificationFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	notificationFrame.BorderSizePixel = 0
	notificationFrame.ZIndex = 1

	local corner = Instance.new("UICorner", notificationFrame)
	corner.CornerRadius = UDim.new(0, 12)

	local gradient = Instance.new("UIGradient", notificationFrame)
	gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 50, 50)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 30, 30))
	}

	local icon = Instance.new("ImageLabel", notificationFrame)
	icon.Size = UDim2.new(0, 20, 0, 20)
	icon.Position = UDim2.new(0, 10, 0, 10)
	icon.BackgroundTransparency = 1
	icon.Image = "rbxassetid://6031071053" -- A bell icon or any other icon asset
	icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
	icon.ZIndex = 2

	local titleText = Instance.new("TextLabel", notificationFrame)
	titleText.Size = UDim2.new(1, -40, 0, 20)
	titleText.Position = UDim2.new(0, 40, 0, 10)
	titleText.BackgroundTransparency = 1
	titleText.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleText.Text = title
	titleText.Font = Enum.Font.GothamBold
	titleText.TextSize = 16
	titleText.TextWrapped = true
	titleText.TextXAlignment = Enum.TextXAlignment.Left
	titleText.TextYAlignment = Enum.TextYAlignment.Top
	titleText.ZIndex = 2

	local textContainer = Instance.new("ScrollingFrame", notificationFrame)
	textContainer.Size = UDim2.new(1, -20, 1, -40)
	textContainer.Position = UDim2.new(0, 10, 0, 40)
	textContainer.BackgroundTransparency = 1
	textContainer.BorderSizePixel = 0
	textContainer.CanvasSize = UDim2.new(1, 0, 1, 0)
	textContainer.ScrollBarThickness = 0
	textContainer.ZIndex = 2

	local notificationText = Instance.new("TextLabel", textContainer)
	notificationText.Size = UDim2.new(1, -20, 1, 0)
	notificationText.Position = UDim2.new(0, 0, 0, 0)
	notificationText.BackgroundTransparency = 1
	notificationText.TextColor3 = Color3.fromRGB(235, 235, 235)
	notificationText.Text = message
	notificationText.Font = Enum.Font.Gotham
	notificationText.TextSize = 14
	notificationText.TextWrapped = true
	notificationText.TextXAlignment = Enum.TextXAlignment.Left
	notificationText.TextYAlignment = Enum.TextYAlignment.Top
	notificationText.ZIndex = 2

	notificationText.Size = UDim2.new(1, -20, 0, notificationText.TextBounds.Y)

	-- Adjust the size of the notification frame based on the message length
	local requiredHeight = notificationText.TextBounds.Y + 60
	notificationFrame.Size = UDim2.new(0, 220, 0, math.min(requiredHeight, 200))
	textContainer.CanvasSize = UDim2.new(1, 0, 0, notificationText.TextBounds.Y)

	-- Progress Bar
	local progressBar = Instance.new("Frame", notificationFrame)
	progressBar.Size = UDim2.new(0, 0, 0, 5)
	progressBar.Position = UDim2.new(0, 0, 1, -5)
	progressBar.BackgroundTransparency = 0.2
	progressBar.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	progressBar.BorderSizePixel = 0
	progressBar.ZIndex = 3

	local progressCorner = Instance.new("UICorner", progressBar)
	progressCorner.CornerRadius = UDim.new(0, 12)

	-- Animate the progress bar
	local progressTween = tweenService:Create(progressBar, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {Size = UDim2.new(1, 0, 0, 5)})
	progressTween:Play()

	-- Animate the notification
	Library:tween(notificationFrame, {Position = UDim2.new(0.70, 0, 0.774, -notificationFrame.Size.Y.Offset)}, function()
		progressTween.Completed:Wait() -- Wait for the progress tween to complete
		Library:tween(notificationFrame, {Position = UDim2.new(0.70, 0, 0.774, 0)}, function()
			notificationGui:Destroy()
		end)
	end)
end

